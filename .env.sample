##
## Database settings
##

# Values set here based on running local docker instance with "yarn db"
PGHOST=postgres_db
PGPORT=5432
PGDATABASE=postgres
PGSUPERUSER=postgres
PGSUPERPASSWORD=docker
PGAPPUSER=lwpUser
PGPASSWORD=docker
PGADMINUSER=lwpAdminUser
PGADMINPASSWORD=docker

# Connection string used by kysely-codegen to generate type definitions
DATABASE_URL="postgres://${PGAPPUSER}:${PGAPPPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}"

##
## MinIO/S3 access details
##

# "Ultima" legacy name from previous host
# These settings apply to both buckets
ULTIMA_BUCKET_HOST=minio
ULTIMA_BUCKET_PORT=9000
ULTIMA_BUCKET_ACCESS_KEY_ID=key123
ULTIMA_BUCKET_ACCESS_KEY_SECRET=secret123

# Bucket with public URL where mathscots, resources, etc are stored 
PUBLIC_BUCKET_NAME=public
# Bucket with generated access only where user-uploaded photos are stored
MEDIA_BUCKET_NAME=usermedia

# When enabled, uses SSL (and may have other AWS-specific tweaks)
MINIO_USE_AWS=false

##
## URLs for accessing services
##

# URL at which files in the public bucket can be accessed on the web
MINIO_PUBLIC_BASE_URL=http://minio:9000
NEXT_PUBLIC_MINIO_PUBLIC_BASE_URL=http://localhost:9000/public

# URL for graphql queries
GRAPHQL_BASE=http://localhost:3006
NEXT_PUBLIC_GRAPHQL_END_POINT=http://localhost:3006/graphql

# URL at which the main frontend site is hosted (used in graphql-provider for creating URLs)
HOSTED_URL=http://localhost:3000

##
## Email & SMS credentials
##

# API key to use with Mailgun
# MAILGUN_APIKEY=mailgunkey

# The School Partnership Managers the school leader welcome email is sent from. A school's `SPM: ...`
# tag picks the SPM whose address or name it holds - `SPM: Joanne` selects `jo@...`, `SPM: Jess` the
# entry named Jess - and the email is signed with the name written here; no match falls back to the
# template's own sender.
# SPM_EMAILS="Catherine <catherine@learningwithparents.com>,Jo <jo@learningwithparents.com>"

##
## CF Turnstile
##
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=1x00000000000000000000AA
RECAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA

##
## Modifying running services
##

# Environment definition (production/staging/dev/local)
# Used for things including the popup indicating server uptime.
LWP_ENV=local
NEXT_PUBLIC_LWP_ENV=local

# Determines whether or not the cron service (which sends email and releases topics)
# should run in the current instance of the backend.
# Should be set to true for a single instance per deployment.
ALLOW_SCHEDULING=true

# Whether migrations are automatically run by the ORM.
# Default: false
ORM_AUTO_MIGRATIONS=false

# AZURE_AD_CREDENTIALS
AZURE_AD_CLIENT_ID=dc81dc04-0000-4418-950c-000000000000
AZURE_AD_CLIENT_SECRET=aaa1acb3-0000-4b7f-84a9-000000000000
AZURE_AD_CLIENT_SECRET_VALUE=jOS8Q~ShmoADzXZxR20000oGQpKI000000000000
AZURE_AD_EXPIRY_DATE=2025-09-05T10:40:54.074Z

# GOOGLE_CREDENTIALS
GOOGLE_CLIENT_ID=198799183460-de8n05n00007baa9e8e0000000000000.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GO0000-u7QnrGhNsfQg-ImB000000000000

# RATE LIMITING
# Comma-delimited list of IPs and/or subnets that we consider to be "trusted" proxies.
TRUSTED_PROXY_IPS_AND_SUBNETS=
