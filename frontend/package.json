{
    "name": "lwp-platform-frontend",
    "version": "0.0.1",
    "description": "Learning with Parents learning platform frontend",
    "main": "index.js",
    "private": true,
    "repository": "github:learningwithparents/platform",
    "scripts": {
        "dev": "next dev",
        "dev:local:subdomain": "next dev -H explore.dev.local",
        "build:start:local:subdomain": "yarn run build && yarn run start -H explore.dev.local",
        "prebuild": "yarn references:build",
        "build": "next build",
        "build:start": "yarn run build && yarn run start",
        "prebuild:prod": "yarn prebuild",
        "build:prod": "next build && node source-map-uploader.js",
        "start": "next start",
        "start:prod": "next start -p ${LWP_FRONTEND_PORT:-default}",
        "format": "prettier --write '**/*.js'",
        "lint": "eslint .",
        "lint:cache": "eslint --cache .",
        "lint:fix": "eslint . --fix",
        "test": "cypress run",
        "test:vitest": "vitest run",
        "references:build": "node buildReferences.mjs"
    },
    "author": "",
    "license": "UNLICENSED",
