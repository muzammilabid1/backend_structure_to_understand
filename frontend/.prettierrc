{
    "printWidth": 140,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "bracketSpacing": true,
    "trailingComma": "none",
    "arrowParens": "always",
    "proseWrap": "never",
    "bracketSameLine": true,
    "overrides": [
        {
            "files": ".prettierrc",
            "options": {
                "singleQuote": true
            }
        }
    ]
}
