{
    "compilerOptions": {
        "composite": true,
        "incremental": true,
        "tsBuildInfoFile": "./.tsbuildinfo",
        "target": "ESNext",
        "module": "NodeNext",
        "rootDir": "src",
        "moduleResolution": "nodenext",
        "types": [],
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "customConditions": ["@lwp/src"],
        "declaration": true,
        "outDir": "dist",
        "removeComments": true,
        "importHelpers": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    }
}
