{
    "name": "graphql-provider",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "prebuild": "rimraf dist graphql-provider/dist ../shared/dist && yarn references:build",
        "build": "nest build",
        "build:start": "yarn run build && yarn run nest start",
        "references:build": "node ../shared/buildReferences.mjs",
        "predev": "yarn references:build",
        "dev": "yarn run prebuild && nest start --watch",
        "prestart": "yarn references:build",
        "start": "nest start --exec \"node --require newrelic\"",
        "start:debug": "nest start --debug --watch",
        "start:dev": "yarn run dev",
        "start:prod": "yarn run start",
        "start:full": "yarn run typeorm:up && yarn run build && yarn run nest start",
        "typeorm": "ts-node -r tsconfig-paths/register ./../node_modules/typeorm/cli.js --config src/ormconfig.ts",
        "typeorm:revert": "yarn run typeorm migration:revert -c \"Superuser\"",
        "typeorm:generate": "yarn run typeorm migration:generate -c \"Superuser\"",
        "typeorm:up": "yarn run typeorm migration:run -c \"Superuser\"",
        "typeorm:down": "yarn run typeorm migration:revert -c \"Superuser\"",
        "typeorm:drop-init": "rimraf src/migrations/* graphql-provider/src/migrations/* && yarn run typeorm schema:drop && yarn run typeorm:generate && node data-import/setup",
        "format": "prettier --write '**/*.ts'",
        "lint": "eslint .",
        "lint:cache": "eslint --cache .",
        "lint:fix": "eslint . --fix",
        "scripts:change-reading-week-start": "yarn prestart && nest start --entryFile scripts/change-reading-week-start",
        "scripts:generate-schema": "yarn prestart && nest start --entryFile scripts/generate-schema",
        "pretest": "yarn references:build",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:functional": "jest --config jest.functional.config.js",
        "test:functional:watch": "yarn test:functional --watch"
    },
    "private": true,
    "license": "UNLICENSED",
