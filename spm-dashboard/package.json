{
  "name": "spm-dashboard",
  "version": "0.0.1",
  "description": "Self-contained SPM (School Programme Manager) dashboard for Learning with Parents",
  "private": true,
  "main": "index.js",
  "scripts": {
    "pre:dev": "yarn dotenv yarn workspace @lwp/postgres-client build",
    "pre:build": "yarn dotenv yarn workspace @lwp/postgres-client build",
    "pre:start": "yarn dotenv yarn workspace @lwp/postgres-client build",
    "dev": "next dev -p 3002",
    "dev:with-db": "yarn pre:dev && next dev -p 3002",
    "prebuild": "yarn pre:build",
    "build": "next build",
    "start": "next start",
    "start:local": "yarn pre:start && next start -p 3002",
    "lint": "eslint .",
    "lint:cache": "eslint --cache .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:vitest": "TZ=UTC vitest run"
  },
  "dependencies": {
    "@emotion/react": "^11.8.2",
    "@emotion/styled": "^11.8.1",
    "@lwp/postgres-client": "*",
    "@mui/icons-material": "^5.15.1",
    "@mui/material": "^5.15.1",
    "@mui/system": "^5.15.1",
    "cookie": "^0.6.0",
    "dotenv": "^17.2.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "jose": "^6.2.1",
    "kysely": "^0.28.17",
    "lwp-shared": "*",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "sass": "^1.49.9",
    "swr": "^2.3.4"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.0.32",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^14.2.13",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.21.5",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "globals": "^15.9.0",
    "jsonwebtoken": "^9.0.2",
    "prettier": "^3.0.0",
    "typescript": "^5.0.3",
    "vitest": "^3.0.6"
  }
}
