{
  "name": "data-analytics-platform",
  "version": "0.0.1",
  "description": "Internal data analytics platform for Learning with Parents",
  "main": "index.js",
  "private": true,
  "scripts": {
    "pre:dev": "yarn dotenv yarn workspace @lwp/postgres-client build",
    "pre:build": "yarn dotenv yarn workspace @lwp/postgres-client build",
    "pre:start": "yarn dotenv yarn workspace @lwp/postgres-client build",
    "dev": "next dev -p 3001",
    "dev:local:subdomain": "next dev -H analytics.dev.local",
    "build:start:local:subdomain": "yarn run build && yarn run start -H analytics.dev.local",
    "dev:with-db": "yarn pre:dev && next dev -p 3001",
    "prebuild": "yarn pre:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:cache": "eslint --cache .",
    "lint:fix": "eslint . --fix",
    "etl:refresh": "node scripts/refresh-impact-summary.js",
    "etl:setup": "echo 'Add this to your crontab for weekly Sunday refresh:' && echo '0 2 * * 0 cd $(pwd) && yarn etl:refresh'",
    "etl:init": "node scripts/setup-analytics-tables.js",
    "migration:compare": "echo 'Compare original vs optimized endpoints:' && echo 'Original: /api/impact/kpis vs Optimized: /api/impact/kpis-optimized'"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.4.0",
    "@lwp/postgres-client": "*",
    "@nivo/line": "^0.99.0",
    "cookie": "^1.1.1",
    "date-fns": "^2.29.3",
    "dotenv": "^17.2.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.1",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.534.0",
    "lwp-shared": "*",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.7",
    "sass": "^1.49.9",
    "swr": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.0.32",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^14.2.13",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.21.5",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "globals": "^15.9.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.3"
  }
}
