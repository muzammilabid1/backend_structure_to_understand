[{"id": 4081, "text": "<h2>How to play:</h2>\n<ol>\n<b><li>Player 1 chooses an action beginning with 'un', e.g. 'unwrap'.</b><dd> You can use the list of suggestions to help if you like!</dd></li>\n<b><li>Player 1 mimes the action.</b><dd> Act it out without saying anything!</dd></li>\n<b><li>Player 2 guesses what the 'un' word is. </b><dd> They should say what it is then mime what it would look like without the 'un'. </dd></li>\n<b><li>If Player 2 was correct, swap over. </b><dd> If they were incorrect, Player 1 does their mime again so Player 2 can have another guess.</dd></li>\n<b><li>Keep playing until you have had a few goes each!</b></li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2936, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 120895453, "text": "762306172", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2936, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "edi