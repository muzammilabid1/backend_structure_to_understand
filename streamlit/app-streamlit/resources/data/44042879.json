[{"id": 44043214, "text": "<h2>What to Do:</h2>\nRead the piece of writing about our solar system. What do you notice? It seems very informal for an information text! \n<ol>\n<li>Underline anything you spot that seems too informal.</li>\n<li>Use the lines at the bottom of the page to rewrite the text in a more formal style. You can completely change the order of the words if you need to!</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44042879, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44042991, "text": "<h2>You will Need:</h2>\n<ul>\n<li>Something to write with;</li>\n<li>This text (but don’t worry if you can’t print – you can read the words online and write on a separate piece of paper).</li>\n</ul>\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44042879, "dimensions": null, "editAsHtml": false, "properti