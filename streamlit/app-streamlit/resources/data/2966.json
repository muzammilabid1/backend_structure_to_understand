[{"id": 41754116, "text": " ", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1636969519082_1image1-01FMHFRWGAR9VM8036TE8CA2DE.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2966, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4006, "text": "This game is a really good way to practise one of the phonemes (sounds) your child is working on. In the example, we use <span style=\"color:#F28D00\"> sh</span>, but you can use any phoneme you like!\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2966, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 41757330, "text": "<h2>Warmup:</h2>\nIn the instructions, we use the sound <span style=\"color:#F28D00\">sh</span>, but you can choose any sound your child is working on!\n<ol>\n<li>Introduce the magic sound <span style=\"color:#F28D00\"> sh</span>. </li>\n<li>Explain that every time your child hears you say the magic sound, they clap their hands.</li>\n<li> Say the sound <span style=\"color:#F28D00\">sh</span>. </li>\n<li>Your child should clap!</li>\n<li>Say the sound again a few times. Leave gaps between when you say the sound, changing the length of the gap.</li>\n</ol>\n<br></br>\n<h2>Challenge 1:</h2>\nSay other sounds before you say <span style=\"color:#F28D00\">sh</span>. \n<br>For example,  'b, c, v, th, ff, <span style=\"color:#F28D00\"> sh</span>'. \n<br></br>\n<h2>Challenge 2:</h2>\nAsk them to clap when they hear a word that starts with the sound. \n<br>You could choose a category, like animals, e.g 'cat, elephant, chimp, <span style=\"color:#F28D00\">sh</span>ark.'", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2966, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 131715099, "text": "761463819", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2966, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 131715177, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2966, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Challenge 3:</h2>\n<p>Ask them to clap when they hear a word that contains the sound.&nbsp;</p>\n<p>For example, 'goat, donkey fi<span style=\"color: rgb(251,160,38);\">sh</span>.'</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]