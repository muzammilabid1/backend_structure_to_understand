tate": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:24px;\">Say an animal for each letter of your name or plank for ten seconds.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:24px;\">Count in twos up to twenty or spell your name backwards.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:24px;\">Say one lovely thing about the other person or say something you are proud of.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:24px;\">Pull a silly face or sit on your hands for the next two minutes.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:24px;\">Tell a joke or sing the alphabet song. </p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:24px;\">Pretend you are a bear eating berries or pretend you are a cat washing itself.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:24px;\">Woof like a dog or jump like a frog.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:24px;\">Bend down and touch your toes or poke out your tongue to lick your nose.</p>", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{\"text\":[{\"text\":\"Count to one hundred or do twenty star-jumps.\",\"fontSize\":\"24\"},{\"text\":\"Sing a song or do five press-ups.\",\"fontSize\":\"24\"},{\"text\":\"Stand on one leg for thirty seconds or speak in a funny voice until your next turn.\",\"fontSize\":\"24\"},{\"text\":\"Dance like a chicken or don’t speak until your next turn.\",\"fontSize\":\"24\"},{\"text\":\"Blink ten times or clap forty times.\",\"fontSize\":\"24\"},{\"text\":\"Pretend to be a horse or walk around the room backwards.\",\"fontSize\":\"24\"},{\"text\":\"Say an animal for each letter of your name or plank for ten seconds.\",\"fontSize\":\"24\"},{\"text\":\"Count in twos up to twenty or spell your name backwards.\",\"fontSize\":\"24\"},{\"text\":\"Say one lovely thing about the other person or say something you are proud of.\",\"fontSize\":\"24\"},{\"text\":\"Pull a silly face or sit on your hands for the next two minutes.\",\"fontSize\":\"24\"},{\"text\":\"Tell a joke or sing the alphabet song. \",\"fontSize\":\"24\"},{\"text\":\"Pretend you are a bear eating berries or pretend you are a cat washing itself.\",\"fontSize\":\"24\"},{\"text\":\"Woof like a dog or jump like a frog.\",\"fontSize\":\"24\"},{\"text\":\"Bend down and touch your toes or poke out your tongue to lick your nose.\",\"fontSize\":\"24\"}]}", "checkListTextData": {"heading": "", "checkList": [{"key": "Zp4QUxdhkxXOUNca1m6Vl", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35229717, "text": "<h2>You Will Need:</h2>\nA set of \"or\" challenge cards (or use the cards at the bottom of this page)", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 3