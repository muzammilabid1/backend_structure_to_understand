[{"id": 402559559, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 389747250, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "jsm4kWIrZKcBEVgfkNNYf", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Putting on our space boots, suit and helmet</span></p>\n<p><span style=\"color: rgb(124,112,107);font-size: 16px;font-family: Verdana;\">Make the movements needed to put these things on our bodies.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "Dh5l6Dvw1SxXcE3UMWNRR", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Taking off in a rocket</span></p>\n<p><span style=\"color: rgb(124,112,107);font-size: 16px;font-family: Verdana;\">Countdown 5-4-3-2-1...  then blast off into space and run really fast on the spot until you reach the moon.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "9X4Vx1Hc16uabBeAkKi2b", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Going for a moonwalk</span></p>\n<p><span style=\"color: rgb(124,112,107);font-size: 16px;font-family: Verdana;\">Make big slow steps lifting your feet up really high.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "Oi6R1xgd4rgvWuLkVSPV_", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Spinning planets</span></p>\n<p><span style=\"color: rgb(124,112,107);font-size: 16px;font-family: Verdana;\">Turn around slowly with your arms out – try not to get too dizzy!</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "9VzW0SWz3G1-ipXhrmocw", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Twinkling stars</span></p>\n<p><span style=\"color: rgb(124,112,107);font-size: 16px;font-family: Verdana;\">Wiggle your fingers and thumbs like twinkling stars.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "wcK-ws9znHoL6tSInqLa4", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Back down to earth </span></p>\n<p><span style=\"color: rgb(124,112,107);font-size: 16px;font-family: Verdana;\">Gently glide through the atmosphere as you slowly walk around and land safely sitting on the floor. </span></p>\n", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "xFUVDXHcQD9-g9J8jeLQj", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 389747580, "text": "How does this help?", "modal": {"steps": [{"id": 389747473, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 368, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Going on a space walk together helps children to:</p>\n<ul>\n<li>Have fun while being physically active and developing their strength and co-ordination;</li>\n<li>Become aware of the positions of their bodies in relation to objects around them (‘spatial awareness’);</li>\n<li>Learn new words as they play.&nbsp;</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "LJw2G9UBWNBxdUGwIdGsi", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 368, "name": "How does going on a space walk help?", "logCreatedAt": "2024-09-10T11:44:21.201548", "logUpdatedAt": "2024-09-10T11:45:28.309028", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": "Space walk rationale"}}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 389747250, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 368, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "MHF9P0kWPGw0H9IRH6DFu", "checked": false,