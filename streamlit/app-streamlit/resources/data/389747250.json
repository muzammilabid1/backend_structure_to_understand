{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 389747250, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "jsm4kWIrZKcBEVgfkNNYf", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Putting on our space boots, suit and helmet</span></p>\n<p><span style=\"color: rgb(124,112,107);font-size: 16px;font-family: Verdana;\">Make the movements needed to put these things on our bodies.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "Dh5l6Dvw1SxXcE3UMWNRR", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Taking off in a rocket</span></p>\n<p><span style=\"color: rgb(124,112,107);font-size: 16px;font-family: Verdana;\">Countdown 5-4-3-2-1...  then blast off into space and run really fast on the spot until you reach the moon.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "9X4Vx1Hc16uabBeAkKi2b", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Going for a moonwalk</span></p>\n<p><span style=\"color: rgb(124,112,107);font-size: 16px;font-family: Verdana;\">Make big slow steps lifting your feet up really high.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "Oi6R1xgd4rgvWuLkVSPV_", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Spinning planets</span></p>\n<p><span style=\"color: rgb(124,112,107);font-size: 16px;font-family: Verdana;\">Turn around slowly with your arms out – try not to get too dizzy!</span></p>\n", "labelEditorState": null}, {"alt": null,