[{"id": 478543256, "text": "<h2>Challenge:</h2>\nChoose one of these other lists. Think about which thing is the odd one out and some reasons why, then think about all the other things in the list and give reasons why they could be the odd one out instead!", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 478543219, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 478543227, "text": "Some things you might have said", "modal": {"steps": [{"id": 39778091, "text": "Here are some things you might have said: \n<br></br>\n<ul>\n<li>Horse because:\n<ul style=\"list-style-position: inside\">\n<li>it’s the only one you’d find running in the Grand National;</li>\n<li>it’s the only one that could also describe how your voice sounds when you have a sore throat.</li>\n</ul>\n<br></br>\n<li>Cow because:\n<ul style=\"list-style-position: inside\">\n<li>it’s the only one people don’t usually ride;</li>\n<li>it’s the only one which also describes the female of its species;</li>\n<li>it’s the only one that can also be a verb – to make someone do what you want by intimidating them, e.g. “The king had cowed his people into silence.”</li>\n</ul>\n<br></br>\n<li>Donkey because:\n<ul style=\"list-style-position: inside\">\n<li>it’s the only one that has another noun (key) inside it;</li>\n<li>it’s the only one you can ride on at the seaside.</li>\n</ul>\n<br></br>\n<li>Camel because: \n<ul style=\"list-style-position: inside\">\n<li>it’s the only one isn’t usually found on farm in the UK;</li>\n<li>it’s a zoo animal not a farm animal;</li>\n<li>it’s the only one which is also a colour.</li>\n</ul>\n<br></br>\n<li>Mule because:\n<ul style=\"list-style-position: inside\">\n<li>it’s the only one I hadn’t heard of before;</li>\n<li>it’s the only one that’s a cross between two other animals – it’s the offspring of male donkey and a female horse;</li>\n<li>It’s the only one that is also the name of a type of shoe.</li>\n</ul>\n<br></br>\n<li>Pony because:\n<ul style=\"list-style-position: inside\">\n<li>it’s the only one that’s a small version of one of the others;</li>\n<li>it’s the only one which is a slang term for an amount of money (£25).</li>\n</ul>\n</ul>\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 6, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 6, "name": "Some things you might have said", "logCreatedAt": "2021-11-03T12:06:16.904075", "logUpdatedAt": "2021-11-03T12:06:16.904075", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 4, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSi