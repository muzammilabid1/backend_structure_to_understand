[{"id": 109918077, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54225520, "dimensions": null, "editAsHtml": true, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Player 1 turns over a word card.&nbsp;</li>\n<ul>\n<li>If the word can be used to fill a space in a sentence on their board, put it on top of the sentence.</li>\n<li>If the word cannot be used, put it face-up next to the pile.</li>\n</ul>\n<li>Player 2 can either choose the top face-up card or turn over the next card on the face-down stack.&nbsp;</li>\n<ul>\n<li>If the word can be used to fill a space in a sentence on their board, put it on top of the sentence.</li>\n<li>If the word cannot be used, put it face-up next to the pile (on top of any other face-up cards).</li>\n</ul>\n<li>Continue taking it in turns to choose a word card until one person has covered all the sentences on their board.</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 82855576, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54225520, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Getting ready:</h2>\n<ul>\n<li>Cut the lotto board sheet in half so both players have a 3x3 grid of sentences.</li>\n<li>Cut out the lotto word cards and make a face-down stack of the words.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 154795494, "text": "Two lotto boards cut out and put on a table, facing in opposite directions. There is a pile of cards face down between the boards, with one card face up next to it with the word \"overbake\" on it. One of the cards (which says \"oversell\") is on a square on the lotto board which faces the camera. ", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Over lotto trimmed boards blob", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Over lotto trimmed boards blob-1KNyNRkS1mdKVxuphS0w4.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54225520, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "image