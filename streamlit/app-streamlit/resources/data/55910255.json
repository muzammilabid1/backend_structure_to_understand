[{"id": 55910286, "text": "<h2>How to play:</h2>\nBefore you start, choose a topic you are interested in, e.g. vehicles, animals, music...\n<ol>\n<li>Choose one item from the category, e.g. 'zebra' if your topic is 'animals'.</li>\n<li>Both people think of a fact.</li>\n<li>Then hold hands - your hands are the 'and' joining your two sentences together.</li> \n<li>Player 1 says their fact, both players say 'and' together while squeezing hands, then Player 2 says their fact.</li>\n<li>Repeat from step 1 to make up some more sentences!</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 55910255, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 55910342, "text": "Two koalas are holding hands. The adult is saying, 'Zebras have stripes', then both koalas are saying 'and' as they squeeze each other's hands, and then the child is saying, 'Zebras have four legs.'", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "and_in_my_hand_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "And in my hand koalas-IcfHGGrwygwnrCm9zCnIU.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "