[{"id": 82799169, "text": null, "modal": {"steps": [null], "details": null}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54224635, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<ol>\n<li>Read the poem together.</li>\n<li>Do you have any first ideas of what the highlighted words might mean?</li>\n<li>Look at the definitions below the poem. Match the words to the definitions! Which clues did you use to help?</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 82800258, "text": "Read the whole poem", "modal": {"steps": [{"id": 82800202, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 195, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><strong> </strong><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\"><strong>“Jabberwocky”</strong></span><strong> </strong></p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">By Lewis Carroll</span>&nbsp;</p>\n<p>&nbsp;&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">’Twas brillig, and the slithy toves</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">Did gyre and gimble in the wabe;</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">All mimsy were the borogoves,</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">And the mome raths outgrabe. </span>&nbsp;</p>\n<p>&nbsp;&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">“Beware the Jabberwock, my son!</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">The jaws that bite, the claws that catch!</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">Beware the Jubjub bird, and shun</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">The frumious Bandersnatch!”</span>&nbsp;</p>\n<p>&nbsp;&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">He took his vorpal sword in hand:</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">Long time the manxome foe he sought—</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">So rested he by the Tumtum tree,</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">And stood awhile in thought.</span>&nbsp;</p>\n<p>&nbsp;&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">And as in uffish thought he stood,</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">The Jabberwock, with eyes of flame,</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">Came whiffling through the tulgey wood,</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">And burbled as it came!</span>&nbsp;</p>\n<p>&nbsp;&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">One, two! One, two! And through and through</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">The vorpal blade went snicker-snack!</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">He left it dead, and with its head</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">He went galumphing back.</span>&nbsp;</p>\n<p>&nbsp;&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">“And hast thou slain the Jabberwock?</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">Come to my arms, my beamish boy!</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">O frabjous day! Callooh! Callay!”</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">He chortled in his joy.</span>&nbsp;</p>\n<p>&nbsp;&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">’Twas brillig, and the slithy toves</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">Did gyre and gimble in the wabe;</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">All mimsy were the borogoves,</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">And the mome raths outgrabe.</span>&nbsp;&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 195, "name": "Jabberwocky", "logCreatedAt": "2022-09-27T10:08:29.657366", "logUpdatedAt": "2022-09-27T10:08:29.657366", "logCreatedById": 2