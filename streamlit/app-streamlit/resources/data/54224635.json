: null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 194, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">This is the first part of the poem “Jabberwocky” by Lewis Carroll. Below, are the definitions of some of the words. Match the words to the definitions! Which clues did you use to help?</span>&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 82799666, "text": null, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 194, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p style=\"text-align:center;\">&nbsp;<span style=\"font-size: 18pt;font-family: Sassoon Infant Rg;\">’Twas brillig, and the </span><span style=\"color: rgb(242,141,0);font-size: 18pt;font-family: Sassoon Infant Rg;\">slithy</span> <span style=\"color: rgb(242,141,0);font-size: 18pt;font-family: Sassoon Infant Rg;\">toves</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 18pt;font-family: Sassoon Infant Rg;\">Did </span><span style=\"color: rgb(242,141,0);font-size: 18pt;font-family: Sassoon Infant Rg;\">gyre</span> <span style=\"font-size: 18pt;font-family: Sassoon Infant Rg;\">and gimble in the </span><span style=\"color: rgb(242,141,0);font-size: 18pt;font-family: Sassoon Infant Rg;\">wabe</span><span style=\"font-size: 18pt;font-family: Sassoon Infant Rg;\">;</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 18pt;font-family: Sassoon Infant Rg;\">All </span><span style=\"color: rgb(242,141,0);font-size: 18pt;font-family: Sassoon Infant Rg;\">mimsy</span> <span style=\"font-size: 18pt;font-family: Sassoon Infant Rg;\">were the borogoves,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 18pt;font-family: Sassoon Infant Rg;\">And the mome raths </span><span style=\"color: rgb(242,141,0);font-size: 18pt;font-family: Sassoon Infant Rg;\">outgrabe</span><span style=\"font-size: 18pt;font-family: Sassoon Infant Rg;\">.</span>&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 82799750, "text": null, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "modalId": 194, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>&nbsp;<span style=\"color: rgb(242,142,0);font-size: 16pt;font-family: Sassoon Infant Rg;\">________________</span> <span style=\"font-size: 10pt;font-family: Sassoon Infant Rg;\">VERB</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">To go round and round in a circle or spiral.</span>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span style=\"color: rgb(242,142,0);font-size: 16pt;font-family: Sassoon Infant Rg;\">________________</span> <span style=\"font-size: 10pt;font-family: Sassoon Infant Rg;\">ADJECTIVE</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">A portmanteau* of miserable and flimsy.</span>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span style=\"color: rgb(242,142,0);font-size: 16pt;font-family: Sassoon Infant Rg;\">________________</span> <span style=\"font-size: 10pt;font-family: Sassoon Infant Rg;\">VERB</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">Something between bellowing and whistling, with a kind of sneeze in the middle.</span>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span style=\"color: rgb(242,142,0);font-size: 16pt;font-family: Sassoon Infant Rg;\">________________</span> <span style=\"font-size: 10pt;font-family: Sassoon Infant Rg;\">ADJECTIVE</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">Smooth and active.</span>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span style=\"color: rgb(242,142,0);font-size: 16pt;font-family: Sassoon Infant Rg;\">________________</span> <span style=\"font-size: 10pt;font-family: Sassoon Infant Rg;\">NOUN</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">Creatures something like badgers, something like lizards, and something like corkscrews. Also they make their nests under sun-dials, and they live on cheese.</span>&nbsp;</p>\n<p>&nbsp;</p>\n<p><span style=\"color: rgb(242,142,0);font-size: 16pt;font-family: Sassoon Infant Rg;\">________________</span> <span style=\"font-size: 10pt;font-family: Sassoon Infant Rg;\">NOUN</span>&nbsp;</p>\n<p><span style=\"font-size: 14pt;font-family: Sassoon Infant Rg;\">The grass plot around a sundial, called this because it goes a long way before it and a long way behind it.</span>&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 211301510, "text": null, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "modalId": 194, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Sassoon Infant Rg;\"><em>*A portmanteau  word is where parts of multiple words are combined to make a new word, e.g. 'brunch' is a blend of </em><strong><em>br</em></strong><em>eakfast and l</em><strong><em>unch</em></strong><em>.</em></span></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 194, "name": "Jabberwocky activity", "logCreatedAt": "2022-09-27T10:02:31.295818", "logUpdatedAt": "2022-09-27T10:08:06.852288", "logCreatedById": 21670528, "logUpdatedById": 21670