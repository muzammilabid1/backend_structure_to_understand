ll, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 26, "name": "No word cards?", "logCreatedAt": "2021-11-08T12:59:19.648545", "logUpdatedAt": "2021-11-08T12:59:19.648545", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2970, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 26, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4472, "text": "<h2>How to play:</h2>\n<ol>\n<li>Pile up the word cards face down on the table.</li>\n<li>Turn over the top card.</li>\n<li>Read the word aloud.</>\n<li>Turn the card over so you can't see the word.</li>\n<li>Write the word on the paper.</li>\n<li>Flip the card back over and check your spelling.</li>\n<li>If you made a mistake, copy the correct spelling of the word next to your mistake.</li>\n<li>Repeat with the next word in the pile.</li>\n<li>There are lots of words, and it can get tiring, so maybe just do five or six words each time you do this activity.</li>\n</ol>\n<br></br>\n<h2>What are the jars for?</h2>\nYou can just use a jar for storing your words, but the two jars are also a really good way of keeping track of which words you can spell and which words need a bit more practice.\n<ul>\n<li>One jar is the practice jar and the other is a jar for words which you can spell.</li>\n<li>Keep all the words in the practice jar.</li>\n<li>If you have spelled a word correctly on three separate occasions, move it into the other jar.</li>\n<li>Over time, all the words should move from the practice jar into the jar for words you can spell!</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2970, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4471, "text": " <h2>You will need:</h2>\n<ul>\n<li>Pencil</li>\n<li>Paper</li> \n<li>Two jars</li>\n<li>Word cards (from Activities 1 and 2, or click link below)</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2970, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]