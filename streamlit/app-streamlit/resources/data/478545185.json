[{"id": 478546587, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXTDICE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 478545185, "dimensions": null, "editAsHtml": false, "properties": {"height": null, "btnText": "Roll a category and a number", "expression": null, "diceProperties": [{"width": "240px", "images": [], "fileIds": [], "diceType": "TEXT", "isInfant": true, "fileNames": [], "inputArray": "food, ice cream flavour, holiday destination, flower, animal, crisp flavour, hobby, sport, team, wall colour, drink, place, singer, country, game, item of clothing"}, {"width": null, "images": [], "fileIds": [], "diceType": "TEXT", "isInfant": true, "fileNames": [], "inputArray": "1,2,3,4,5,6,7,8,9"}], "longTextFontSize": null}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "uNq9XpC6o3PIEwaudH6fT", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479444709, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 478545185, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": "A semicircle drawn on a sheet of paper. The numbers 1-9 are evenly spaced around the edge. \"Worst\" is written under the end with the number 1, and \"Best\" is written under the end with the number 9.", "type": "IMAGE", "fileName": "Where would it rank - layout blob", "imageUrl": "Where would it rank - layout blob-8v-6SBL2GG-QiD0vbueJI.png", "fileIdentifier": "8v-6SBL2GG-QiD0vbueJI", "textEditorState": null, "labelEditorState": "<p></p>\n"}, {"alt": "A plate is placed over the dial (drawn in the image above) so you can see how drawing round half of the edge would help with the shape.", "type": "IMAGE", "fileName": "Where would it rank - plate blob", "imageUrl": "Where would it rank - plate blob-On_Og_lpsZY-t7bsFMFkr.png", "fileIdentifier": "On_Og_lpsZY-t7bsFMFkr", "textEditorState": null, "labelEditorState": "<p></p>\n"}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "7lHKErHLOaUVDlDgRmR3T", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 478546268, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 478545185, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Player 1 rolls the dice to get a category and a number. Tell the other players the category but <strong>not the number</strong>.</li>\n<li>Player 1 thinks of something from the category which they would rank at that number.</li>\n<li>Player 1 tells the other players their thing (but not the number).</li>\n<li>The other players must guess which number Player 1 has ranked it at. Use your pen to show the number you think (like on the image below).</li>\n<li>Player 1 can then reveal the number - were the other players correct?</li>\n<li>Compare where the other players would rank the same thing - would they agree or not? Why? (Remember, this doesn't mean Player 1 was wrong, just that you have a different opinion and different tastes.)</li>\n<li>Repeat, taking it in turns to be Player 1.</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "sC3G1JxQU-rzW50WfLY1p", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479443384, "text": "Example game", "modal": {"steps": [{"id": 479445191, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 421, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": "The dice has been rolled, showing: \"food\" and \"7\".", "type": "IMAGE", "fileName": "Where would it rank example blob", "imageUrl": "Where would it rank example blob-k12lB3Xz7_urrUaLY-3Bh.png", "fileIdentifier": "k12lB3Xz7_urrUaLY-3Bh", "textEditorState": null, "labelEditorState": "<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Player 1 rolls the dice.</span>&nbsp;</p>\n"}, {"alt": "A koala saying \"food\".", "type": "IMAGE", "fileName": "Koala with speech bubble 'food'", "imageUrl": "Koala with speech bubble 'food'-DLdSxYOjjU62hY8N_3NBj.png", "fileIdentifier": "DLdSxYOjjU62hY8N_3NBj", "textEditorState": null, "labelEditorState": "<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Player 1 tells Player 2 that the category is \"food\". They do not say the number.</span>&nbsp;</p>\n"}, {"alt": "A koala saying \"salmon\".", "type": "IMAGE", "fileName": "Koala with speech bubble 'salmon'", "imageUrl": "Koala with speech bubble 'salmon'-ZNuD2a_RWFzILLDEXPsfh.png", "fileIdentifier": "ZNuD2a_RWFzILLDEXPsfh", "textEditorState": null, "labelEditorState": "<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Player 1 thinks of a food they would rank at number 7. They think, \"I quite like salmon but it's not my most favourite.\" They tell Player 2 that the food they have chosen is \"salmon\".</span>&nbsp;</p>\n"}, {"alt": "The pen is pointing to \"3\" on the dial.", "type": "IMAGE", "fileName": "Where would it rank - dial blob", "imageUrl": "Where would it rank - dial blob-94zVjDUFpmVWGUfwPBEnP.png", "fileIdentifier": "94zVjDUFpmVWGUfwPBEnP", "textEditorState": null, "labelEditorState": "<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Player 2 thinks about where Player 1 might have ranked \"salmon\". They think, \"I don't think they can like salmon that much... I will say three.\" They use a pen to point at number 3 on their dial.</span>&nbsp;</p>\n"}, {"alt": "A koala saying, \"Actually, my number was 7!\"", "type": "IMAGE", "fileName": "Koala with speech bubble '7'", "imageUrl": "Koala with speech bubble '7'-KCWGVFF_vkujtedYYA3q5.png", "fileIdentifier": "KCWGVFF_vkujtedYYA3q5", "textEditorState": null, "labelEditorState": "<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Player 1 reveals what number they actually rolled (7). Player 2 wasn't correct!</span>&nbsp;</p>\n"}, {"alt": "An adult and a child koala standing talking together.", "type": "IMAGE", "fileName": "Adult and child koalas talking", "imageUrl": "Adult and child koalas talking-mOab0IM2pGBnrxndja8D6.png", "fileIdentifier": "mOab0IM2pGBnrxndja8D6", "textEditorState": null, "labelEditorState": "<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">The two players compare what they think about salmon. Why does Player 1 like it more than Player 2 expected? Does Player 2 like salmon more or less than Player 1? </span>&nbsp;</p>\n"}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": "DAJmwp6scWBwNyuJS02qf", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Round one is complete! They repeat the game, this time with Player 2 rolling the dice. </span></p>\n", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "1A8_G9hXOQqApsh5NBYhx", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 421, "name": "Example game", "logCreatedAt": "2024-11-05T10:18:47.694081", "logUpdatedAt": "2024-11-05T10:18:47.694081", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": "Where would it rank? Example game"}}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 478545185, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 421, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "qRfWypV8qCzjX7vaf97Hj", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 478547360, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 478545185, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Setting up:</h2>\n<p>You will each need a dial (like the one in the image below).&nbsp;</p>\n<p>You can draw round half a plate to help with the shape if you like.&nbsp;</p>\n<p>Space the numbers 1-9 evenly around the edge, writing \"worst\" under 1 and \"best\" under 9.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "x6GvOuZcTMnTVz1EAKm16", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]