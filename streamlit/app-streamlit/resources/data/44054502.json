[{"id": 44055137, "text": "Similes to Improve", "modal": {"steps": [{"id": 44054915, "text": "Read these similes and talk together about why the simile is inappropriate. Can you say why it doesn't work and suggest a better alternative? The words you should change are written in <span style=\"color:#F28D00\">orange</span>.\n<br></br>\n<ul>\n<li>The baby was as cute as <span style=\"color:#F28D00\">a wolf cub</span>.</li> \n<li>The dog was as lazy as <span style=\"color:#F28D00\">a lazybones</span>.</li> \n<li>He climbed the tree like <span style=\"color:#F28D00\">a climber</span>.</li> \n<li>She was as beautiful as <span style=\"color:#F28D00\">a brand new computer</span>.</li> \n<li>He was as tall as <span style=\"color:#F28D00\">a 175cm tall tree</span>.</li> \n<li>She was as fast as <span style=\"color:#F28D00\">a really fast person</span>.</li> \n<li>The touch of her hand was as cold as <span style=\"color:#F28D00\">a piece of metal that had been in the fridge</span>.</li> \n<li>He swam across the pool like <span style=\"color:#F28D00\">a goldfish</span>.</li> \n</ul>", "order": 1, "btnType": null, "linkUrl": null, "modalId": 107, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 107, "name": "Similes to Improve", "l