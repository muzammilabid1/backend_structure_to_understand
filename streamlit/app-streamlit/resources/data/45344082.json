[{"id": 45344536, "text": "<h2>The Activity:</h2>\n<ol>\n<li>Decide on a start and finish place. You could put a cushion at each end or move from doorway to doorway. You decide!</li>\n<li>Roll the die to give yourself a way of moving.</li>\n<li>Move from your start to finish using the movement from the die.</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45344082, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45344618, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXTDICE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45344082, "dimensions": null, "editAsHtml": false, "properties": {"height": null, "btnText": null, "diceProperties": [{"width": "180px", "images": [], "isInfant": true, "inputArray": "animal walks, crab walks, crawling, tummy crawling, bunny hops"}], "longTextFontSize": null}, "deletedById": null, "downloadUrl": null, "editorState": null, "carous