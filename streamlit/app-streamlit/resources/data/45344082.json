": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45344781, "text": "<b>Want to be a bit more competitive?</b>\n<br>You could race another person from the start to finish. Or you could use a timer and see if you can beat your own time!", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45344082, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45344151, "text": "<h2>1. Warmup:</h2>\nTest out these different ways of moving:\n<ul>\n<li><b>Animal walks</b> - walk around on your hands and feet with your tummy towards the floor;</li>\n<li><b>Crab walk</b> - walk around on your hands and feet with your tummy in the air;</li>\n<li><b>Crawling</b> - move like a baby on your hands and knees;</li>\n<li><b>Tummy crawling</b> - lie on your tummy and pull yourself along with your arms;</li>\n<li><b>Bunny hops</b> - put your hands ahead of you, keep your hands still while you jump your feet forwards.</li>\n</ul>", "