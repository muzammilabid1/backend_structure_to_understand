[{"id": 35563195, "text": "<h2>Writing 1: </h2>\nSwap bubbles with the other person and write what they said on a piece of paper. \n<ul>\n<li>If it ends with a ? or ! you can leave it as it is, but if it ends with a full stop you will need to change it to a comma. </li>\n<li>Add in your speech marks.</li>\n<li>Write who said it after the speech (and how) – this is called the ‘reporting clause’. Remember, you don't need a capital letter to start the reporting clause when it comes after the speech. </li>\n<li>Remember to end your sentence with some punctuation too! </li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633515893346_1image1-01FHAJ3B78N30DY1X031Q4FHDD.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35562528, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35562602, "text": "<h2>Preparation:</h2>\n<ol>\n<li>Cut out two big speech bubbles from the sides of a cereal box.</li>\n<li>Each person take one bubble and write something they would say inside the bubble. Remember your capital letter and sentence ending punctuation. Your speech could include more than one sentence if you like.</li> \n</ol>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633515576403_1image1-01FHAHNFNHWV7KNZZMXV2HQWYR.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35562528, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35563291, "text": "<h2>Writing 2: </h2>\nUsing the same speech bubbles, see if you can put the reporting clause at the start of the sentence, e.g. Mum shouted, \".....\"\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633516025757_1image1-01FHAJ8H4TD2A42P7JF3W1RBW9.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35562528, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]