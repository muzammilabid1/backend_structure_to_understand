[{"id": 35476991, "text": "<h2>Activity:</h2>\n<ol>\n<li>Player 1 chooses a job but doesn't tell the other person what it is</li>\n<li>Player 1 puts the words for their chosen job in order from most to least important.</li>\n<li>Player 2 guesses what the job is from the order of the words.</li>\n<li>Once Player 2 has guessed, they should say whether they agree or disagree with Player 1’s order and why.</li>\n<li>Swap over and repeat.</li>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35476124, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35476132, "text": "<h2>Preparation:</h2>\nTogether, think of ten (or more) words that can be used to describe a person (e.g. clever, boring, excitable, beautiful). Write them on scraps of paper so you can move the words around on the table.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633439257045_1image1-01FH88QT7BVGH4ZKA67750XW9Z.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35476124, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35476974, "text": "<h2>Warmup:</h2>\nChoose a job (look at the balloon below if you need ideas) and work together to order the personality words by how important they are for a particular job. At this point, you might decide to write some new personality describing words to add to your collection. ", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633439587235_1image1-01FH893FS1ZYR5N9S1KNMF0NK4.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35476124, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]