[{"id": 35464547, "text": "<h2>Idea 2: Fairy Tale</h2>\nYou could imagine a character in a fairy tale talking about what happened to them. For instance, you could be Little Red Riding Hood telling her mum all about what happened when she arrived at Grandma’s house.\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633429587484_1image1-01FH7ZEJGP45C11C7RA6MS7GWE.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35463628, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35464609, "text": "<h2>Idea 3: Your Own Idea</h2>\nMaybe you have another great idea for something you could write and perform – go for it!", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35463628, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35463736, "text": "Have a go at writing your own paragraph and then practising and performing it. Here are some ideas of what you could write:\n<br><br>\n<h2>Idea 1: Nature Documentary</h2>\nYou could imagine you were in a nature documentary, perhaps like one by David Attenborough. In your paragraph, you could describe an animal you can see and what it is doing.\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633429163628_1image1-01FH7Z806VFBHE3J9K0VSYD78S.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35463628, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]