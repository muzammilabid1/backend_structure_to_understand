udeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 130958907, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 130958110, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>The Puzzle:</h2>\n<p>A bar of chocolate costs 45p.</p>\n<p>You only have 5p coins and 10p coins.</p>\n<h2><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\"><strong>Part 1:</strong></span></h2>\n<ul>\n<li><span style=\"font-size: 16px;font-family: Verdana;\">Which coins do you need to pay exactly 45p?</span></li>\n</ul>\n<p></p>\n<h2><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\"><strong>Part 2:</strong></span></h2>\n<ul>\n<li>What is the smallest number of coins that could be used to pay 45p?</li>\n<li>What is the largest number of coins that could be used to pay 45p?</li>\n<li>How could you pay 45p using 6 coins?</li>\n</ul>\n<p></p>\n<p></p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 130958896, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": nul