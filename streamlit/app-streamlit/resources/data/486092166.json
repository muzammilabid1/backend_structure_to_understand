ouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "yLRIHwLEu-ckYbomf06fh", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 486092260, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 486092166, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You Will Need:</h2>\n<ul>\n<li>A shoe box (or other similar sized box, e.g. a cereal box)</li>\n<li>Things to decorate the inside with. You could use:</li>\n<ul>\n<li>Old wrapping paper</li>\n<li>Food packaging</li>\n<li>Stickers</li>\n<li>Toys</li>\n<li>Things from the garden or park</li>\n<li>Colouring pens and pencils</li>\n</ul>\n<li>Characters for your play – they could be mini figures or cut out of card.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "Mj_ioAoyyAv-HAB6XKOZN", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 521799945, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 486092166, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Practise:</h2>\n<p>Practise moving the characters around and saying words to tell the story. You might want to use your own voice as the narrator as well as making the characters speak.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "WQ29EX281aHHRVeibWZJf", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 521799879, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 486092166, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Setting Up:</h2>\n<ol>\n<li>Decide what story you are going to tell. It could be a story you know or one you are making up. But the inside of the box needs to match your story!</li>\n<li>Make sure your box has a hole at the front. A shoe box comes like this, but you might need to cut a hole in the side of a cereal box.</li>\n<li>Decorate the box. You can draw or stick things on the back, on the bottom and hanging down the front!</li>\n<li>Put your characters into your box.</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "CktyF7PDRo10T6rc3YbPb", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]