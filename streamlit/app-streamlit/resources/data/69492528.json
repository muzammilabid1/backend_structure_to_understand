[{"id": 69492760, "text": "A koala with a lightbulb above its head - it's had an idea!", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "mathscot_with_lightbulb_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Asset 14-7dnT7xxG1hl0YR_FD1Tkt.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 69492528, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 69492643, "text": "<h2>How to play</h2>\n<ol>\n<li>Fold each word card in half and put it into the container.</li>\n<li>Choose who is going to describe first.</li>\n<li>Start the two minute timer.</li>\n<li>The first player must describe as many words as they can to the other player before the time runs out. You must not say the word or its spelling!</li>\n<li>Each time they guess a word, you can keep the slip (so you can see how many you successfully described).</li>\n<li>When the time runs out, swap over.</li>\n<li>Keep swapping over until all the words have run out.</li>\n<li>Count up the number of words you successfully described. Who described the most? They are the winner!</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 69492528, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 69492643, "text": "<h2>How to play</h2>\n<ol>\n<li>Fold each word card in half and put it into the container.</li>\n<li>Choose who is going to describe first.</li>\n<li>Start the two minute timer.</li>\n<li>The first player must describe as many words as they can to the other player before the time runs out. You must not say the word or its spelling!</li>\n<li>Each time they guess a word, you can keep the slip (so you can see how many you successfully described).</li>\n<li>When the time runs out, swap over.</li>\n<li>Keep swapping over until all the words have run out.</li>\n<li>Count up the number of words you successfully described. Who described the most? They are the winner!</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 69492528, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadNam