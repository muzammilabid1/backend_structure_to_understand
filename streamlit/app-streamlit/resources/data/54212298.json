[{"id": 56521109, "text": "Three rectangles of brown card, each with a spelling rule written on: 1. minus e plus ing; 2. double the consonant plus ing; 3. no change plus ing. ", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "ing_spelling_rule_cards_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "ing_spelling_rule_cards_image-01FWRMNPBJ5BVGKN6DBTPXX62W.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54212298, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 56522621, "text": "Check your spelling", "modal": {"steps": [{"id": 56522085, "text": "<h2>-e +ing</h2>\nmake → making\n<br>hike → hiking\n<br>bake → baking\n<br>escape → escaping\n<br>rumble → rumbling\n<br></br>\n<h2>double the consonant +ing </h2>\n cut → cutting\n<br>run → running\n<br>pat → patting\n<br>hum → humming\n<br>pop → popping\n<br></br>\n<h2>no change +ing</h2>\nfly → flying\n<br>cry → crying\n<br>copy → copying\n<br>jump → jumping\n<br>fall → falling\n<br>box → boxing\n<br>mix → mixing\n<br>be → being\n<br>ski → skiing\n<br></br>\nRemember, the ending does not change if:\n<ul>\n<li>The word ends 'y'</li>\n<li>The word ends with two consonants</li>\n<li>The word ends with 'x'</li>\n<li>The word is 'be' (this is an exception to the '-e +ing' rule)</li>\n<li>The word ends in 'i'</li>\n</ul>", "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 154, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 154, "name": "Adding 'ing'", "logCreatedAt": "2022-02-25T14:45:03.866063", "logUpdatedAt": "2022-02-25T14:45:03.866063", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54212298, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 154, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 56521954, "text": "Watch out! There might be some words that try to trick you!", "modal": {"steps": [null]