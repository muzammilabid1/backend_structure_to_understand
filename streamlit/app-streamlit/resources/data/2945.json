[{"id": 41938634, "text": "What if I can't add 'er' or 'est'?", "modal": {"steps": [{"id": 41932156, "text": "Some words can't have 'er' or 'est' added on the end. If you come across any, you could talk about how some words sound funny with those endings, and you just have to say it differently. \n<br></br>\nHere are some examples:\n<br></br>\n<ul>\n<li><b>Beautiful:</b>\n<ul> \n<li>My teddy is beautiful.</li>\n<li>My teddy is more beautiful.</li>\n<li>My teddy is the most beautiful.</li>\n</ul>\n<li><b>Amazing:</b>\n<ul>\n<li>My teddy is amazing.</li>\n<li>My teddy is more amazing.</li>\n<li>My teddy is the most amazing.</li>\n</ul>\n<li><b>Brilliant:</b>\n<ul>\n<li>My teddy is brilliant.</li>\n<li>My teddy is more brilliant.</li>\n<li>My teddy is the most brilliant.</li>\n</ul>\n</ul>", "order": 1, "btnType": null, "linkUrl": null, "modalId": 66, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 66, "name": "What if I can't add 'er' or 'est'?", "logCreatedAt": "2021-11-15T16:21:02.940668", "logUpdatedAt": "2021-11-15T16:21:02.940668", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2945, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 66, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 41931254, "text": "<h2>How to play:</h2>\n<ol>\n<li>Think together of some words that describe your teddies.</li>\n<li>Player 1 chooses a word and uses it in a sentence.\n<br><i> E.g. 'My teddy is <span style=\"color:#F28D00\">cuddly</span>.'</i></li>\n<li>Player 2 adds <span style=\"color:#F28D00\">er</span> to the end of the word and uses it about their teddy.\n<br><i>E.g. 'My teddy is <span style=\"color:#F28D00\">cuddlier</span> than your teddy.'</i></li>\n<li>Player 1 adds <span style=\"color:#F28D00\">est</span> to the end of the word and uses it to show their teddy is the best.\n<br><i>E.g. 'My teddy is the <span style=\"color:#F28D00\">cuddliest</span> in the whole world.'</i></li>\n<li>Switch who goes first and repeat the game with another word.</li>\n<li>Keep taking turns to start, and see how many creative ways you can say how amazing your teddy is!</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2945, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 187168050, "text": "763383291", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2945, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4031, "text": "For this activity, you will need two toys. Two cuddly teddies will work really well!\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2945, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]