[{"id": 35471459, "text": "<h2>You Will Need:</h2>\n<ul>\n<li>A piece of paper;</li>\n<li>Something to write with;</li>\n<li>A window to look out of.</li>\n</ul>\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633435882662_1image1-01FH85SS0E154MHR8YD10R4BV1.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35471366, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35471626, "text": "<h2>The Activity:</h2>\nLook out of the window. Write a list of what you can see, using a/an before each thing. \n<br></br>\nRemember, ‘a’ comes before words that start with a consonant sound and ‘an’ comes before words that start with a vowel sound. For example, ‘a car’ or ‘an elephant’ (though you’d be lucky to spot an elephant out of your window).\n<br></br>\n<h2>Increase the Challenge:</h2>\nSee if you can spot something for every letter of the alphabet.\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35471366, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]