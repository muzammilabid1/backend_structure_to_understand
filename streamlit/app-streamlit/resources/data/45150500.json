[{"id": 45151367, "text": "<h2>Think of Your Reasons:</h2>\nBoth people should think of <b>five</b> reasons to support their argument. \n<ul>\n<li>Decide what order to say your reasons in – maybe you want to save the best until last, or maybe you want to put the most powerful reason first. You choose!</li>\n<li>Make a note of your reasons so you don’t forget them!</li>\n</ul></li>\n<br></br>\n<h2>The Debate:</h2>\nPart 1: Listening\n<ul>\n<li>One person should share their five reasons while the other person listens.</li>\n<li>Then swap so that you have both had a chance to share and listen.</li>\n</ul>\n<br>\nPart 2: Talking Together\n<ul>\n<li>Talk together about why you think your side should win. This should be more like a conversation. </li>\n</ul>\n<br>\nPart 3: Finishing Off\n<ul>\n<li>When you are done, you both need to stop being on a side and talk together about which side’s arguments seemed most convincing. </li>\n<li>Decide which side was the winner in the debate (or if the answer was something in between or even something totally different). </li>\n</ul>\n", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45150500, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45150640, "text": "<h2>Choose a Side:</h2>\nEach player should pick a side. Make sure you take different sides.\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45150500, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45150677, "text": "Player 1: <b>Yes</b>, summer <b>is</b> the best season of the year.\n<br>Player 2: <b>No</b>, summer <b>is not</b> the best season of the year.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45150500, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size:16px;font-family:SassoonInfantRg-Regular;\">Player 1: <b>Yes</b>, summer <b>is</b> the best season of the year.\n<br>Player 2: <b>No</b>, summer <b>is not</b> the best season of the year.</span></p>", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45150717, "text": "A parent and child talking to each other.", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1638784104114_1image1-01FP7J95B6N3KGFM7BYWPR03M7.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45150500, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45151332, "text": "What if we both want the same side?", "modal": {"steps": [{"id": 45151628, "text": "You might both think summer is the best season of the year! But that's ok - in a debate you don't have to actually agree with what you are arguing! One of you can argue that summer is not the best season in the year (even though you might think it is) - you should still be able to think of lots of reasons, and it can be fun to argue something you don't believe!", "order": 1, "btnType": null, "linkUrl": null, "modalId": 122, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData