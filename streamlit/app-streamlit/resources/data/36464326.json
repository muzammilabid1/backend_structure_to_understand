, "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 36464326, "dimensions": null, "editAsHtml": true, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<ol>\n<li style=\"margin-left:0px;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Choose one player to be Simon.</span></li>\n<li style=\"margin-left:0px;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Simon gives instructions for the other person to follow, e.g. ‘Simon says touch your head.’</span></li>\n<li style=\"margin-left:0px;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">The other person follows the instructions.</span></li>\n<ul>\n<li style=\"margin-left:0px;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">If the person being Simon does not say ‘Simon says’ and only gives an instruction, the other person must not follow the instruction!</span></li>\n<li style=\"margin-left:0px;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">If the person following the instructions and gets tricked into doing something when they shouldn’t, you can swap over so they get a chance to be Simon.</span>&nbsp;</li>\n</ul>\n</ol> \n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 228723467, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 36464326, "dimensions": null, "editAsHtml": true, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<ol>\n<li style=\"margin-left:0px;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Choose one player to be Simon.</span></li>\n<li style=\"margin-left:0px;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Simon gives instructions for the other person to follow, e.g. ‘Simon says touch your head.’</span></li>\n<li style=\"margin-left:0px;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">The other person follows the instructions.</span></li>\n<ul>\n<li style=\"margin-left:0px;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">If the person being Simon does not say ‘Simon says’ and only gives an instruction, the other person must not follow the instruction!</span></li>\n<li style=\"margin-left:0px;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">If the person following the instructions and gets tricked into doing something when they shouldn’t, you can swap over so they get a chance to be Simon.</span>&nbsp;</li>\n</ul>\n</ol> \n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36465070, "text": "<h2>Challenge:</h2>\nYou can make it harder by adding two steps to your instructions, e.g.:\n<ul>\n<li>‘Simon says pat your head then jump up and down.’ </li>\n<li>‘Simon says do three star jumps then clap your hands.’</li>\n<li>‘Simon says sit down on the floor then get up and spin around.’</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36464326, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36465070, "text": "<h2>Challenge:</h2>\nYou can make it harder by adding two steps to your instructions, e.g.:\n<ul>\n<li>‘Simon says pat your head then jump up and down.’ </li>\n<li>‘Simon says do three star jumps then clap your hands.’</li>\n<li>‘Simon says sit down on the floor then get up and spin around.’</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36464326, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "s