[{"id": 2187, "text": "Cups are an American unit of measurement, often used in baking, and tsp means teaspoon <br /><br /> \n\n<b>The challenge </b> <br /><br />\n1) Which ingredients are measured in cups? <br /><br />\n2) How many cups of ingredients are being used altogether? (Simplify the fractions to help you) <br /><br />  3) Can you change the recipe to make 12 cookies?  <br /><br />   4) Extra challenge - Have a look at some recipes in books or online. What units do they use? Are any written in fractions?<br /><br /> (If you'd like to try the recipe, 1 cup = 240 ml)", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 1826, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 226083304, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Let's Bake Cookies!", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 1826, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": "Let's Bake Cookies!-IxWFpd2a3n0GTFAnqB0Eb.pdf", "editorState": null, "carous