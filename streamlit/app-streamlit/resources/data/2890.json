[{"id": 4479, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2890, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": "1637600555875_1download1-01FN49J6EWZ5Z1ZJAHP18J01KF.pdf", "editorState": null, "carouselData": null, "downloadName": "World cup sheet", "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 120902830, "text": null, "modal": {"steps": [null], "details": null}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2890, "dimensions": null, "editAsHtml": true, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<ol>\n<b><li>For each competing pair of teams, debate which team would win. </b><dd>It could win because it is the best, the strongest, the fastest, or just your favourite...</dd></li>\n<b><li>Write the winning teams in the semi finalists spaces. </b><dd>There should be four semi finalists in the middle of the sheet.</dd></li>\n<b><li>Repeat your debate with your two pairs of semi finalists. </b><dd>The winners of these will be your two finalists!</dd></li>\n<b><li>Write your two finalists in the final spaces. </b><dd>Were they the finalists you were expecting?</dd></li>\n<b><li>Let your last debate begin to find out who has won the world cup! </b><dd>Which team was the winner?</dd></li>", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4219, "text": "<h2>Setting up:</h2>\n<ol>\n<li>Choose a category. It can be anything; animals, crisp flavours, story characters...</li>\n<li>Choose eight things from your category to compete in your World Cup. For example, choose eight animals.</li>\n<li>Put the eight things in the eight quarter finalists spaces.</li>\n</ol>\n<br></br>\n<h2>How to play:</h2>\n", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2890, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4188, "text": "<h2>You will need:</h2>\n<ul>\n<li>The World Cup of Everything sheet (or draw your own);</li>\n<li>A pen or pencil to write with.</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2890, "dimensions": null, "editAsHt