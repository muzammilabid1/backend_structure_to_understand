[{"id": 35230028, "text": "<h2>How to Play:</h2>\n<ol>\n<li>Both players write a short sentence on a piece of paper.</li>\n<li>Swap paper so you have the other person’s sentence.</li>\n<li>Roll the and/or/but die  and use that word to extend the sentence you have been given.</li>\n<li>Swap back and read the whole sentence aloud. Which do you prefer? Why?</li>\n<li>Write five sentences!</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35229941, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 51672385, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXTDICE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35229941, "dimensions": null, "editAsHtml": false, "properties": {"height": null, "btnText": null, "diceProperties": [{"width": null, "images": [], "isInfant": true, "inputArray": "and, or, but"}], "longTextFontSize": null}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"te