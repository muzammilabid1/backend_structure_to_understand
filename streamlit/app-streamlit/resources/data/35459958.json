[{"id": 35461808, "text": "<h2>You Will Need:</h2>\nSomething you can use to write really big letters. Here are some ideas:\n<ul>\n<li>Chalks on the ground outdoors</li>\n<li>Felt tips on a newspaper or cardboard box</li>\n<li>Making letters with scarves and other clothes </li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633427995453_1image1-01FH7YA5P721EHC9FVXVTJ96AG.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35459958, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35461853, "text": "<h2>What to Do:</h2>\n<ol>\n<li>Think of lots of different animal noises, e.g. Moo, Baa, Woof etc.</li>\n<li>Write the animal noise words in big letters around your space. Start each one with a capital letter and end with an exclamation mark.</li>\n<li>Once you have written the noises, take it in turns to add speech marks to each noise.</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35459958, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40849293, "text": "Top Tips for Writing Speech Marks", "modal": {"steps": [{"id": 40849254, "text": "<ul>\n<li>At the start, the speech marks look a bit like 66 (without a hole in the middle).</li>\n<li>At the end, the speech marks look a bit like 99 (without a hole in the middle).</li>\n<li>The dot should be the size of a full stop.</li>\n<li>The shape of each speech mark should be like a comma, with a little flick (the first two are like upside-down commas).</li>\n<li>The speech marks should be level with the top of your capital letters.</li>\n<li>Try not to make them too big – they are small like commas and full stops, not big like letters!</li>\n</ul>", "order": 1, "btnType": null, "linkUrl": null, "modalId": 55, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 55, "name": "Top Tips for Writing Speech Marks", "logCreatedAt": "2021-11-09T12:43:03.008777", "logUpdatedAt": "2021-11-09T12:43:03.008777", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "