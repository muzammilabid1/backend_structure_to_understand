[{"id": 142491140, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 52795866, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Setting up:</h2>\n<p>For this activity you need seven each of ten different kinds of objects, e.g.:</p>\n<ul>\n<li>seven building blocks</li>\n<li>seven apples</li>\n<li>seven grapes</li>\n<li>seven dry pasta pieces</li>\n<li>seven dice</li>\n<li>seven crayons</li>\n<li>seven toy cars</li>\n<li>seven...</li>\n</ul>\n<p>Arrange your objects in groups, like in the picture below.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 60795508, "text": "Ten piles of seven household objects: spoons, milk bottle tops, Lego, dice, plastic animals, cars, raisins, pasta, buttons and gemstones.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "seven_things_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "seven_things_image-01FYV4N44R2KRS6864CHM49MPK.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 52795866, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 52796113, "text": "<h2>How to Play:</h2>\n<ol>\n<li>Player 1 chooses a group of objects and a number (0-7), e.g. saying: 'I choose 3 cars.' </li>\n<li>Player 2 says how many are left in that group, e.g. 'There are 4 cars left for me.' </li>\n<li>Player 1 takes their number of the objects.</li>\n<li>Player 2 checks they were correct about the number of objects left in the group and takes these objects.</li>\n<li>Swap over so Player 2 chooses a new group and how many they want (step 1).</li>\n<li>Keep taking turns until all the objects are gone!</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 52795866, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]