[{"id": 43294185, "text": "<h2>The Aim of the Game:</h2>\nTo collect pairs of words which are antonyms (opposites), e.g. hot and cold.\n<br></br>\n<h2>How to Play:</h2>\n<ol>\n<li>Put your counters at the start.</li>\n<li>Take it in turns to roll the die and move around the board.</li>\n<li>Each time you land on a word, make a note of it. </li>\n<li>If you land on an antonym of a word you already have, write it next to that word, and have another turn.</li>\n<li>When both players reach the end, count up your pairs of antonyms. You get one point for each pair. You also get two bonus points for finishing first. The player with the most points wins!</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 43293480, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43294220, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXTDICE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 43