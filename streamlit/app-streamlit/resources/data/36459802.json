dioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633946433321_1image1-01FHQCQRJMVE7JP04DBGAVVX66.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36459802, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36460189, "text": "<h2>Maze drawing tips:</h2>\n<ul>\n<li>Think about whether you want your maze to end at the centre or at the other side from the start.</li>\n<li>Give options of which way to go to make it trickier for the other person to find the way through.</li>\n<li>Add in dead-ends to trick the other person.</li>\n<li>Make sure there is enough space between your lines for them to draw in their route!</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36459802, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 81138110, "text": "Top tip - pencil grip", "modal": {"steps": [{"id": 78079772, "text": "If they find this tricky: pinch the pencil between your thumb and fo