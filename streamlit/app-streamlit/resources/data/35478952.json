[{"id": 35479082, "text": "Read this question ↑ and then talk about it together.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633441579723_1image1-01FH8B8TDQEB6113Q4YY2TK7FH.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35478952, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 39919021, "text": "This conversation is called a discussion. In a discussion, you should:\n<br></br>\n<ul>\n<li>Make sure both people have a chance to talk.</li>\n<li>Listen to what the other person has to say.</li>\n<li>Be polite to each other, including valuing what the other person says (though this doesn’t mean you always have to agree).</li>\n<li>Respond to what the other person says, maybe saying, “I agree because…” or “I disagree because…”</li>\n<li>Build on what the other person says.</li>\n<li>Keep on topic – don’t start talking about something else!</li>\n<li>Explain your opinions with reasons.</li>\n<li>Speak loudly enough for the other person to hear you but not so loudly they don’t want to listen.</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "