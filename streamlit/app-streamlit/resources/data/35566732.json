[{"id": 35566757, "text": " \n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633519287923_1image1-01FHANAZ02NMNQ0KG7T4BR72MP.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35566732, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35567109, "text": "<h2>Points:</h2>\n1 point if you think of one place\n<br>2 points if you think of two places\n<br>3 points if you think of three places\n<br>5 points if you think of four places\n<br>10 points if you think of five or more places\n<br>+1 bonus point for each sentence if you included all the correct punctuation!\n<br></br>\nYou can check your punctuation here: \n", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35566732, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40749766, "text": "Oh no, there’s a tiger! I think it might eat me!", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": 32, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 35566732, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size:32px;font-family:SassoonInfantRg-Regular;\">Oh no, there’s a tiger! I think it might eat me!</span></p>", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40749835, "text": "<h2>What to Do:</h2>\nHow many different places can you put the words ‘Ben said’ into this piece of writing? Write down all the different ways and then count up your points! Remember to include all the punctuation you need, and to make they make sense! ", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 35566732, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40750402, "text": "Answers to Check", "modal": {"steps": [{"id": 40750291, "text": "Adding the reporting clause (<span style=\"color:#F28D00\">Ben said</span>) at the beginning or end of the speech is the simplest way:\n<br></br>\n1. <span style=\"color:#F28D00\">Ben said</span>, “Oh no, there’s a tiger! I think it might eat me!”</li>\n<br>2. “Oh no, there’s a tiger! I think it might eat me!” <span style=\"color:#F28D00\">Ben said</span>.</li>\n<br></br>\nYou can also add the reporting clause into the middle. This is called interrupted speech. You must make sure the bits either side of ‘<span style=\"color:#F28D00\">Ben said</span>’ still make sense on their own. It is easiest to do this at the end of a sentence:\n<br></br>\n3. “Oh no, there’s a tiger!” <span style=\"color:#F28D00\">Ben said</span>, “I think it might eat me!”\n<br></br>\nAnother way to make interrupted speech is to use the reporting clause to split a sentence in two, leaving the main clause separate from any extra bits:\n<br></br>\n4. “Oh no,” <span style=\"color:#F28D00\">Ben said</span>, “There’s a tiger! I think it might eat me!”\n<br>5. “Oh no, there’s a tiger! I think,” <span style=\"color:#F28D00\">Ben said</span>, “It might eat me!”\n<br></br>\n<i>Maybe you also thought of this one. We had to change the punctuation a bit so that it made sense!\n<br></br>\n6. “Oh…” <span style=\"color:#F28D00\">Ben said</span>, “No! There’s a tiger! I think it might eat me!”</I>\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 32, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 32, "name": "Answers to Check", "logCreatedAt": "2021-11-08T16:26:25.844247", "logUpdatedAt": "2021-11-08T16:26:25.844247", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 35566732, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 32, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]