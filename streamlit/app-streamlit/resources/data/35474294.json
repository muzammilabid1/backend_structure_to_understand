[{"id": 40857147, "text": "Check whether you were right", "modal": {"steps": [{"id": 40856940, "text": null, "order": 1, "btnType": null, "linkUrl": null, "modalId": 60, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">a</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">If a word ends with a consonant that is stressed, you should double it before adding ‘ing’.</span><span style=\"font-size: 24px;\"> </span></p>\n<p><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">There was a storm at the begin</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">n</span><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">ing of the story.</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">b</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">The ‘s’ sound in the middle of ‘crescent’ is spelled ‘sc’.</span><span style=\"font-size: 24px;\"> </span></p>\n<p><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">The moon was in a cres</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">c</span><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">ent shape.</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">c</span></p>\n<p><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">Missing apostrophe to show the bowls belong to the two cats.</span><span style=\"font-size: 24px;\"> </span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: windowtext;font-size: 24px;font-family: Sassoon Infant Std;\">“Come here, Tiddles and Charlie!” called Mum as she put food into the cats</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">’</span><span style=\"color: windowtext;font-size: 24px;font-family: Sassoon Infant Std;\"> bowls.</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">d</span></p>\n<p><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">Missing full stop at the end of the sentence. </span><span style=\"font-size: 24px;\"> </span></p>\n<p><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">The lion was angry, fierce and hungry</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">.</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">e</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">The prefix ‘dis-’ has been added to the word ‘agree’ so you only need one ‘s’.</span><span style=\"font-size: 24px;\"> </span></p>\n<p><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">I di</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">s</span><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">agree with you.</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">f</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">Elephant begins with a vowel sound, so it should say ‘an’ not ‘a’ before ‘elephant’. </span><span style=\"font-size: 24px;\"> </span></p>\n<p><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">There’s a</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">n</span><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\"> elephant hiding behind the tree!</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">g</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">Missing apostrophe to show the chair belongs to Daddy Bear.</span><span style=\"font-size: 24px;\"> </span></p>\n<p><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">Goldilocks sat in Daddy Bear</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">’</span><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">s chair.</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">h</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">Missing inverted commas to show where the direct speech is.</span><span style=\"font-size: 24px;\"> </span></p>\n<p><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">“</span><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">Hello! Is there anybody there?</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">”</span><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\"> asked Sam.</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">i</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">Missing comma in the list.</span><span style=\"font-size: 24px;\"> </span></p>\n<p><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">I bought bananas</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">,</span><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\"> apples and pears.</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">j</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">The apostrophe is in the wrong place – the toys belong to the children so the apostrophe should come after the ‘n’.</span><span style=\"font-size: 24px;\"> </span></p>\n<p><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">The children</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">’</span><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">s toys were left out in the rain.</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">k</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">The ‘shun’ sound in ‘invention’ is spelled ‘tion’.</span><span style=\"font-size: 24px;\"> </span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: windowtext;font-size: 24px;font-family: Sassoon Infant Std;\">Her inven</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">tion</span><span style=\"color: windowtext;font-size: 24px;font-family: Sassoon Infant Std;\"> would change the world!</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">l</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">Missing apostrophe to show the letter “i” is missing from “it is”.</span><span style=\"font-size: 24px;\"> </span></p>\n<p><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">It</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">’</span><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">s probably not going to rain tomorrow.</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">m</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">Missing capital letter for her name. </span><span style=\"font-size: 24px;\"> </span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: windowtext;font-size: 24px;font-family: Sassoon Infant Std;\">The trickle of water slowly stopped as </span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">M</span><span style=\"color: windowtext;font-size: 24px;font-family: Sassoon Infant Std;\">aria turned the tap.</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">n</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">There is a question mark at the end of the exclamation where there should actually be an exclamation mark. </span><span style=\"font-size: 24px;\"> </span></p>\n<p><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">Little Red Riding Hood said, “Oh Grandma, what big eyes you have</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">!</span><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">”</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">o</span></p>\n<p><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">Wrong choice of homophone – ‘here’ should be ‘hear’.</span></p>\n<p><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">Can you </span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">hear </span><span style=\"font-size: 24px;font-family: Sassoon Infant Std;\">me?</span><span style=\"font-size: 24px;\"> </span></p>\n<p></p>\n<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">p</span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">There should be a question mark instead of a full stop at the end of this question sentence.</span><span style=\"font-size: 24px;\"> </span></p>\n<p style=\"margin-left:0cm;\"><span style=\"color: windowtext;font-size: 24px;font-family: Sassoon Infant Std;\">Where can I buy a loaf of bread</span><span style=\"color: red;font-size: 24px;font-family: Sassoon Infant Std;\">?</span><span style=\"font-size: 24px;\"> </span></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 60, "name": "Check whether you were right", "logCreatedAt": "2021-11-09T14:35:21.51174", "logUpdatedAt": "2021-11-09T14:35:39.751516", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 35474294, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 60, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35474991, "text": "<h2>Challenge: </h2>\nMake some of your own cards to add to the game. Remember, there must only be one mistake on each card.\n", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35474294, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35474815, "text": "<h2>You Will Need:</h2>\n<ul>\n<li>A pencil and paper to keep track of your score;</li>\n<li>A set cards, cut out.</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633438068810_1image1-01FH87W3AV8RFZQ68V4F7CSB64.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35474294, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35474674, "text": "<h2>The Aim of the Game:</h2>\nEach card has one mistake on it. It might be a spelling mistake, or it might be a punctuation mistake. You need to spot the mistakes and see if you can correct them!\n<br></br>\n<h2>What to Do:</h2>\n<ol>\n<li>Pile the cards in a stack face down.</li>\n<li>Turn over the top card. </li>\n<li>When you spot the mistake, say “Bing!”</li>\n<li>Tell the other person what mistake you spotted and how you would correct it.</li>\n<li>If you’re not sure whether you are right, you can check using the pdf below.</li>\n<li>You get one point for spotting the mistake and a bonus point if you accurately correct it.</li>\n<li>Keep turning over cards one at a time and see if you can spot the mistakes.</li>\n<li>At the end of the game, the person with the most points wins!</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35474294, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35917619, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35474294, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": "1633600849627_1download1-01FHD34SPCVKCRHHVPYN6XGD51.pdf", "editorState": null, "carouselData": null, "downloadName": "Proofreading cards", "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]