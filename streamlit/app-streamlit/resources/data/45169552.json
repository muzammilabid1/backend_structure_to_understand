[{"id": 45169730, "text": "The control panel inside a plane cockpit.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1638800727286_1image1-01FP824ENZVG3T8SXG2KP1K6XX.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45169552, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45169711, "text": "The prefix ‘auto-’ means ‘self’ or ‘own’. For instance, the autopilot on a plane flies the plane by itself, without needing a person to control it. ", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45169552, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45170118, "text": "'Auto-' Words and What They Mean", "modal": {"steps": [{"id": 45170074, "text": "<b>Autobiography:</b> An account of a person’s life written about themself.\n<br><b>Autocrat:</b> A ruler who has unlimited power.\n<br><b>Autocue:</b> A device that shows scrolling text for a person on TV to read while looking at the camera.\n<br><b>Autograph:</b> A signature, often by a celebrity, usually written for a fan.\n<br><b>Autonomous:</b> Being free to control itself and make its own decisions.\n<br><b>Automatic:</b> Something that happens by itself without needing human control.\n<br><b>Automaton:</b> An old-fashioned word for a robot.\n<br><b>Automobile:</b> A car (which can move itself instead of being pulled by a horse).\n<br><b>Autopilot:</b> A device for steering a plane or ship without the human pilot needing to steer.\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 133, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 133, "name": "'Auto-' Words and What They Mean", "logCreatedAt": "2021-12-06T14:29:25.687055", "logUpdatedAt": "2021-12-06T14:29:25.687055", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45169552, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 133, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45169881, "text": "<h2>Warmup:</h2>\nLook through the ‘auto-’ cards and match the words to what they mean.\n<br></br>\n<h2>Autopilot Memory Game:</h2>\n<ol>\n<li>Spread the cards out on the table face down.</li>\n<li>Take it in turns to flip over two cards. </li>\n<li>If your cards are a matching word and its meaning, keep them and have another go. If they aren’t a matching pair, flip them back over and the other person has a turn.</li>\n<li>At the end of the game, the winner is the person who collected the most cards.</li>\n</ol>\n<br></br>\n<h2>Need Help?</h2>\nHere are the words and what they mean:\n", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45169552, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray":