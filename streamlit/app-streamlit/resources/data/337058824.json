[{"id": 337062825, "text": "How to convert miles to kilometers", "modal": {"steps": [{"id": 337062567, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 318, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>There are different ways to convert miles to kilometres.</p>\n<p></p>\n<h2>1. Using a formula</h2>\n<p>We know 1 mile is approximately 1.6km</p>\n<p>So multiply the number of miles by 1.6 to give the number of km.</p>\n<p>For example:  6 miles is 6 x 1.6 = 9.6km</p>\n<p></p>\n<p>We also know that 1km is approximately 0.6 miles.</p>\n<p>So multiply the number of kilometers by 0.6</p>\n<p>For example: 5 km x 0.6 = 3 miles.</p>\n<h2>2. Using key facts</h2>\n<p>You can use the key fact that 5 miles is approximately 8km.</p>\n<p>So 10 miles is approximately 16 km.&nbsp;&nbsp;</p>\n<p>20 miles is 32 km</p>\n<p>100 miles is 160 km etc . .</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "-gGWnzBBW3pE-xwxnYdrR", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 318, "name": "Converting miles to km", "logCreatedAt": "2024-05-29T12:34:26.407787", "logUpdatedAt": "2024-05-29T12:34:26.407787", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": "Y6 Miles to Kilometers conversion reminder"}}