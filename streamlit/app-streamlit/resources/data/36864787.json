[{"id": 36864799, "text": "Have a go at performing a poem. You can choose your own or use the one by clicking the button below.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1636456055314_1image1-01FM262DGWME88KASKKCY77HCD.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36864787, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36876619, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36864787, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": "1634131881300_1download1-01FHWXHY67H3E05TDNEMCNRRKN.pdf", "editorState": null, "carouselData": null, "downloadName": "The Owl and the Pussycat", "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36876898, "text": "<h2>What to Do:</h2>\n<ol>\n<li>Read the poem aloud and talk together about what is happening. It’s much easier to perform if you know what is going on!</li>\n<li>Read it aloud some more times, thinking about making the words flow (this is called being ‘fluent’).</li>\n<li>When you are reading, think about how to make the poem interesting to listen to: \n<ul>\n<li>Can you do different voices for different characters?</li>\n<li>Might different parts need to be louder or quieter? </li>\n<li>Anything else? You decide!</li>\n</ul></li>\n<li>When you’ve finished practising, perform your poem. You could perform to someone in your house, on a video call to family somewhere else, or record your performance.</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36864787, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]