[{"id": 120891894, "text": "763702720", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2887, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4221, "text": "<h2>How to play:</h2>\n<ol>\n<li>Choose a character each from a story. You could be from the same story or different stories, either is fun (though the same story is easier to start with).</li>\n<li>Dress up as your characters (dressing up clothes ideas below).</li>\n<li>Play together as your characters. This could be:\n      <ul>\n      <li>Acting out part of the story together;</li>\n      <li>Pretend to go on an adventure together in the garden;</li>\n      <li>Build a den together;</li>\n      <li>Have a pretend tea party;</li>\n      <li>Do an ordinary household activity but as your characters, e.g. setting the table for dinner.</li>\n      </ul>\n      </li>\n</ol>\n<br></br>\nLet your child take the lead and see where they take you!\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2887, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43136315, "text": "Dressing up clothes ideas", "modal": {"steps": [{"id": 43136275, "text": "Box filled with dressing up clothes", "order": 2, "btnType": null, "linkUrl": null, "modalId": 83, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1637660789959_1image1-01FN62ZNEZ6QD6C362DJ3ESY0X.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43135920, "text": "Some people will already have a dressing up box, but if you don't, don't worry! It is possible to make a really fun dressing up box from things you already have in the house. Here are some ideas:\n<br></br>\n<ul>\n<li>Scarves</li>\n<li>Hats</li>\n<li>An old pair of shoes</li>\n<li>An old bag</li>\n<li>A big t-shirt</li>\n<li>A belt or ribbon</li>\n<li>Necklaces</li>\n<li>An old net curtain</li>\n<li>Sunglasses</li>\n</ul>\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 83, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43135967, "text": "It can actually be better if you don't have any specific character \"outfits\" because then it is easier to imagine being anything you choose!", "order": 3, "btnType": null, "linkUrl": null, "modalId": 83, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 83, "name": "Dressing Up Clothes Ideas", "logCreatedAt": "2021-11-23T09:41:13.863494", "logUpdatedAt": "2021-11-23T09:41:13.863494", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "orde