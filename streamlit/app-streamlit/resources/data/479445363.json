[{"id": 479445567, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 479445363, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "4m1o_eU0t_0O1zt_6djZm", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather be able to breathe under water or breathe in space?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "Rlno3BpnwZ1N2oqrwAL89", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather have the ability to see ten minutes into the future or 150 years into the future?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "_DMllCmml-lwdfw8rcqJy", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather go into the past and meet your ancestors or go into the future and meet your great great grandchildren?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "DoknmgvA4l_uKl22xx4AK", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather have x-ray vision or magnified hearing?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "cY7Q61e28hDqdppw9J-h3", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather lose the ability to read or lose the ability to speak?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "UjzEenpCT9WkU5lTI93i2", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather be covered in fur or covered in scales?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "cAF__ONsk3ysqq1Oa6BlX", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather know the history of every object you touched or be able to talk to animals?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "fdd4nij_xmaBseNvR_umU", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather give up all drinks except for water or give up eating anything that was cooked in an oven?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "UgdkPsk_HKqduE5y5jb9w", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather have unlimited international first-class tickets or never have to pay for food at restaurants?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "-cyn_GMNxcXnrZT9FL0EE", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather eat chocolate at every meal or never eat chocolate again?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "c7VBGTnQ6S0Lb_GadpC-X", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather be forced to dance every time you heard music or be forced to sing along to any song you heard?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "slYSlRBrYuztq4KA8J7cF", "textEditorState": "<p><span style=\"font-size: 18px;font-family: SassoonInfantRg-Regular;\">Would you rather have whatever you are thinking appear above your head for everyone to see or have absolutely everything you do livestreamed for anyone to see?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "fLRshTzxhyTDK_snuJlLi", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather be a reverse centaur or a reverse mermaid/merman?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "RagYPN9dV3LZkgFiTG0Su", "textEditorState": "<p><span style=\"font-size: 18px;font-family: SassoonInfantRg-Regular;\">Would you rather eat a sandwich made from four ingredients in your fridge chosen at random or eat a sandwich made by a group of your friends from four ingredients in your fridge?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "Wqt-eHA4C0i4b7psIiRT3", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">Would you rather be able to teleport or be able to read minds?</span></p>\n", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "Kf09ifpTPrRbD29wMCJep", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479445531, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 479445363, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<p>Choose one of the questions below and discuss it together.</p>\n<ul>\n<li style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">There is no \"right\" answer to these questions, so your discussion should last several minutes, as you try to work out what you think, explain your reasons, and work out what might make you choose the other option. </span></li>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Both people should share their ideas! </span></li>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Try to challenge the other person’s thinking by asking questions – questions that start, “But what if…” can be really good!</span></li>\n</ul>\n<p>When you have finished, you could discuss another question or make up one of your own!<br>&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "HqxBDnpbdH7c4g-Sj8Wpr", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]