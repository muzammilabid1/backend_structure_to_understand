[{"id": 3171, "text": "<h2>You Will Need:</h2>\n<ul>\n<li>Seven small toys, e.g. teddies, cars, pieces of pasta...</li>\n<li>A pillowcase or bag (not see-though)</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2310, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 60921472, "text": "Teddies spilling out of a pillowcase.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "teddies_in_a_pillowcase_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "teddies_in_a_pillowcase_image-01FYXMR5HW0PEEJ8FG04JN301D.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2310, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 3172, "text": "<h2>How to Play:</h2>\n<ol>\n<li>Ask your child to count the toys. </li>\n<li>Then, ask them to close their eyes. Hide some of the toys in the bag. </li>\n<li>When your child opens their eyes, ask them to count the number of toys they can see now.</li>\n<li>Then, ask them: How are you going to work out how many toys are in the bag?\n<ul>\n<li>I could look in the bag and count them.</li>\n<li>I could would work it out by...</li>\n<li>I know some pairs of numbers that make seven, e.g. five and two make seven - I can see five, so there must be two in the bag.</li>\n</ul></li>\n</ol>\n<br>\nRepeat the activity, hiding a different number of toys each time. Try to practise ways of working out what's hidden without looking in the bag!\n<br></br>\n<h2>Challenge:</h2>\nSwap roles with your child and play again. Try pretending to get an answer wrong to see if your child notices <i>and</i> can correct you!", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2310, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]