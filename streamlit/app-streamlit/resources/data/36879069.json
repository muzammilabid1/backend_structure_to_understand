[{"id": 36879816, "text": "<h2>Setting Up:</h2>\n<ol>\n<li>Decide what story you are going to tell. It could be a story you know or one you are making up. But the inside of the box needs to match your story!</li>\n<li>Make sure your box has a hole at the front. A shoe box comes like this, but you might need to cut a hole in the side of a cereal box.</li>\n<li>Decorate the box. You can draw or stick things on the back, on the bottom and hanging down the front!</li>\n<li>Put your characters into your box.</li>\n</ol>\n<br><br>\n<h2>Practise:</h2>\nPractise moving the characters around and saying words to tell the story. You might want to use your own voice as the narrator as well as making the characters speak. \n<br><br>\n<h2>Perform:</h2>\nWhen you have finished practising, find an audience to perform to. It could be someone in your house or you could even set up an audience of teddies to perform to!", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36879069, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36879090, "text": "<h2>You Will Need:</h2>\n<ul>\n<li>A shoe box (or other similar sized box, e.g. a cereal box)</li>\n<li>Things to decorate the inside with. You could use:</li>\n<ul>\n<li>Old wrapping paper</li>\n<li>Food packaging</li>\n<li>Stickers</li>\n<li>Toys</li>\n<li>Things from the garden or park</li>\n<li>Colouring pens and pencils</li>\n</ul>\n<li>Characters for your play – they could be mini figures or cut out of card.</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1634134912575_1image1-01FHX0FMR2JM37Y7SNZPDEX1NK.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36879069, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 117138927, "text": "Scissor Safety", "modal": {"steps": [{"id": 78150509, "text": "Children learn to use children’s scissors safely in school. Please supervise children carefully when using scissors, or cut things yourself if scissors are large and sharp.<br></br>\n", "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 181, "audioUrl": null, "fileName": "scissors", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "scissors-pcfvsblU9BxRhQPWMboVZ.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 78150516, "text": "Talk to them about:<br></br>\n- Always using the handles properly when using scissors<br></br>\n- Always cutting away from yourself and others. <br></br>\n- Never running with scissors. <br></br>\n- Put scissors down when not in use. <br></br>\n- If you walk with scissors, hold them with the blade down. <br></br>\n", "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 181, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 181, "name": "Scissor Safety", "logCreatedAt": "2022-08-10T11:19:41.465622", "logUpdatedAt": "2022-08-10T11:19:41.465622", "logCreatedById": 77349474, "logUpdatedById": 77349474, "nameForContentDev": null}}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 36879069, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById":