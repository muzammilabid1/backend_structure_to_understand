[{"id": 35236873, "text": "<h2>How to Play:</h2>\n<ol>\n<li>Decide who is being Simon. Simon will give the instructions; Player 2 will follow them.</li>\n<li>Simon says an instruction.</li>\n<li>Player 2 listens carefully and decides whether to follow it.</li>\n<li>Simon keeps giving instructions and Player 2 follows until Simon catches Player 2 out. This happens if Player 2 follows and instruction that did not start ‘Simon says’.</li>\n<li>When Player 2 has been caught out, swap over so the other person can have a go at being Simon.</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35236411, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35236570, "text": "In the game ‘Simon Says’, there are two kinds of instructions:\n<ul>\n<li>Instructions that begin ‘Simon says’.</li>\n<li>Instructions that <b>do not</b> begin ‘Simon says’.</li>\n</ul>\n<br></br>\nThe person following the instructions must listen carefully: \n<ul>\n<li>If the instruction begins ‘Simon says,’ they should follow it.</li>\n<li>If the instruction <b>does not</b> begin ‘Simon says,’ they <b>should not</b> follow it.</li>\n</ul>\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633359132721_1image1-01FH5WHV16X3ZYGC5K6XQWZPZD.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35236411, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40848297, "text": "Simon Says Example Game", "modal": {"steps": [{"id": 40848250, "text": "Simon: Simon says jump up and down.\n<br><span style=\"color:#F28D00\"><i>Player 2 jumps up and down.</i></span>\n<br>Simon: Simon says clap hands.\n<br><span style=\"color:#F28D00\"><i>Player 2 claps hands.</i></span>\n<br>Simon: Sing a song.\n<br><span style=\"color:#F28D00\"><i>Player 2 does not sing a song (well done for spotting the trick).</i></span>\n<br>Simon: Simon says whistle.\n<br><span style=\"color:#F28D00\"><i>Player 2 whistles.</i></span>\n<br>Simon: Run round the room backwards.\n<br><span style=\"color:#F28D00\"><i>Player 2 runs round the room backwards.</i></span>\n<br>Simon: You’re out! I didn’t’ say ‘Simon says!’\n<br><span style=\"color:#F28D00\"><i>Players swap over so the other person can have a go at being Simon.</i></span>\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 53, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 53, "name": "Simon Says Example Game", "logCreatedAt": "2021-11-09T12:28:56.968188", "logUpdatedAt": "2021-11-09T12:28:56.968188", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 3, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 35236411, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 53, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]