ull, "editorState": "<h2>Then:</h2>\n<ul>\n<li>Before you roll again, guess if the total will be higher, the same or lower.</li>\n<li>Roll the two dice and add them.</li>\n<li>If your higher/lower guess was right, keep going.</li>\n<li>If not, it is the other player's turn.</li>\n<li>The player who gets the most correct guesses in a turn wins.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "-dCzvxrZXURruw02B3npX", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 415428616, "text": null, "modal": {"steps": [null], "details": null}, "order": 7, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 866, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Extra Challenge:</h2>\n<ul>\n<li>Play the same game with bigger numbers.</li>\n<li>The dice below go up to 12</li>\n<li>You will need a numberline to 24.</li>\n<li>Encourage your child to start with the larger number and count up.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "UHFmzF0XLVJBmSzfRnrf_", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAl