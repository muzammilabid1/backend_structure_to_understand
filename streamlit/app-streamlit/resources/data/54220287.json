[{"id": 76293591, "text": null, "modal": {"steps": [null], "details": null}, "order": 7, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54220287, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\"><strong>Remember:</strong></span></p>\n<p style=\"text-align:start;\"><span style=\"color: rgb(251,160,38);\">I</span><span style=\"color: rgb(0,0,0);\"> is used when you are the </span><span style=\"color: rgb(251,160,38);\">subject </span><span style=\"color: rgb(0,0,0);\">of a sentence - when you are doing the </span><span style=\"color: rgb(61,142,185);\">verb</span><span style=\"color: rgb(0,0,0);\">.</span></p>\n<p><span style=\"color: rgb(0,0,0);\">e.g. </span><span style=\"color: rgb(251,160,38);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">I</span> <span style=\"color: rgb(61,142,185);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">won</span><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\"> the race.</span></p>\n<p style=\"text-align:start;\"></p>\n<p><span style=\"color: rgb(251,160,38);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Me</span><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\"> is used when you are the </span><span style=\"color: rgb(251,160,38);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">object </span><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">of a sentence - when something else is doing the </span><span style=\"color: rgb(61,142,185);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">verb</span><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\"> to you.</span></p>\n<p style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">e.g. The giant </span><span style=\"color: rgb(61,142,185);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">lifted</span> <span style=\"color: rgb(251,160,38);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">me </span><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">high into the air.</span><br>&nbsp;</p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 76287410, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54220287, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{