[{"id": 478528786, "text": "In this game, one player chooses the title of a book, film, TV programme, song or play and acts out clues for the other player(s) to guess what it is. They are not allowed to speak – all clues must be mimed!\n<br><br>\n<h2>How to play:</h2>\n<ol>\n<li>Choose a book, film, TV programme, song or play.</li>\n<li>Mime the action to show which types of thing they have chosen (palms of hands together opening and shutting for a book, holding up an old-fashioned film camera and cranking the handle for a film, drawing a rectangle in the air for a TV programme, holding a microphone for a song, and drawing theatre curtains in the air for a play).</li>\n<li>Hold up fingers to show the number of words in the title.</li>\n<li>Mime clues for the other player(s) to guess what it is.</li>\n<li>When someone correctly guesses the whole thing, tap your nose to show that they are right. Then it is their turn to choose something to act out!</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633438431929_1image1-01FH888MYX2BBKV6XB9AKBP9PH.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 478528749, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 478528801, "text": "Click the link below to see some different ways of miming clues.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType":