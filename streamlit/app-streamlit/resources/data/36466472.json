[{"id": 381633476, "text": "991515103", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 36466472, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "NlrsZ9oRoH58vma7v1hGw", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36466638, "text": "<h2>How to Play:</h2>\n<ul>\n<li>Pick a phoneme that could be at the start of a word, e.g. 'ch'.</li>\n<li>Say \"Find something beginning with…\" and say your phoneme, .e.g \"Find something beginning with 'ch'\".</li>\n<li>The other player must find an object beginning with that phoneme, e.g. 'chair'.</li>\n<li>If they can’t find anything, you can help them! </li>\n<li>Take it in turns to give the clue.</li>\n</ul>\n<br></br>\n<h2>What is a Phoneme?</h2>\nA phoneme is one of the sounds that makes up a word, e.g. the word 'chip' has three phonemes: 'ch', 'i' and 'p'.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36466472, "dimensions": null, "editAsHtml