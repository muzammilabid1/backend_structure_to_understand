[{"id": 56515013, "text": "<center>\nThe <span style=\"color:#F28D00\">owl</span> is <b>eating</b> the <span style=\"color:#F28D00\">mouse</span>.\n<br>↓<br>\nThe <span style=\"color:#F28D00\">mouse</span> is <b>eating</b> the <span style=\"color:#F28D00\">grasshopper</span>.\n<br>↓<br>\nThe <span style=\"color:#F28D00\">grasshopper</span> is <b>eating</b> the <span style=\"color:#F28D00\">strawberry plant</span>.\n</center>", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": 24, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54209736, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size:24px;font-family:SassoonInfantRg-Regular;\"><center>\nThe <span style=\"color:#F28D00\">owl</span> is <b>eating</b> the <span style=\"color:#F28D00\">mouse</span>.\n<br>↓<br>\nThe <span style=\"color:#F28D00\">mouse</span> is <b>eating</b> the <span style=\"color:#F28D00\">grasshopper</span>.\n<br>↓<br>\nThe <span style=\"color:#F28D00\">grasshopper</span> is <b>eating</b> the <span style=\"color:#F28D00\">strawberry plant</span>.\n</center></span></p>", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 56514584, "text": "A food chain shows what a set of animals eats. \n<br></br>\nIn the picture below, there is an owl at the top of the food chain. It is at the top because nothing eats owls. Each animal eats the thing below it in the chain.\n<br></br>\nIn this activity, you will use your own food chain to help think about the word '<b>eating</b>' and other words that end '<b>ing</b>'.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54209736, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 56514902, "text": "<h2>Challenge:</h2>\nTry different words instead of 'eating' e.g. 'devouring' or 'consuming'!", "modal": {"steps": [null], "details": null}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54209736, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextDat