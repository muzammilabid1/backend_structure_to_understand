[{"id": 690, "text": "You will need an analogue clock. If you don't have one at home, you can change the clock on your mobile phone to be an analogue clock.<br /><br />Write a plan of fun things that you are going to do for the rest of the day. Include all of the times to the nearest 5 minutes. Include times that you can say in more than one way, such as \"15 minutes to 6\".<br /><br />Check your clock so that you don't miss any of the fun things planned!", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 527, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 224119672, "text": "Teaching your child to tell the time", "modal": {"steps": [{"id": 224119427, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 284, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Learning to tell the time is tricky.</p>\n<p>Children need lots of practice and lots of repetition.</p>\n<p>Parents are the ideal people to help children learn as they are with children through more times of the day.</p>\n<ul>\n<li>Use the time when you are talking to your children. For example 'we'll have tea at 6 o'clock' or 'You can play on the computer until half past five then its time to stop'.&nbsp;</li>\n<li>Point out the time as part of your routine - Its 7 o'clock. Its bedtime' or 'Its half past eight, we need to get going'.</li>\n<li>Practice reading the time on different clocks you see out and about.</li>\n<li>Work up slowly - start with o'clock times, then half past, then the quarter hour.</li>\n<li>Use analogue clocks until children are confident, then start to talk about digital time too.</li>\n</ul>\n<p><strong>Top Tip:</strong> If you don't have an analogue clock at home, you can change the clock on your mobile phone to analogue.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 284, "name": "Telling the time", "logCreatedAt": "2023-12-11T15:54:31.689342", "logUpdatedAt": "2023-12-11T15:54:31.689342", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": null}}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 527, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedMod