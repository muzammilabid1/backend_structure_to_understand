[{"id": 74495482, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74495002, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Build a campfire - you could make a pretend one from sticks you've found in the park!</li>\n<li>Get a campfire snack - maybe a hot chocolate or a biscuit!</li>\n<li>Take it in turns to tell stories!</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74495811, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74495002, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What stories should we tell?</h2>\n<p>You can tell any stories you like - it could be:</p>\n<ul>\n<li>A story you have heard before;</li>\n<li>A new story using parts of other stories you know;</li>\n<li>A totally made-up story.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 117137962, "text": "Campfire Safety", "modal": {"steps": [{"id": 117137897, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 217, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>If you do make a real fire, an adult should supervise children at all times.</p>\n<p>Talk to children about fire safety before you start.</p>\n<ul>\n<li><span style=\"color: rgb(64,64,64);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">Keep a bucket of water to hand.</span></li>\n<li><span style=\"color: rgb(64,64,64);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">Only use as much wood as you need – don’t build the fire too big.</span></li>\n<li><span style=\"color: rgb(64,64,64);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">Never use flammable liquids to light your fire.</span></li>\n<li><span style=\"color: rgb(64,64,64);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">Keep the area around the fire clear.</span></li>\n<li><span style=\"color: rgb(64,64,64);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">Keep matches and lighters away from young children.</span></li>\n<li><span style=\"color: rgb(64,64,64);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">Tie long hair back and take off scarves</span></li>\n<li><span style=\"color: rgb(64,64,64);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">Make sure the fire is put completely out when you have finished.</span></li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 217, "name": "Campfire Safety", "logCreatedAt": "2023-06-20T13:20:38.052417", "logUpdatedAt": "2023-06-20T13:20:38.052417", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": null}}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74495002, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 217, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74495703, "text": "A campfire.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "campfire", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "campfire-Erh7kK--HxIJXGDLB