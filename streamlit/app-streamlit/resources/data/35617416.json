[{"id": 35617444, "text": "You can print the text using the link below:\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35617416, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40835941, "text": "Solution", "modal": {"steps": [{"id": 40835865, "text": null, "order": 1, "btnType": null, "linkUrl": null, "modalId": 42, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size: 18pt;font-family: Sassoon Infant Std\", sans-serif;\"><em>Here are the ten missing hyphens!</em></span><em> </em></p>\n<p>&nbsp;&nbsp;</p>\n<p><span style=\"font-size: 24px;font-family: Sassoon Infant Rg;\">It was the </span><span style=\"color: rgb(237,125,49);font-size: 24px;font-family: Sassoon Infant Rg;\">twenty-first </span><span style=\"font-size: 24px;font-family: Sassoon Infant Rg;\">of November, and I was taking my </span><span style=\"color: rgb(237,125,49);font-size: 24px;font-family: Sassoon Infant Rg;\">well-behaved </span><span style=\"font-size: 24px;font-family: Sassoon Infant Rg;\">dog for a walk on the common, when I heard a terrible commotion. Two </span><span style=\"color: rgb(237,125,49);font-size: 24px;font-family: Sassoon Infant Rg;\">hundred-odd </span><span style=\"font-size: 24px;font-family: Sassoon Infant Rg;\">council workers marched past, waving placards, and I wondered what it was all about. I stopped a </span><span style=\"color: rgb(237,125,49);font-size: 24px;font-family: Sassoon Infant Rg;\">six-foot-tall </span><span style=\"font-size: 24px;font-family: Sassoon Infant Rg;\">man in a </span><span style=\"color: rgb(237,125,49);font-size: 24px;font-family: Sassoon Infant Rg;\">bright-red </span><span style=\"font-size: 24px;font-family: Sassoon Infant Rg;\">coat to ask what was going on. He told me they had all signed a petition asking the council to deal with the </span><span style=\"color: rgb(237,125,49);font-size: 24px;font-family: Sassoon Infant Rg;\">well-known </span><span style=\"font-size: 24px;font-family: Sassoon Infant Rg;\">problem of the dangerous </span><span style=\"color: rgb(237,125,49);font-size: 24px;font-family: Sassoon Infant Rg;\">hair-remover</span><span style=\"font-size: 24px;font-family: Sassoon Infant Rg;\">. They were calling for the council to </span><span style=\"color: rgb(237,125,49);font-size: 24px;font-family: Sassoon Infant Rg;\">co-operate </span><span style=\"font-size: 24px;font-family: Sassoon Infant Rg;\">to help come up with a solution. Apparently, things had come to a head because the council had been completely inefficient, lost the petition and made everyone </span><span style=\"color: rgb(237,125,49);font-size: 24px;font-family: Sassoon Infant Rg;\">re-sign</span><span style=\"font-size: 24px;font-family: Sassoon Infant Rg;\">. I could see why they were all angry!</span><span style=\"font-size: 24px;\"> </span><span style=\"font-size: 18px;\"> </span></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 42, "name": "Solution", "logCreatedAt": "2021-11-09T10:42:00.598374", "logUpdatedAt": "2021-11-09T10:42:00.598374", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 35617416, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 42, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35919710, "text": "Click the button below when you have finished to compare your work to our ideas:", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35617416, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "sele