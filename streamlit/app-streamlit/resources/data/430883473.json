[{"id": 430883737, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 430883473, "dimensions": null, "editAsHtml": true, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Player 1 chooses a letter of the alphabet. Player 2 is going to try to work out what it is.</li>\n<li>Player 1 asks a question that has a one-word answer.</li>\n<li>Player 2 answers the question with one word.</li>\n<li>Player 1 says \"good\" or \"bad\":</li>\n<ul>\n<li><strong>Good</strong>: the one-word answer contains the letter.</li>\n<li><strong>Bad</strong>: the one-word answer does not contain the letter.</li>\n</ul>\n<li>Player 2 uses this information to help rule out letters.</li>\n<li>Keep asking and answering questions until Player 2 is ready to guess the letter. If they guess correctly, they win. If they don’t, Player 1 wins.</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "Z3Dc6MKgNBDh_rJcJw78K", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 430884215, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 430883473, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Example game:</h2>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "6VaHCRJrDLWpM53ZS029k", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 430884413, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 430883473, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": "A letter 'e' in a thought bubble.", "type": "IMAGE", "fileName": "Thought bubble with letter 'e'", "imageUrl": "Thought bubble with letter 'e'-LLJ-Z_aGssYhQm2EppUAr.png", "fileIdentifier": "LLJ-Z_aGssYhQm2EppUAr", "textEditorState": null, "labelEditorState": "<p style=\"text-align:left;\"><span style=\"color: rgb(243,121,52);\">Player 1 thinks of the letter 'e'.</span></p>\n"}, {"alt": "'Socks' is written under the alphabet, with a little cross under each letter. All the letters in 'socks' are crossed out in the alphabet above.", "type": "IMAGE", "fileName": "socks blob", "imageUrl": "1727950834169_socks blob-pRD9zmBXSYmTVEIhvdedl.png", "fileIdentifier": "pRD9zmBXSYmTVEIhvdedl", "textEditorState": null, "labelEditorState": "<p style=\"text-align:left;\"><span style=\"color: rgb(243,121,52);\">Player 1: What did Grandma give you for your birthday?</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(41,105,176);\">Player 2: Socks.</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(243,121,52);\">Player 1: Bad (there was no 'e' in the answer).</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(41,105,176);\"><em>Player 2 crosses off all the letters in 'socks'.</em></span></p>\n"}, {"alt": "'Wales' is written below 'socks', with a little cross under 's' but dots under the other letters. All the letters apart from 'w', 'a', 'l' and 'e' are now crossed out in the alphabet above.", "type": "IMAGE", "fileName": "Wales blob", "imageUrl": "1727951104519_Wales blob-6I6H_kcPq4L5u9ebgRDv3.png", "fileIdentifier": "6I6H_kcPq4L5u9ebgRDv3", "textEditorState": null, "labelEditorState": "<p style=\"text-align:left;\"><span style=\"color: rgb(243,121,52);\">Player 1: Where did you go on holiday?</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(41,105,176);\">Player 2: Wales.</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(243,121,52);\">Player 1: Good (there was an 'e' in the answer).</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(41,105,176);\"><em>Player 2 crosses off all the letters which aren't in 'Wales'. Now they know it must be 'w', 'a', 'l' or 'e'.</em></span></p>\n"}, {"alt": "'Two' is written below 'Wales', with a little cross under all the letters. 'W' is now also crossed out in the alphabet above.", "type": "IMAGE", "fileName": "two blob", "imageUrl": "1727951263066_two blob-KYsuZYaydWwx65rvCrdVf.png", "fileIdentifier": "KYsuZYaydWwx65rvCrdVf", "textEditorState": null, "labelEditorState": "<p style=\"text-align:left;\"><span style=\"color: rgb(243,121,52);\">Player 1: How many legs do you have?</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(41,105,176);\">Player 2: Two.</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(243,121,52);\">Player 1: Bad (there was no 'e' in the answer).</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(41,105,176);\"><em>Player 2 crosses off 'w' (the only letter in 'Wales' they didn't know about yet). Now they know it must be 'a', 'e' or 'l'.</em></span></p>\n"}, {"alt": "'Cheese' is written below 'two', with a little cross under 'c', 'h' and 's' (which were already ruled out). 'E' is now circled in the alphabet above.", "type": "IMAGE", "fileName": "cheese blob", "imageUrl": "1727951420854_cheese blob-NeSTSR15eM4xAkKrAceHG.png", "fileIdentifier": "NeSTSR15eM4xAkKrAceHG", "textEditorState": null, "labelEditorState": "<p style=\"text-align:left;\"><span style=\"color: rgb(243,121,52);\">Player 1: What is your favourite food?</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(41,105,176);\">Player 2: Cheese.</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(243,121,52);\">Player 1: Good (there was an 'e' in the answer).</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(41,105,176);\"><em>Player 2 crosses off 'c', 'h' and 's' because these were already ruled out. The only letter left is 'e' so they circle it in the alphabet above.</em></span></p>\n"}, {"alt": "There is a speech bubble with the letter 'e' in it.", "type": "IMAGE", "fileName": "Speech bubble with 'e'", "imageUrl": "1727951594777_Speech bubble with 'e'-e7cCWecRTcJD43u-zAHXj.png", "fileIdentifier": "e7cCWecRTcJD43u-zAHXj", "textEditorState": null, "labelEditorState": "<p style=\"text-align:left;\"><span style=\"color: rgb(41,105,176);\">Player 2: I think the letter is 'e'.</span></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(243,121,52);\">Player 1: You've won!</span></p>\n"}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "j_vmk3ba3eOI8aZewwSTZ", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 430885431, "text": null, "modal": {"steps": [null], "details": null}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 430883473, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><strong>Tactics:</strong></p>\n<p>Player 2 can think about the answers they say to help rule out letters - if your answer only contains letters you have already ruled-out, you won't get any new information.</p>\n<p>Player 1 can ask questions that stop Player 2 getting any new information.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "HmW9gRzcvuoTcKOgEstHN", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 430883522, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": 