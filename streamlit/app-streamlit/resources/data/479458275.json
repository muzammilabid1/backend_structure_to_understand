[{"id": 479458297, "text": "<h2>The Activity</h2>\nPretend to be two TV chefs while cooking at home!", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "cooking koalas-EdGVQO9BICyO6blM6gRJn.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 479458275, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479458310, "text": "Your names: Shady and Cool (or you can make up your own names).\n<br>\nYour TV show: Shady and Cool in the Kitchen\n<br>\nYour mission: Cook a meal while staying in character.\n<br><br>\n<h2>Tips:</h2>\n<ul>\n<li>You could talk in a different voice.</li>\n<li>You could make up a theme tune.</li>\n<li>Talk about what you are doing, as if there was a camera filming you.</li>\n<li>Talk about what the other person is doing, a bit like a narrator.</li>\n<li>Be a little bit silly with the words you use, e.g. “a dash of this” or “a good sprinkle of that”.</li>", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 479458275, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]