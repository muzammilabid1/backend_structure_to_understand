[{"id": 137407895, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 137405298, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<ul>\n<li>Take it in turns to jump along the line, saying the numbers aloud.</li>\n<li>Do this forward and backward a few times.</li>\n<li>Then add an extra action for the multiples of 8 - like a clap.</li>\n</ul>\n<h2>Extra challenge</h2>\n<ul>\n<li>Turn over one number. Can you remember it as you count?</li>\n<li>Turn over another number . . then another . .</li>\n</ul>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 137408254, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 137405298, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2 style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-family: Chaloops-Medium;\">Getting ready:</span></h2>\n<ul>\n<li style=\"text-align:left;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Write the multiples of 4 on separate pieces of paper.</span></li>\n</ul>\n<p style=\"text-align:center;\">&nbsp;<span style=\"color: rgb(84,172,210);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\"><strong> 4, 8, 12, 16, 20, 24, 28, 32, 36, 40</strong></span></p>\n<ul>\n<li style=\"text-align:left;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Put the numbers in a line, in order, on the floor or outside.</span></li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 138381290, "text": "4 pieces of paper across a floor each with one number written on - 4,8,12 and 16.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Year 4 Counting in multiples of 4 and 8 Jumping 4s", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Year 4 Counting in multiples of 4 and 8 Jumping 4s-StF7gknevZ4JCB_np69gG.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 137405298, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 137408276, "text": "How to play if you can't jump around", "modal": {"steps": [{"id": 137408106, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 241, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>If jumping around is difficult . .</p>\n<p></p>\n<ul>\n<li>write the numbers on small pieces of paper and place them on a table.</li>\n<li>tap each number and say it aloud</li>\n<li>slowly remove the numbers and just tap the space, saying the number.</li>\n<li>try using different voices for 4s and 8s, for example whispering the 4s, shouting the 8s.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 241, "name": "How to play if you can't jump around", "logCreatedAt": "2023-09-12T11:09:59.232542", "logUpdatedAt": "2023-09-12T11:17:29.787828", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": null}}, "order": 4, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt":