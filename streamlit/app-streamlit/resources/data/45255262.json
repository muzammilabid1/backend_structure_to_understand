[{"id": 45255886, "text": "Example Transformed Sentences", "modal": {"steps": [{"id": 45255775, "text": "<h2>Example 1:</h2>\n<ol>\n<li>I like cake.</li>\n<li>That’s a statement sentence because it tells us a fact.</li>\n<li>I need to turn my sentence into a question sentence, a command sentence and an exclamation sentence.\n<ul>\n<li>Question: Do you like cake?</li>\n<li>Command: Cut the cake.</li>\n<li>Exclamation: What an amazing cake that was!</li>\n</ul>\n</li>\n</ol>\n<br></br>\n<h2>Example 2:</h2>\n<ol>\n<li>Where are my shoes?</li>\n<li>That’s a question sentence because it is asking something.</li>\n<li>I need to turn my sentence into a statement sentence, a command sentence and an exclamation sentence.\n<ul>\n<li>Statement: My shoes have gone.</li>\n<li>Command: Find my shoes.</li>\n<li>Exclamation: How silly you are to have lost your shoes!</li>\n</ul>\n</li>\n</ol>\n<br></br>\n<h2>Example 3:</h2>\n<ol>\n<li>What big eyes you have!</li>\n<li>That’s an exclamation sentence because it begins with what, it’s not a question, and it sounds like something sort of surprising has happened.</li>\n<li>I need to turn my sentence into a question sentence, a command sentence and a statement sentence.\n<ul>\n<li>Question: Why do you have such big eyes?</li>\n<li>Command: Look at those eyes!</li>\n<li>Statement: Those eyes don’t look like they belong to Grandma.</li>\n</ul>\n</li>\n</ol>\n\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 137, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 137, "name": "Example Transformed Sentences", "logCreatedAt": "2021-12-06T15:48:31.804513", "logUpdatedAt": "2021-12-06T15:48:31.804513", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 4, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45255262, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 137, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45255444, "text": "A Mathscot monkey dressed up as an Ancient Egyptian pharaoh. ", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1638805631576_1image1-01FP86SCFJ0NPR27QC6SH5WZC2.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45255262, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 222369135, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45255262, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">In this activity, you will be thinking about these four sentence types: ﻿{{definition \"statement\" \"A statement sentence is the most common type of sentence. These tell the person reading a fact or idea about a single topic.\"}}, {{definition \"question\" \"A question sentence is used to ask something, usually to find out information.\"}}, {{definition \"exclamation\" \"An exclamation sentence begins with 'what' or 'how', includes a verb and ends with an exclamation mark. For instance, ‘What big eyes you have!’ and ‘How brilliant you were at swimming!’ are both exclamations sentences.\"}} and {{definition \"command\" \"A command sentence tells someone to do something. They often start with a verb, e.g. 'Brush your hair.'\"}}.</span></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45255927, "text": "<h2>Challenge: </h2>\nWrite down your four sentences and see if you can remember what punctuation to use.\n", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45255262, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45255528, "text": "<h2>How to Play:</h2>\n<ol>\n<li>Say a sentence (it can be anything, as long as it is a sentence). </li>\n<li>Work out which of the four sentence types it is. How did you know?</li>\n<li>Turn your sentence into each of the other three sentence types. </li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45255262, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]