[{"id": 35930578, "text": "<h2>Top tip:</h2>\nIf you want to make it harder for the other person, think about how to trick them – maybe you could use an incorrect homophone, or maybe you could leave out a bit of trickier punctuation, like the comma that comes after a fronted adverbial. ", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35930484, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35930505, "text": "<h2>How to play:</h2>\n<ol>\n<li>Both players must write a sentence containing exactly two mistakes.</li>\n<li>Swap sentences and see who can spot the mistakes first.</li>\n<li>The first to find both gets two points.</li>\n<li>Each player gets a bonus point for each mistake they accurately correct.</li>\n<li>Repeat two or three times and see who gets the most points!</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633612131585_1image1-01FHDDNJJMHHGPA4C5BBZKQBS2.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35930484, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]