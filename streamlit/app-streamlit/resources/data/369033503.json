[{"id": 369033520, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 369033503, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You'll need:</h2>\n<ul>\n<li>Paper and a pencil each</li>\n<li>A dice - or use the one below.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "ueEEcDPPYRyxDOobxnpa7", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 369033563, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 369033503, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ul>\n<li>Everyone starts at zero</li>\n<li>On your turn, roll the dice.</li>\n<li>Choose whether you want the number to be ones, tens, hundreds or thousands.</li>\n<li>So, if you role a 4 you can choose to add 4, 40, 400 or 4000</li>\n<li>Add your number onto your total</li>\n<li>The first player to get a number from 9995 to 10000 wins.&nbsp;</li>\n<li>Don’t go over 10000 as you can’t subtract!</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 369033578, "text": null, "modal": {"steps": [null], "details": null}, "order": 7, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 369033503, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Extra challenge:</h2>\n<ul>\n<li>Discuss your strategy. Do you think there is a good way to win?</li>\n<li>Play a few games then change the rules - for example:</li>\n<ul>\n<li>roll two dice and choose which number to use</li>\n<li>limit how many time you can choose thousands.</li>\n<li>change the target number.</li>\n</ul>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "h1DO3jbcd6JuMaDgD7lkN", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 369033587, "text": "How do maths games help with learning?", "modal": {"steps": [{"id": 324071304, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 316, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Fun</h2>\n<p>Games can be an enjoyable, motivating way to practice a skill many times.</p>\n<p></p>\n<h2>Positive feelings</h2>\n<p>Having fun together encourages positive feelings towards maths and can reduce worry about making mistakes.</p>\n<p></p>\n<h2>Memory</h2>\n<p>Skills that are practiced when a child is fully engaged and relaxed are more likely to be remembered.</p>\n<p></p>\n<h2>Number sense</h2>\n<p>In trying to win, children really think about the numbers they choose. This builds number sense - a deeper, more flexible understanding of numbers.</p>\n<p></p>\n<h2>Problem solving</h2>\n<p>Finding strategies to win develops problem solving skills.</p>\n<p></p>\n<h2>Mathematical Vocabulary</h2>\n<p>Talking about a game or explaining it to someone else encourages children to use mathematical vocabulary.</p>\n<p></p>\n<h2>Deeper thinking</h2>\n<p>Changing a rule and talking about how that impacts a game encourages an even deeper level of thinking.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "lSemXJT2fEci8gnLBBGXj", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 316, "name": "How do maths games help with learning?", "logCreate