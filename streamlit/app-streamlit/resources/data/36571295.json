[{"id": 36571314, "text": "<h2>Warmup:</h2>\nMake sure you both know how to do a kung fu comma. This involves sticking your arm forward and using your hand to cut a comma shape in the air, while saying the word ‘comma’.\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1634041725739_1image1-01FHT7131ZFM26Y0HEW32XGB6J.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36571295, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40751130, "text": "Example Banquet", "modal": {"steps": [{"id": 40751094, "text": "Player 1: At the banquet, King Henry ate pies.\n<br>\nPlayer 2: At the banquet, King Henry ate pies and soup.\n<br>\nPlayer 1: At the banquet, King Henry ate pies COMMA soup and cake.\n<br>\nPlayer 2: At the banquet, King Henry ate pies COMMA soup COMMA cake and a whole peacock.\n<br>\nPlayer 1: At the banquet, King Henry ate pies COMMA soup COMMA cake COMMA a whole peacock and fifteen little jellies.", "order": 1, "btnType": null, "linkUrl": null, "modalId": 33, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 33, "name": "Example Banquet", "logCreatedAt": "2021-11-08T16:33:37.568166", "logUpdatedAt": "2021-11-08T16:33:37.568166", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 3, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 36571295, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 33, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36572537, "text": "<h2>The Game:</h2>\nPlayers take it in turns to add things to the list of what King Henry ate at the banquet.\n<ul>\n<li>Each player starts their turn by saying ‘At the banquet, King Henry ate...’</li>\n<li>Players add a new food to the end of the list on every turn.</li>\n<li>You must remember all the foods already in the list and say them before you add a new one.</li>\n<li>Try to only say ‘and’ before the last food in the list (not between all the foods).</li>\n<li>Say ‘comma’ and do the kung fu comma action between all the foods in the list (except for when you say ‘and’).</li>\n</ul>\n<br></br>\n<h2>Example game:</h2>\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36571295, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]