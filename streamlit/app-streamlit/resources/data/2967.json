[{"id": 41758351, "text": "<h2>Game 1: In the room</h2>\nHow many things can you find in the room which contain your phoneme? \n<br></br>\n<i>For this game, the spelling doesn't matter - just think about the sound you can hear in the words!</i>\n<br></br>\n<h2>Game 2: In your reading book</h2>\nHow many examples of your phoneme can you find in your book? They can include alternative spellings, e.g. 'ai' 'ay' and 'a_e'. \n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2967, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 41759898, "text": "Example Phonemes", "modal": {"steps": [{"id": 41759856, "text": "Here are some example phonemes you could use:\n", "order": 2, "btnType": null, "linkUrl": null, "modalId": 63, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1636975076936_1image1-01FMHN28F5YM20ZDPZ95A2EEER.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]]