[{"id": 44046722, "text": "Possible Ways of Finishing the Sentences", "modal": {"steps": [{"id": 44046670, "text": "Here's how we finished these sentences:\n<br></br>\nThat’s the woman <span style=\"color:#F28D00\">who</span> <b>won gold in Olympic cycling</b>.\n<br>He lives in a city <span style=\"color:#F28D00\">which</span> <b>is home to two Premier League football clubs</b>.\n<br>I’d like an ice cream <span style=\"color:#F28D00\">that</span> <b>is covered in chocolate sauce</b>.\n<br>I visited the house <span style=\"color:#F28D00\">where</span> <b>Grandma finally captured the wolf</b>.\n<br>This is the boy <span style=\"color:#F28D00\">whose</span> <b>horse was stolen by bandits</b>.\n<br>This is the girl with <span style=\"color:#F28D00\">whom</span> <b>I went to the park</b>.\n<br>Friday is the day <span style=\"color:#F28D00\">when</span> <b>we have fish and chips for tea</b>.\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 103, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 103, "name": "Possible Ways of Finishing the Sentences", "logCreatedAt": "2021-11-29T10:39:15.940402", "logUpdatedAt": "2021-11-29T10:39:15.940402", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}