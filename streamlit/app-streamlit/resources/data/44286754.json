[{"id": 44287196, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44286754, "dimensions": "{}", "editAsHtml": false, "properties": {}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "G_W88aQDExtKp1HaSEfOM", "textEditorState": "<p style=\"font-size:32px;\">1. It was an enormous, hairy, terrifying monster. </p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "I0ZtKGgmeBPRppEVR3eAW", "textEditorState": "<p style=\"font-size:32px;\">2. My favourite foods are burgers, fish and chips, and beans on toast.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "nijSsfjvSBKJm-yafpbWq", "textEditorState": "<p style=\"font-size:32px;\">3. The cat, which was very tired, lay down to sleep.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "sdbKZmVzSfgTG9XlAZ9E0", "textEditorState": "<p style=\"font-size:32px;\">4. When grandma opened her eyes, the wolf was standing next to her.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "aN-lxFNvf80Tm-vyLMJXo", "textEditorState": "<p style=\"font-size:32px;\">5. Suddenly, there was a loud crash!</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "kA-DoyuHulY3aBU1YxgBg", "textEditorState": "<p style=\"font-size:32px;\">6. Oh no, I can’t find my glasses.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "F13pvuov1b7VFRUY0Wlm1", "textEditorState": "<p style=\"font-size:32px;\">7. The Queen shouted, “I need my crown!”</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "sp8ehncPwvxUxdyk5DH9N", "textEditorState": "<p style=\"font-size:32px;\">8. “I would like chips for tea,” said Harry.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "m74KWo6sUXR9TCJCzM9V4", "textEditorState": "<p style=\"font-size:32px;\">9. “Never,” said Lilly, “Have I seen such a sight before!”</p>", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{\"text\":[{\"text\":\"1. It was an enormous, hairy, terrifying monster. \",\"fontSize\":\"32\"},{\"text\":\"2. My favourite foods are burgers, fish and chips, and beans on toast.\",\"fontSize\":\"32\"},{\"text\":\"3. The cat, which was very tired, lay down to sleep.\",\"fontSize\":\"32\"},{\"text\":\"4. When grandma opened her eyes, the wolf was standing next to her.\",\"fontSize\":\"32\"},{\"text\":\"5. Suddenly, there was a loud crash!\",\"fontSize\":\"32\"},{\"text\":\"6. Oh no, I can’t find my glasses.\",\"fontSize\":\"32\"},{\"text\":\"7. The Queen shouted, “I need my crown!”\",\"fontSize\":\"32\"},{\"text\":\"8. “I would like chips for tea,” said Harry.\",\"fontSize\":\"32\"},{\"text\":\"9. “Never,” said Lilly, “Have I seen such a sight before!”\",\"fontSize\":\"32\"}]}", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44289415, "text": "Find Out Why We Used Commas", "modal": {"steps": [{"id": 44287553, "text": "Here are the reasons commas were used in the sentences:\n<br></br>\n<b>1. It was an enormous<span style=\"color:#F28D00\">,</span> hairy<span style=\"color:#F28D00\">,</span> terrifying monster. </b>\n<br><i>Used to separate the words in a list.</i>\n<br></br>\n<b>2. My favourite foods are burgers, fish and chips<span style=\"color:#F28D00\">, and</span> beans on toast.</b>\n<br><i>Used to separate the items in a list. Here, there is an extra comma before the 'and' which joins last item in the list ('beans on toast'). This is sometimes called an Oxford comma. A comma isn’t usually needed before the 'and', but here it makes it clear that the chips go with the fish and not with the beans on the toast.</i>\n<br></br>\n<b>3. The cat<span style=\"color:#F28D00\">, which was very tired,</span> lay down to sleep.</b>\n<br><i>Separating the extra clause which has been in the middle of the sentence (‘which was very tired’).</i>\n<br></br>\n<b>4. <span style=\"color:#F28D00\">When grandma opened her eyes,</span> the wolf was standing next to her.</b>\n<br><i>Separating the subordinate clause at the start of the sentence. If you changed the order of the clauses, the comma wouldn’t be needed (‘The wolf was standing next to her when grandma opened her eyes.’)</i>\n<br></br>\n<b>5. <span style=\"color:#F28D00\">Suddenly,</span> there was a loud crash!</b>\n<br><i>After the fronted adverbial 'suddenly'.</i>\n<br></br>\n<b>6. <span style=\"color:#F28D00\">Oh no,</span> I can’t find my glasses.</b>\n<br><i>To separate the interjection ‘oh no’ from the rest of the sentence.</i>\n<br></br>\n<b>7. The Queen shouted<span style=\"color:#F28D00\">, “</span>I need my crown!”</b>\n<br><i>Before speech marks.</i>\n<br></br>\n<b>8. “I would like chips for tea<span style=\"color:#F28D00\">,” said Harry</span>.</b>\n<br><i>At the end of speech instead of a full stop when the reporting clause ('said Harry') comes after the speech.</i>\n<br></br>\n<b>9. “Never<span style=\"color:#F28D00\">,” said Lilly, “</span>Have I seen such a sight before!”</b>\n<br><i>The word ‘never’ has been separated from the rest of the speech in this interrupted speech and the comma comes after ‘never’ before the speech marks. There is also a comma after the reporting clause ‘said Lilly’ before the next speech marks.</i>\n<br></br>\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 113, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 113, "name": "Find Out Why We Used Commas", "logCreatedAt": "2021-11-30T08:55:32.171122", "logUpdatedAt": "2021-11-30T08:55:32.171122", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44286754, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 113, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44286940, "text": 