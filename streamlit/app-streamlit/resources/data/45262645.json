[{"id": 45268079, "text": "What the Words on the Second Die Mean:\n<ul>\n<li><b>Mime:</b> actions only, no noises.</li>\n<li><b>Drawing:</b> no letters or numbers, no talking.</li>\n<li><b>Mmmmm:</b> say a sentence with the word in but say mmmm instead of the word.</li>\n<li><b>Noise:</b> make noises, but not words, and don’t move</li>\n</ul>\n", "modal": {"steps": [null], "details": null}, "order": 6, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45262645, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45263347, "text": "A Mathscot monkey with a football.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1638809055975_1image1-01FP89ZTGG4S5WBHZDDT9C2F0P.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45262645, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45263173, "text": "<h2>The Aim of the Game:</h2>\nRoll the dice to get a compound word and a way to act out the two parts. Will the other person guess your word?", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45262645, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45263964, "text": "<h2>You will Need:</h2>\n<ul>\n<li>Some scrap paper;</li>\n<li>Something to write with.</li>\n</ul>\n<br></br>\n<h2>How to Play:</h2>\n<ol>\n<li>Player 1 rolls the first die to see a compound word. Do not tell Player 2 what it is!</li>\n<li>Player 1 splits the word into its two parts, e.g. ‘football’ into ‘foot’ and ‘ball’.</li>\n<li>Player 1 rolls the second die to find out which way they are going to give clues for the two parts. </li>\n<li>Player 1 gives two clues, one for each part of the word.</li>\n<li>Player 2 guesses what the whole word was and writes it down.</li>\n<li>Player 1 tells them if they were correct and checks the spelling.</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45262645, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45268563, "text": "Example Split It Game", "modal": {"steps": [{"id": 45268270, "text": "<ol>\n<li>Player 1 splits ‘football’ into ‘foot’ and ‘ball’.</li>\n<li>Player 1 uses ‘Mmmmm’ to give a clue for ‘foot’: ‘I put a sock on my mmmmm before I put it in my shoe.’</li>\n<li>Player 2 guesses ‘foot’.</li>\n<li>Player 1 uses ‘Mmmmm’ to give a clue for ‘ball’: ‘The Sun is a big, round mmmmm in the sky.’</li>\n<li>Player 2 guesses ‘sphere’. But ‘footsphere’ isn’t a word. Player 2 thinks and realises it was ‘ball’. ‘Football’ is a word! Player 2 writes ‘football’ on the paper.</li>\n<li>Player 1 says Player 2 has guessed correctly and spelled the word correctly.</li>\n<li>Player 2 rolls the dice and has a go.</li>\n</ol>", "order": 2, "btnType": null, "linkUrl": null, "modalId": 138, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensio