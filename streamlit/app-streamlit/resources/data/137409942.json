[{"id": 149120277, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 137409942, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You'll need:</h2>\n<p>A pen or pencil and paper.</p>\n<p></p>\n<h2>The activity:</h2>\n<p>Here are some puzzle questions.</p>\n<p>They may take some thinking about.</p>\n<p>There may be more than one answer.</p>\n<p>Writing lists of multiples may help you.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 137411245, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 137409942, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Can you think of a number:</p>\n<ul>\n<li>greater than 30, that is a multiple of both 4 and 8.</li>\n<li>smaller than 20, that is a multiple of 4 but NOT a multiple of 8.</li>\n<li>that is a multiple of 4, 8 and 10?</li>\n<li>that is greater than 100 that is a multiple of 4</li>\n<li>Can you find all the numbers that 48 is a multiple of?</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 149161624, "text": "Lists of 4, 8 and 10 times tables written out with pen on paper.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Year 4 counting in 4s and 8s multiple lists.", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Year 4 counting in 4s and 8s multiple lists.-jf8RzXOz6b28g15DCO-x6.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 137409942, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 137411862, "text": "Answers", "modal": {"steps": [{"id": 137411745, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 242, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Numbers greater than 30 that are multiples of both 4 and 8</p>\n<p><strong>32,40,48,56 . . .</strong></p>\n<p></p>\n<p>Numbers smaller than 20 which are a multiple of 4 but not 8</p>\n<p><strong>4 and 12</strong></p>\n<p></p>\n<p>Numbers that are multiples of 4,8 and 10</p>\n<p><strong>40, 80, 120, 20 . . .</strong></p>\n<p></p>\n<p>Numbers which are greater than 100 and multiples of 4</p>\n<p><strong>104, 108, 112, 116 . . .</strong></p>\n<p></p>\n<p>Numbers which 48 is a multiple of.</p>\n<p><strong>1,2,3,4,6,8,12,16,24 and 48 itself.</strong></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 242, "name": "Solutions to 'Can you think  . .'", "logCreatedAt": "2023-09-12T11:55:51.348702", "logUpdatedAt": "2023-09-12T11:55:51.348702", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": null}}, "order": 4, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 137409942, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 242, "textCarouselData": "{