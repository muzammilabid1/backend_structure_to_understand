[{"id": 85596428, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 85589563, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p style=\"text-align:center;\"><span style=\"color: rgb(0,0,0);font-size: 24px;font-family: SassoonInfantRg-Regular;\"><strong>Weather Poem</strong></span></p>\n<p><span style=\"color: rgb(251,160,38);font-size: 24px;font-family: SassoonInfantRg-Regular;\">When</span><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\"> the rain came down, _______________________.</span></p>\n<p><span style=\"color: rgb(251,160,38);font-size: 24px;font-family: SassoonInfantRg-Regular;\">If </span><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">it had been sunny, </span><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: SassoonInfantRg-Regular;\">_______________________.</span>&nbsp;</p>\n<p><span style=\"color: rgb(251,160,38);font-size: 24px;font-family: SassoonInfantRg-Regular;\">Although </span><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">it had not yet snowed, </span><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: SassoonInfantRg-Regular;\">_______________________.</span>&nbsp;</p>\n<p><span style=\"color: rgb(251,160,38);font-size: 24px;font-family: SassoonInfantRg-Regular;\">Because </span><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">the storm had begun, </span><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: SassoonInfantRg-Regular;\">_______________________.</span>&nbsp;</p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 85596423, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 85589563, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<p>Work together to create a weather poem by adding a main clause in the space for each of the sentences below.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 85597266, "text": "What words should we choose?", "modal": {"steps": [{"id": 85597424, "text": null, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 199, "audioUrl": null, "fileName": "Lightning blob", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Lightning blob-uE5XJuio2VHBKP5x7SqeB.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'ro