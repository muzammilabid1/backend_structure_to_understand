[{"id": 74487819, "text": "Reminder of spelling rules", "modal": {"steps": [{"id": 74488187, "text": "<center>\nlazy → lazily\n</center>", "order": 4, "btnType": "PRIMARY", "linkUrl": null, "modalId": 164, "audioUrl": null, "fileName": null, "fontSize": 23, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size:23px;font-family:SassoonInfantRg-Regular;\"><center>\nlazy → lazily\n</center></span></p>", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74488201, "text": null, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "modalId": 164, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<ul>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\"><strong>But</strong> don't change the 'y' to 'i' if the word only has one syllable.</span>&nbsp;</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionD