[{"id": 486083611, "text": "<h2>How to play:</h2>\n<ol>\n<li>Player 1 writes the first line of a story. The last bit of the line goes on the line/space below as a “hook” for the next person to finish. Make sure it is an unfinished sentence so that the first thing they need to do is finish the sentence.</li>\n<li>Player 2 finishes the sentence and starts a new one, again leaving a “hook” on the next line.</li>\n<li>Keep swapping over until you get to the end.</li>\n<li>Unfold the paper and see what story you have written!</li>\n</ol>\n<br></br>\n<h2>How to make it really good:</h2>\n<ul>\n<li>Don’t get stuck with the story you started telling. If you keep trying to go back to your first idea, it won’t really work. Instead, use the other person’s “hook” to move on your ideas, which will keep changing each time you add something.</li>\n<li>Don’t peek at what the other person wrote. It doesn’t matter if it makes sense. In fact, it can be funnier if it doesn’t!</li>\n</ul>\n<br></br>\n<h2>Example story beginning:</h2>\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633447020749_1image1-01FH8GD7QEKABF31K0SM0QBP5G.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 486083584, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 487098865, "text": "Example - written larger", "modal": {"steps": [{"id": 487098806, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 431, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">It was the hottest day of the summer and Leila wanted something to help her cool down. </span></p>\n<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">“Mum, can I have a </span><span style=\"color: rgb(243,121,52);font-size: 24px;font-family: SassoonInfantRg-Regular;\">unicorn for a pet?” she asked. Mum looked at her and </span></p>\n<p><span style=\"color: rgb(243,121,52);font-size: 24px;font-family: SassoonInfantRg-Regular;\">shook her </span><span style=\"color: rgb(0,0,0);font-size: 24px;font-family: SassoonInfantRg-Regular;\">watering can over the flowers. The garden was looking beautiful.</span></p>\n<p><span style=\"color: rgb(0,0,0);font-size: 24px;font-family: SassoonInfantRg-Regular;\">In the sun, </span><span style=\"color: rgb(243,121,52);font-size: 24px;font-family: SassoonInfantRg-Regular;\">the alien spacecraft boosted its heat-protection shield and the crew made their measurements.</span></p>\n<p><span style=\"color: rgb(243,121,52);font-size: 24px;font-family: SassoonInfantRg-Regular;\">Slowly, they </span><span style=\"color: rgb(0,0,0);font-size: 24px;font-family: SassoonInfantRg-Regular;\">put on their socks and opened the door.</span></p>\n<p><span style=\"color: rgb(0,0,0);font-size: 24px;font-family: SassoonInfantRg-Regular;\">Outside, it was </span><span style=\"color: rgb(243,121,52);font-size: 24px;font-family: SassoonInfantRg-Regular;\">orange and inside it was blue.</span></p>\n<p><span style=\"color: rgb(243,121,52);font-size: 24px;font-family: SassoonInfantRg-Regular;\">The letter box </span><span style=\"color: rgb(0,0,0);font-size: 24px;font-family: SassoonInfantRg-Regular;\">shut with a snap and the letter disappeared inside.</span></p>\n<p><span style=\"color: rgb(0,0,0);font-size: 24px;font-family: SassoonInfantRg-Regular;\">What was</span></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "McHV02PHEalhm_TyRIEhp", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 431, "name": "Example story beginning", "logCreatedAt": "2024-11-12T09:48:13.365568", "logUpdatedAt": "2024-11-12T09:48:13.365568", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": "Fold over story example"}}, "order": 2, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 486083584, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 431, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "lLd8CwHwsOZvWUY1Rt4Ge", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]