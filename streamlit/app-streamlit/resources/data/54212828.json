[{"id": 57226348, "text": "<h2>How to Play:</h2>\n<ol>\n<li>Player 1 hides under the sheet and does an action ending <span style=\"color:#F28D00\">ing</span>, e.g. laugh<span style=\"color:#F28D00\">ing</span> or jump<span style=\"color:#F28D00\">ing</span>.</li>\n<li>Player 1 comes out from under the sheet and player 2 guesses what they were doing. All guesses must end <span style=\"color:#F28D00\">ing</span>, e.g. 'You were hopp<span style=\"color:#F28D00\">ing</span>.'</li>\n<li>If Player 2 can't guess, Player 1 goes back under the sheet to try again. Maybe they need to do the action bigger or louder!</li>\n<li>When Player 2 has guessed, swap over so Player 2 has a go under the sheet.</li>\n<li>Repeat!</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54212828, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 57225883, "text": "A child is standing with a sheet draped over them. They are doing some kind of action, which you can see the shape of through the fabric.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "under_a_sheet_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "under_a_sheet_image-01FX2B5VS63482ZCAA0BJYZ2W4.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54212828, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 117137275, "text": "Play Safely", "modal": {"steps": [{"id": 117136867, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 215, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Always check the space around you before you start playing a game where someone is blindfolded.  Make sure there is nothing on the floor to trip over, no stairs to fall down and nothing sharp, like a table corner, to bump into. Always watch the blindfolded person carefully.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 215, "name": "Pla