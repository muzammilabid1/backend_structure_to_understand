[{"id": 35477111, "text": "Watch a poet performing their poem and talk about what you like about their performance. \n<br></br>\nMichael Rosen is a good example of a poet who uses their performance to help you enjoy their poems even more. This page of his website has some good poems to choose from. You could pick anything, though ‘Strict’ is particularly fun! ", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35477051, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35477154, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": "https://www.michaelrosen.co.uk/hypnotiser/ ", "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": "Michael Rosen Performing His Poems", "stepType": "LINK", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35477051, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35477232, "text": "<h2>Questions to discuss:</h2>\n<ol>\n<li>Did you enjoy the performance?</li>\n<li>What did you like about it?</li>\n<li>How did their voice help you understand the meaning?</li>\n<li>How did they use their face to help with the meaning?</li>\n<li>What did they do with their hands?</li>\n<li>Was there anything you didn’t like about the performance?</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633439867171_1image1-01FH89HQ3FXSXP436S2RJ8A5BM.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35477051, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]