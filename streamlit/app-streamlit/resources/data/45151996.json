[{"id": 45152901, "text": "A World Cup Sheet with the 'Last 16' spaces filled in (lion, mouse, horse, tiger, zebra, cobra, monkey, sheep, llama, elephant, scorpion, shark, camel, flea, cow, fox).", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1638786089494_1image1-01FP7M47NJXDDCB54AESED0HDP.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45151996, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45152388, "text": "<h2>You will Need:</h2>\n<ul>\n<li>The World Cup sheet (or draw your own);</li>\n<li>Something to write with.</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45151996, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 58354591, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": "world_cup_pdf", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45151996, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": "world_cup_pdf-01FXJKVQ2TA92A2N9TGZ4T7RQB.pdf", "editorState": null, "carouselData": null, "downloadName": "World Cup Sheet Download", "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45154051, "text": "Completed World Cup sheet with animals, showing that the sheep was the winner in this example World Cup.", "modal": {"steps": [null], "details": null}, "order": 7, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1638787141492_1image1-01FP7N58QSK6M2E33CNA6FB0KY.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45151996, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45153968, "text": "<h2>How to Play:</h2>\n<ol>\n<li>For each competing pair of teams in the ‘Last Sixteen’, debate which team would win. \n<ul>\n<li>Pick one of the teams each.</li>\n<li>Try to persuade the other person that your team should go through to the next round.</li> \n<li>After you have debated, you will need to decide together which one will go through!</li>\n</ul></li>\n<li>Write the winning teams in the Quarter Final (QF) spaces. There should be eight Quarter-finalists on the sheet, four on each side.</li>\n<li>Repeat with these four pairs.  The winners of these are your Semi-finalists (SF).</li>\n<li>Repeat your debate with your two pairs of Semi-finalists. The winners of these will be your two Finalists!</li>\n<li>Let your last debate begin to find out who has won the world cup!</li>\n</ol>\n\n", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45151996, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45152622, "text": "<h2>Setting Up the Game:</h2>\n<ol>\n<li>Choose a category. It can be anything: animals, crisp flavours, story characters, etc. </li>\n<li>Think of sixteen things from the category, e.g. sixteen animals.</li>\n<li>Write them in the sixteen ‘Last Sixteen’ spaces on the sheet, eight on each side.</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45151996, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45153505, "text": "Example Round", "modal": {"steps": [{"id": 45153093, "text": "<span style=\"color:#F28D00\">Player 1: I think the lion will beat the mouse because it is bigger, stronger and much cooler.</span>\n<br><span style=\"color:#39B0E2\">Player 2: I think the mouse should go onto the next round because being small isn’t a bad thing, and anyway, mice are cleverer than lions.</span>\n<br><span style=\"color:#F28D00\">Player 1: Well, I think the lion would eat the mouse, so it’s definitely better.</span>\n<br><span style=\"color:#39B0E2\">Player 2: Firstly, I don’t think eating something smaller than you makes you better. Secondly, I think the mouse would be able to run into a hole and hide from the lion. Also, I think mice are much sneakier than lions, because I don’t think you’d notice a mouse stealing your food in the night, but a lion would be pretty obvious if it started walking around your house.</span>\n<br><span style=\"color:#F28D00\">Player 1: Maybe, but lions are a vulnerable species, which means they need protecting. Nobody wants to protect mice, they’re pests.</span>\n<br><span style=\"color:#39B0E2\">Player 2: No! Mice are cute! And you can keep them as pets. I wouldn’t want a lion as a pet, it might eat me!</span>\n<br></br>\n<i>The players might continue the debate for a bit, but once they’ve run out of things to say, they should decide which animal should go on to the next round.</i>\n<br>\n<br><span style=\"color:#F28D00\">Player 1: I really liked your points about the mouse being a better pet, but I still think a lion should beat a mouse in this competition.</span>\n<br><span style=\"color:#39B0E2\">Player 2: I think I agree. It would be strange if the King of the Beasts didn’t get through to the next round. I wonder if any other animals will beat it?</span>", "order": 2, "btnType": null, "linkUrl": null, "modalId": 123, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45153035, "text": "Lion vs Mouse", "order": 1, "btnType": null, "linkUrl": null, "modalId": 123, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size:16px;font-family:SassoonInfantRg-Regular;\">Lion vs Mouse</span></p>", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 123, "name": "Lion vs Mouse", "logCreatedAt": "2021-12-06T10:22:40.413755", "logUpdatedAt": "2022-03-07T16:30:57.89753", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45151996, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 123, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]