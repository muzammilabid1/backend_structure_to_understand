 do you notice?  Can you carry on?</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 123492305, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 123491881, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">23, 33, 43</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">25, 35, 45</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">37, 47, 57</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">29, 39, 49</p>", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{\"text\":[{\"text\":\"23, 33, 43\",\"fontSize\":\"32\"},{\"text\":\"25, 35, 45\",\"fontSize\":\"32\"},{\"text\":\"37, 47, 57\",\"fontSize\":\"32\"},{\"text\":\"29, 39, 49\",