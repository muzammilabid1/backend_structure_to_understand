[{"id": 36584673, "text": "<h2>You Need:</h2>\n<ul>\n<li>Five toy animals (they could be soft toys or mini figures or you could draw pictures of them on pieces of paper or cut them out of a magazine).</li>\n<li>An object each animal would like to take on holiday.</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1634050970654_1image1-01FHTG956C6H6WQFCJHANJZ0CX.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36584656, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36585171, "text": "<br><br>\n<h2>The Activity:</h2>\nWrite a list of which things belong to who so that everyone can find their things when they get to their holiday destination.\n <ol>\n<li>First, write a list of animals down the page (“Dog”, “Mr Tiddles” etc).</li>\n<li>Leave a space and write their object next to them (“Dog &nbsp; &nbsp; hat”).</li>\n<li>Then add apostrophe and “s” (’s) to show the object belongs to them, otherwise the phrase doesn't make sense (“Dog<span style=\"color:#E8492A\">’</span>s hat”).</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36584656, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40831296, "text": "Example List", "modal": {"steps": [{"id": 40831070, "text": "<h2>Step 1: List of Animals</h2>\nDog\n<br>Bear\n<br>Big Cat\n<br>Mr Tiddles\n<br>Trailer Swift\n<br></br>\n<h2>Step 2: Add Their Objects</h2>\nDog &nbsp; &nbsp; hat\n<br>Bear &nbsp; &nbsp; car\n<br>Big Cat &nbsp; &nbsp; book\n<br>Mr Tiddles &nbsp; &nbsp; blanket\n<br>Trailer Swift &nbsp; &nbsp; pair of socks\n<br></br>\n<h2>Step 2: Add <span style=\"color:#E8492A\">’s</span></h2>\nDog<span style=\"color:#E8492A\">’s</span> hat\n<br>Bear<span style=\"color:#E8492A\">’s</span> car\n<br>Big Cat<span style=\"color:#E8492A\">’s</span> book\n<br>Mr Tiddles<span style=\"color:#E8492A\">’s</span> blanket\n<br>Trailer Swift<span style=\"color:#E8492A\">’s</span> pair of socks\n<br></br>", "order": 1, "btnType": null, "linkUrl": null, "modalId": 36, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 36, "name": "