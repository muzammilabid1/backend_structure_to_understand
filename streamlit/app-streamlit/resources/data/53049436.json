[{"id": 53058456, "text": "A piece of paper with 'Wolf', 'Cinderella' and 'Smallest Billy Goat' written across the top.", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "fairy_tale_adjectives_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "fairy_tale_adjectives_image-01FTTECS7NWDM1JPVGB6H3JH1J.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 53049436, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 222533547, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 53049436, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to Play:</h2>\n<ol>\n<li>Look at the <span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">{{definition \"adjective\" \"An adjective is a word that describes something, e.g. 'small', 'scary' or 'red'.\"}} </span>card below.</li>\n<li>Both players should decide which word goes best with each of the characters and write the word underneath their name.</li>\n<li>When you have both written all three words, compare what you have written. You get a point if you both have the same thing!</li>\n<li>Look at the next adjective card and play again.</li>\n<li>After five adjectives, see how many points you have scored!</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 53147422, "text": "What if the adjective doesn't fit with one of my characters?", "modal": {"steps": [{"id": 53147287, "text": "A piece of paper with the three characters written along the top and three describing words below. Under 'Wolf' it says 'small', under 'Cinderella' it says 'smaller' and under 'Smallest Billy Goat' it says 'smallest'.", "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 150, "audioUrl": null, "fileName": "fairy_tale_adjectives_2_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "fairy_tale_adjectives_2_image-01FTTYYV45QYF47XG2QFN6TEN6.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 53147174, 