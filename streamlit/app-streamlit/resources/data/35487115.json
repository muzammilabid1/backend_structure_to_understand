[{"id": 40623007, "text": "Kung Fu Punctuation Actions", "modal": {"steps": [{"id": 40622828, "text": "<table style cellpadding=\"10px\" border=\"1\">\n  <tr>\n    <td><span style =\"font-size:200%\">A</span></td>\n    <td><b>Capital letter</b></td>\n    <td>Hands on your head like a capital A</td>\n  </tr>\n  <tr>\n    <td><span style =\"font-size:200%\">.</span></td>\n    <td><b>Full stop</b></td>\n    <td>Punch forwards</td>\n  </tr>\n  <tr>\n    <td><span style =\"font-size:200%\">!</span></td>\n    <td><b>Exclamation mark</b></td>\n    <td>Chop one hand down for the line, then punch for the dot</td>\n  </tr>\n  <tr>\n    <td><span style =\"font-size:200%\">?</span></td>\n    <td><b>Question mark</b></td>\n    <td>Slice one hand round in a curve for the line, then punch for the dot</td>\n  </tr>\n  <tr>\n    <td><span style =\"font-size:200%\">,</span></td>\n    <td><b>Comma</b></td>\n    <td>Small twist with a flat hand</td>\n  </tr>\n  <tr>\n    <td><span style =\"font-size:200%\"> “&nbsp;”</span></td>\n    <td><b>Inverted commas (speech marks)</b></td>\n    <td>Two fingers on each hand making speech marks</td>\n  </tr>\n  <tr>\n    <td><span style =\"font-size:200%\">’</span></td>\n    <td><b>Apostrophe</b></td>\n    <td>Like a comma but higher in the air</td>\n  </tr>\n</table>\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 28, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size:16px;font-family:SassoonInfantRg-Regular;\"><table style cellpadding=\"