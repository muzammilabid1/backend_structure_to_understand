[{"id": 44335867, "text": "<h2>You will Need:</h2>\n<ul>\n<li>5 sheets of scrap paper per player;</li>\n<li>Something to write with.</li>\n</ul>\n<br></br>\n<h2>How to Play:</h2>\n<ol>\n<li>Write a silly expanded noun phrase on each sheet of paper, e.g. ‘the brilliant barking blue baboon’.</li>\n<li>Scrunch up each sheet of paper into a ball.</li>\n<li>When everyone is ready, the snowball fight begins. Count down from five so that everyone can find a space in the room.</li>\n<li>When someone is hit by a snowball, shout ‘Snowballed!’ and everyone must stop throwing. The player who was hit picks up the ball that hit them, opens it up and reads it aloud (if they wrote it themselves, they should scrunch it up and pick the nearest ball to read instead). If the reader laughs, the person who wrote it gets a point.</li>\n<li>Recycle the used snowball and continue playing. If you get low on snowballs, you can stop and write some more!</li>\n<li>The winner is the player with the most points at the end of the game.</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44335528, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44335598, "text": "<h2>The Aim of the Game:</h2>\nThrow paper snowballs 