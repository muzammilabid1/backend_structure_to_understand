[{"id": 35230364, "text": "<h2>The Activity:</h2>\nYou are each going to pretend to be a fictional character and write letters to each\nother as your characters.\n<br><br>\n<h2>What to do:</h2>\n<ol>\n<li>Choose a fictional character each. They can be from the same book (or film or TV programme) or different ones.</li>\n<li>One person writes a letter from their character to the other.</li>\n<li>When the second person receives the letter, they should read it and then write a reply.</li>\n<li>Keep writing replies to each other until you have had a few goes!</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633353405685_1image1-01FH5Q5Z242MN5YHB2729GS24Y.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35230353, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35231205, "text": "<h2>What should I write?</h2>\n<br>\nHere are some things you could think about:", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35230353, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 39775786, "text": "What Should I Write?", "modal": {"steps": [{"id": 39775703, "text": "<ul> \n<li>Think about how your character might write. Try to make your writing sound like them and include things they would know about or do.</li>\n<li>Think about how to start your letter:</li>\n<ul style=\"list-style-position: inside\">\n<li>Do your characters know each other?</li>\n<li>Are they friends, enemies or something else?</li>\n<li>Is this the first time they’ve written to each other, or might they have written in the past?</li>\n</ul>\n<li>Think about why they might be writing to each other. They could be:</li>\n<ul style=\"list-style-position: inside\">\n<li>Sharing news,</li>\n<li>Setting up a meeting,</li>\n<li>Inviting them to something,</li>\n<li>Complaining about something.</li>\n</ul>\n<li>Don’t worry about making it too long – three paragraphs is probably a good length, and gives you space to include:</li>\n<ul style=\"list-style-position: inside\">\n<li>An introduction to why you are writing,</li>\n<li>A middle part with the main points in,</li>\n<li>A closing part with something that will make them want to reply.</li>\n</ul>\n<li>Try to give the other person something to reply to. You could:</li>\n<ul style=\"list-style-position: inside\">\n<li>Ask a question,</li>\n</li>Say something you know they will want to disagree with,</li>\n<li>Ask for advice about something.</li>\n</ul>\n</ol>", "order": 1, "btnType": null, "linkUrl": null, "modalId": 4, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 4, "name": "What Should I Write?", "logCreatedAt": "2021-11-03T11:53:00.7732", "logUpdatedAt": "2021-11-03T11:53:00.7732", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 35230353, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 4, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 39775744, "text": "<h2>Don’t mind spending a bit more time?</h2>\nYou could do this activity with someone who doesn’t live in your house! You could put\nyour letter in the post, or take a photo an text or email it, or even type it up as an\nemail!", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "im