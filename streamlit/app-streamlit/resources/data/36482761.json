[{"id": 36482967, "text": "<h2>The activity:</h2>\nLook at your photo together and talk about what happened. Here are some questions you could think about:\n<br></br>\n<ul>\n<li>What was happening in the picture?</li>\n<li>What happened just before the photo was taken?</li>\n<li>What happened just after?</li>\n<li>What were you feeling like?</li>\n<li>Where were you when the photo was taken?</li>\n<li>How long ago was it?</li>\n<li>What else do you remember about that day or that event?</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36482761, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36482808, "text": "For this activity you will need a photo (it can be on your phone) of something you enjoyed doing together. You could even go for a walk and take one specially for this activity!", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633964469676_1image1-01FHQXW1V1P9FSASXN16YEHPX8.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36482761, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "