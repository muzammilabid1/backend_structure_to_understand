[{"id": 119710203, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2331, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Ask your child to find two different coloured pens or pencils, such as green and blue.</li>\n<li>Draw a pattern of lines with the pencils which follows either the pattern <strong>AAB </strong>or <strong>ABB</strong>, e.g. <span style=\"color: rgb(44,130,201);\">blue blue </span><span style=\"color: rgb(65,168,95);\">green</span>, <span style=\"color: rgb(44,130,201);\">blue blue </span><span style=\"color: rgb(65,168,95);\">green </span>(<span style=\"color: rgb(44,130,201);\">AA</span><span style=\"color: rgb(65,168,95);\">B</span>).</li>\n<li>Ask your child to copy the pattern underneath.&nbsp;</li>\n<li>Repeat with other AAB or ABB patterns.</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 119709726, "text": "766123365", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'