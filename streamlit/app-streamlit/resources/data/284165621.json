[{"id": 284165676, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 284165621, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2 style=\"text-align:start;\">How to play:</h2>\n<p><span style=\"color: rgb(50,51,56);background-color: rgb(255,255,255);font-size: 16px;\">Give your child the magic wand - they are in charge of pointing it!</span></p>\n<ol>\n<li><span style=\"color: rgb(50,51,56);background-color: rgb(255,255,255);font-size: 16px;\">Point your magic wand at someone (you or the other person). </span></li>\n<li><span style=\"color: rgb(50,51,56);background-color: rgb(255,255,255);font-size: 16px;\">They should start counting from one (not too fast).</span></li>\n<li style=\"text-align:unset;\"><span style=\"color: rgb(50,51,56);background-color: rgb(255,255,255);font-size: 16px;\">After a few numbers, point the wand at the other person.</span></li>\n<li><span style=\"color: rgb(50,51,56);background-color: rgb(255,255,255);font-size: 16px;\">The new person must continue to count from where the other person stopped.</span></li>\n<li style=\"text-align:unset;\"><span style=\"color: rgb(50,51,56);background-color: rgb(255,255,255);font-size: 16px;\">Keep swapping backwards and forwards until you get to twenty.</span></li>\n</ol>\n<p style=\"text-align:start;\"></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading"