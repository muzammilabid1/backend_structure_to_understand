[{"id": 36483309, "text": "<h2>How to play:</h2>\n<ol>\n<li>Choose someone you would like to talk to. It could be someone in your house or you could phone or video call someone who lives elsewhere. It could be someone in your family or a family friend.</li>\n<li>Think about something you would like to tell them about – it needs to be something you’ve done recently. It could be somewhere you have been, an activity you have done at home, or what you have been doing at school. Practise by telling your grownup at home your idea.</li>\n<li>Talk to the person you chose and tell them about what happened.</li>\n<li>When you’ve told them your thing, you could ask them about what they have been doing. It is nice to listen as well as to talk!</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36483066, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 381633581, "text": "991950164", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 36483066, "dimensions": null, "editAsHtml": false, "properties": {"hei