[{"id": 359569898, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 359567437, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Getting ready:</h2>\n<p>Use twelve scraps of paper each. Both players should write:</p>\n<ul>\n<li>The names of four famous people</li>\n<li>Four other {{definition \"nouns\" \"Nouns are things like objects, e.g. 'horse', 'apple' or 'love'.\"}}</li>\n<li>Four {{definition \"verbs\" \"Verbs are doing words, e.g. 'running' or 'flying'.\"}}</li>\n</ul>\n<p>Fold all the pieces of paper in half, and put them in your container.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "bPIqSfxwl1VTBZRDD3ooj", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 359569889, "text": "A hat lying upside-down on the floor, with folded scraps of paper inside it.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Hat game blob", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Hat game blob-ZQzCdetfEf3ZzMVvHPvTk.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", 