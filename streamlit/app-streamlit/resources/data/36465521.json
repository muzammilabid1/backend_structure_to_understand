ull, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36465751, "text": "<h2>The Activity:</h2>\nTake it in turns to give instructions about what to do on the obstacle course. \n<ul>\n<li>Start with one-step instructions (e.g. ‘slide down the slide’ or ‘crawl under the blanket’ or ‘jump over the sticks’). </li>\n<li>Then make it more challenging by adding more steps to the instructions (e.g. ‘climb onto the sofa and then curl up in a ball’ or ‘crawl through the tunnel and then swing on the bar’).</li>\n</ul>\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36465521, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36465751, "text": "<h2>The Activity:</h2>\nTake it in turns to give instructions about what to do on the obstacle course. \n<ul>\n<li>Start with one-step instructions (e.g. ‘slide down the slide’ or ‘crawl under the blanket’ or ‘jump over the sticks’). </li>\n<li>Then make it more challenging by adding more steps to the instructions (e.g. ‘climb onto the sofa and then curl up in a ball’ or ‘crawl through the tunnel and then swing on the bar’).</li>\n</ul>\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkNam