[{"id": 43295357, "text": "<h2>Tactics:</h2>\nIt is best to think of a word that has a few things that rhyme with it. You might find it a bit tricky if you pick “orange” as your word!", "modal": {"steps": [null], "details": null}, "order": 6, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 43294694, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43294869, "text": "<h2>The Aim of the Game:</h2>\nTo guess which word the other player is thinking of, using synonyms and rhyme to get closer to the answer.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 43294694, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43294941, "text": "What is a Synonym?", "modal": {"steps": [{"id": 43294907, "text": "Synonyms are words that mean the same thing, for example ‘warm’, ‘boiling’ and ‘roasting’ are all synonyms for ‘hot’.", "order": 1, "btnType": null, "linkUrl": null, "modalId": 95, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 95, "name": "What is a Synonym?", "logCreatedAt": "2021-11-24T12:00:54.824167", "logUpdatedAt": "2021-11-24T12:00:54.824167", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 43294694, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 95, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43295002, "text": "A Plate", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1637755321042_1image1-01FN8X4VKMEMH8E9NZJ4M7762Q.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 43294694, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43295091, "text": "<h2>How to Play:</h2>\n<ol>\n<li>Player 1 thinks of a word. </li>\n<li>Player 1 says, “I’ve thought of a word and it rhymes with…” and says what it rhymes with.</li>\n<li>Player 2 must try to guess what the word is. But they can’t just say their guess, they must ask a question using a synonym for the word they have thought of.</li>\n<li>Player 1 must answer the question with an appropriate word that rhymes with the one they thought of, saying “No, it’s not a…” and the rhyming word. </li>\n<li>Player 2 must keep thinking of rhymes and asking questions until they guess the correct word.</li>\n<li>If Player 1 can only answer with their word, then they say “Yes, it is a…” and their word.</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 43294694, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43295264, "text": "Example Crambo Game", "modal": {"steps": [{"id": 43295171, "text": "In this example game, Player 1 has chosen the word <span style=\"color:#F28D00\">plate</span>. At the start of the game, Player 1 chooses another word which rhymes with <span style=\"color:#F28D00\">plate</span> and Player 2 must guess words which rhyme with that clue word.\n<br></br>\n<h2>Example Game:</h2>\n<br>\nPlayer 1: I have thought of a word and it rhymes with <span style=\"color:#F28D00\">late</span>.\n<br></br>\nPlayer 2: (Thinks it could be <span style=\"color:#F28D00\">gate</span>) Is it a garden door?\n<br>Player 1: No, it is not a <span style=\"color:#F28D00\">gate</span>.\n<br></br>\nPlayer 2: (Maybe it could be <span style=\"color:#F28D00\">great</span>) Is it amazing?\n<br>Player 1: No, it is not <span style=\"color:#F28D00\">great</span>.\n<br></br>\nPlayer 2: (Maybe it could be <span style=\"color:#F28D00\">fete</span>) Is it an outdoor summer fair?\n<br>Player 1: No, it is not a <span style=\"color:#F28D00\">fete</span>.\n<br></br>\nPlayer 2: (Maybe it is <span style=\"color:#F28D00\">mate</span>) Is it a friend?\n<br>Player 1: No, it is not a <span style=\"color:#F28D00\">mate</span>.\n<br></br>\nPlayer 2: (Maybe it is <span style=\"color:#F28D00\">hate</span>) Is it something you really don’t like?\n<br>Player 1: No, it is not <span style=\"color:#F28D00\">hate</span>.\n<br></br>\nPlayer 2: (Maybe it is <span style=\"color:#F28D00\">plate</span>) Is it a dish?\n<br>Player 1: (Realises that they have guessed) You are right, it is a <span style=\"color:#F28D00\">plate</span>!\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 96, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 96, "name": "Example Crambo Game", "logCreatedAt": "2021-11-24T12:03:20.450799", "logUpdatedAt": "2021-11-24T12:03:20.450799", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 43294694, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 96, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43300456, "text": "Feeling Sneaky?", "modal": {"steps": [{"id": 43300184, "text": "Player 1 might be able to trick Player 2. Here's an example of how:\n<br></br>\nPlayer 1's word is <span style=\"color:#F28D00\">zip</span>.\n<br>Player 2 says, “Is it something for fastening a bag?” \n<br>Player 1 doesn't want to lose, so instead of saying \"<span style=\"color:#F28D00\">zip</span>\", they say, '“No, it is not a <span style=\"color:#F28D00\">clip</span>.” \n<br></br>\nIt is ok to say something different when you could say your word, as long as it rhymes and it is an appropriate answer to Player 2’s question!", "order": 1, "btnType": null, "linkUrl": null, "modalId": 97, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 97, "name": "Feeling Sneaky?", "logCreatedAt": "2021-11-24T13:20:32.052971", "logUpdatedAt": "2021-11-24T13:20:32.052971", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 7, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 43294694, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 97, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]