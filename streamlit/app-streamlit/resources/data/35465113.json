[{"id": 40852640, "text": "Example Instructions with Adverbs", "modal": {"steps": [{"id": 40852585, "text": "<b>How to Make Breakfast</b>\n<br></br>\nYou Will Need:\n<ul>\n<li>Bowl</li>\n<li>Spoon</li>\n<li>Cereal</li>\n<li>Milk</li>\n</ul>\n<br></br>\nWhat to Do:\n<ol>\n<li>First, set the table with everything you need.</li>\n<li>Next, put cereal in your bowl.</li>\n<li>Then, pour milk over your cereal.</li>\n<li>After that, eat it up!</li>\n<li>Finally, when you have finished eating, clear the table and put the milk back in the fridge.</li>\n</ol>", "order": 1, "btnType": null, "linkUrl": null, "modalId": 56, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 56, "name": "Example Instructions with Adverbs", "logCreatedAt": "2021-11-09T13:34:04.159429", "logUpdatedAt": "2021-11-09T13:37:23.207211", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 35465113, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 56, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35465379, "text": "<h2>Activity:</h2>\nWrite instructions for how to make breakfast (or you could choose another meal).\n<br></br>\nYou must:\n<ul>\n<li>Think about what to do before you start;</li>\n<li>Include at least five steps;</li>\n<li>Use a number to start each step;</li>\n<li>Use an adverb at the start of each step to help make them easier to follow. You can choose from the list below or come up with your own;</li>\n<li>Try not to use the same adverb more than once;</li>\n<li>If you are feeling fancy, see if you can use a comma after the adverb, e.g. ‘First, put a plate on the table.’</li>\n</ul>\n<br></br>\n<h2>Adverbs You Could Use:</h2>\nfirst, then, next, slowly, carefully, finally\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633430296489_1image1-01FH80GJPE343YDYESGQBCR5TA.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35465113, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]