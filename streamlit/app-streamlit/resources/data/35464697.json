[{"id": 479462407, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35464697, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<p>Team 1 leaves the room and chooses a word with three syllables.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "ox4tB7KIKCnaD-aD0MyTq", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479462331, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35464697, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What you need:</h2>\n<ul>\n<li>Two players, or more players split into two teams</li>\n<li>Dressing up clothes can make this even more fun (optional)</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "K2pKkVQ33ufFTLMmHiQrt", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479463437, "text": "Challenge", "modal": {"steps": [{"id": 479463369, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 426, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Once you get good at playing this game, there are ways for Player 1 make it harder for Player 2:</p>\n<ul>\n<li>Include lots of one syllable words in your first three scenes so it’s not too obvious which ones are the right ones.</li>\n<li>Include several three syllable words in the fourth scene – if you only say one then Player 2 will guess straight away!</li>\n<li>Don’t make your scenes just about the word you thought of – it’ll be really obvious what it is. Make them about something else (but remember to include your syllables/word).</li>\n<li>You could even make your whole charade about two three-syllable words - when the other team guesses one of them at the end, you can say it was actually the other!</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "kfTKAzwgMYV52oOQ3fXwj", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 426, "name": "Challenge", "logCreatedAt": "2024-11-05T15:24:41.541818", "logUpdatedAt": "2024-11-05T15:24:41.541818", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": "Victorian charades challenge"}}, "order": 9, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35464697, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 426, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "8gvFJqM7NiGQR6qLkI5lf", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479462249, "text": "Example game", "modal": {"steps": [{"id": 479462586, "text": null, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "modalId": 423, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Scene 2 (second syllable):</h2>\n<p>Player 1 acts out a trip to the doctor. She is the doctor and asks her teddy (the patient) what is wrong with them. She says things like, “Is there a problem with your eye?” and “Let me have a look at your <span style=\"color: rgb(251,160,38);\">toe</span>.”</p>\n<p><em>Player 2 again thinks about what one syllable words were included.</em></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "Ec_wfIP3bMkN_2wp2yXO3", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479462574, "text": null, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 423, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Scene 1 (first syllable):</h2>\n<p>Player 1 acts out a battle between her and her mortal enemy. She says things like, “Aha, I see my <span style=\"color: rgb(251,160,38);\">foe </span>behind that rock!” and “You will not get away from me!”</p>\n<p><em>Player 2 thinks about what one syllable words were included, e.g. ‘see’, ‘my’, ‘foe’, ‘you’ etc.</em></p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "SgtLTpIHRF_jYgnO5wz6u", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479462557, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 423, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Getting ready:</h2>\n<p>Player 1 chooses the word “photograph” and splits it into three syllables for the first three scenes:</p>\n<ol>\n<li>“foe”</li>\n<li>“toe”&nbsp;</li>\n<li>“graph”</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "NdVrhv36f6AkqkqeFPUHV", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479462616, "text": null, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "modalId": 423, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Scene 4 (whole word):</h2>\n<p>Player 1 thinks of some three syllable words to include in this scene. She must include “photograph” as this was her chosen word but having some more will make it harder to guess. She chooses “awarding”, “designer” and “rocketed”. She pretends to be a reporter at an awards ceremony, interviewing the actor Melanie Jackman about her new film. She says things like, “Melanie, how has it been since you rocketed to fame when this film came out?” and “Could you possibly pose for a <span style=\"color: rgb(251,160,38);\">photograph</span>?”</p>\n<p><em>Player 2 listens out for all the three syllable words.</em></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "WbiaBAaHoUIMsRvhrHCy0", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479462635, "text": null, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "modalId": 423, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Guessing the word:</h2>\n<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\"><em>Which of the three syllable words in the last scene had syllables which featured in earlier scenes? </em></span></p>\n<ul>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\"><em>“Rocketed” is a possibility – “rock” was in the first scene – but he can’t remember hearing “ted” in the third scene. </em></span></li>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\"><em>Maybe “photograph?” Oh yes, there was a “toe” in the scene at the doctors. And she was fighting a “foe” in the first scene. It must be “photograph”!</em></span>&nbsp;</li>\n</ul>\n<p>Player 2 guesses “photograph” and Player 1 says he was correct!</p>\n<p>The players then swap over, and Player 2 chooses a word to act out.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "NWtS60_iFsqIv_1bYznUg", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479462601, "text": null, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "modalId": 423, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Scene 3 (third syllable):</h2>\n<p>Player 1 pretends to be a nutritionist sharing some information about popular foods. She is presenting her ideas to an audience. She says things like, “Most kids like to eat lots of sweets!” and “If you look at this <span style=\"color: rgb(251,160,38);\">graph</span>, you will see that in the UK, jam is getting less popular as a toast topping over time.”</p>\n<p><em>Player 2 again thinks about what one syllable words were included.</em></p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "2IEGWQ3ZpO5jvsuVP-7Kb", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 423, "name": "Example game", "logCreatedAt": "2024-11-05T15:02:29.8302", "logUpdatedAt": "2024-11-05T15:02:29.8302", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": "Victorian charades example game"}}, "order": 8, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35464697, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 423, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "s2LubXl4pkdeJROY0O7hg", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479462793, "text": "Choosing your word", "modal": {"steps": [{"id": 479462880, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 424, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Think about what you could say for each syllable – it’s easier if the syllables sound like real words:</p>\n<ul>\n<li>“Tricycle” can be broken down into “try”, “sick” and “all” (which are all real words)</li>\n<li>“Banana” will be harder because “ban” is a real word but “arr” and “nah” are just sounds (though you could still do this, you just need to be more creative – maybe have a Pirate in the second scene who says “arr” and someone who disagrees in the third scene by saying “nah”).</li>\n</ul>\n<p><strong>Suggestions of three syllable words:</strong></p>\n<p>Amazing: a, may, zing</p>\n<p>Microwave: my, crow, wave</p>\n<p>Recycle: re, sigh, call</p>\n<p>Terrible: tear, rib, all</p>\n<p>Waterfall: wart, er, fall</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "ruIOfHYXcwOoTYINk2W_Q", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 424, "name": "Choosing your word", "logCreatedAt": "2024-11-05T15:15:07.859885", "logUpdatedAt": "2024-11-05T15:21:03.307797", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": "Hints for choosing your word in Victorian charades"}}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35464697, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 424, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "pdxB_sv7zF_1td2mTLJH0", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35465122, "text": "", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633430296775_1image1-01FH80D1DX6WJ7ZBS71PNYX3TF.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35464697, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479463214, "text": null, "modal": {"steps": [null], "details": null}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35464697, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Team 1 acts out four scenes for Team 2 to watch:</p>\n<ul>\n<li>First scene: include the first syllable of the word;</li>\n<li>Second scene: include the second syllable;</li>\n<li>Third scene: include the third syllable;</li>\n<li>Fourth scene: include the whole word.</li>\n</ul>\n<p>Team 2 watches all four scenes and then guesses what the word was.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "pVsmIwh-66rTRvTKgqGEb", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479463056, "text": "Hints to help Player 2 guess", "modal": {"steps": [{"id": 479462995, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 425, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<ul>\n<li>Listen for any one syllable words included in the first three scenes.</li>\n<li>Listen for all the three syllable words included in the fourth scene.</li>\n<li>If you hear a three syllable word in the fourth scene, see if you recognise any of its parts from the earlier scenes!</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "EwKBHPuRLjqYUjire2yG9", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 425, "name": "Hints to help Player 2 guess", "logCreatedAt": "2024-11-05T15:18:51.245599", "logUpdatedAt": "2024-11-05T15:18:51.245599", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": "Hints to help Player 2 guess in Victorian charades"}}, "order": 7, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35464697, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 425, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "PoXJju2Dxs-CzhcLMlIyH", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 479462316, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35464697, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArr