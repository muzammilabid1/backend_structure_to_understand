[{"id": 427333501, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 398, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Player 1 writes down a number bond to 20.</li>\n<li>For example 14+6=20.</li>\n<li>This is kept secret.</li>\n<li>Player 2 tries to guess what the number bond is.</li>\n<li>Player 2 keeps guessing until they get it right.</li>\n<li>Then swap over.&nbsp;&nbsp;</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "YQGUajGF5o-cVyt8CtUoI", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 427333976, "text": "Where's the learning?", "modal": {"steps": [{"id": 427333863, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 407, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<ul>\n<li>To win this game you have to keep saying different number bonds to 20.</li>\n<li>'Guessing' is a motivating way to practice the same thing many times.</li>\n<li>During the game, your child will both hear and recall the number bonds lots of times.</li>\n<li>This will help them to learn the combinations that make 20.</li>\n<li>Knowing these combinations will help your children understand the patterns in the number system.</li>\n<li>It can also make bigger calculations easier.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "0FPtfAa56fYF2pIx7gcF5", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 407, "name": "Where's the learning?", "logCreatedAt": "2024-10-01T13:20:50.146199", "logUpdatedAt": "2024-10-01T13:20:50.146199", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": "Y2 - secret number bonds - rationale"}}, "order": 4, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 398, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 407, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "eRdVk2tbPGj-9RzOSiAhZ", "checked": false, "li