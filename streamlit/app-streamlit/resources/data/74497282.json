[{"id": 74499353, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74497282, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><strong>Too tricky?</strong></p>\n<p>Just choose the two of your words that work best together!</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74497514, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74497282, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Roll the dice below to give each player three adjectives.</li>\n<li>Write your three adjectives on your piece of paper.</li>\n<li>Invent a character who could be described by all three of your adjectives. Draw a picture of them on your paper.</li>\n<li>When you have both finished drawing, tell each other about your characters.</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74497352, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74497282, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You will need:</h2>\n<ul>\n<li>A piece of paper each</li>\n<li>Something to write with</li>\n<li>Colouring pens or pencils (optional)</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74498365, "text": "beautiful: very pretty or handsome\ndutiful: does everything that is expected of them\nfriendless: has no friends\ngraceful: moves in a beautiful way\nharmless: wouldn't hurt anyone or anything\nhopeless: a bit incompetent, not very good at something\nmerciless: shows no mercy, is cruel\npeerless: nobody can compare to them - they are the best\npenniless: has no money\npitiful: deserves to be pitied, we all feel sorry for them\nplayful: enjoys games and having fun\npowerful: has a lot of strength, physically or in other ways\nresourceful: able to find quick and clever ways to overcome difficulties\nthoughtful: thinks about the needs of others\nuseless: is a bit rubbish", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL_WITH_CLICKABLE_ALPHABET", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74497282, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": "{\"btnText\":\"What do my words mean?\",\"btnType\":\"PRIMARY\",\"modalHeading\":\"Word meanings\",\"modalText\":null,\"alphabetJSON\":{\"b\":[\"beautiful: very pretty or handsome\"],\"d\":[\"dutiful: does everything that is expected of them\"],\"f\":[\"friendless: has no friends\"],\"g\":[\"graceful: moves in a beautiful way\"],\"h\":[\"harmless: wouldn't hurt anyone or anything\",\"hopeless: a bit incompetent, not very good at something\"],\"m\":[\"merciless: shows no mercy, is cruel\"],\"p\":[\"peerless: nobody can compare to them - they are the best\",\"penniless: has no money\",\"pitiful: deserves to be pitied, we all feel sorry for them\",\"playful: enjoys games and having fun\",\"powerful: has a lot of strength, physically or in other ways\"],\"r\":[\"resourceful: able to find quick and clever ways to overcome difficulties\"],\"t\":[\"thoughtful: thinks about the needs of others\"],\"u\":[\"useless: is a bit rubbish\"]}}"}, {"id": 74498228, "text": null, "modal": {"steps": [null], "details": null}