[{"id": 487112857, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 487111836, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<p>Both people have two minutes to think about the question. Imagine what would happen and what it would be like. Think about the little details you might like to tell the other person.</p>\n<p>When the two minutes are up, take it in turns to explain what you think it would be like. Try to give a detailed explanation!</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "alAfZ1fN33dtISPuDsIFi", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 487111966, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 487111836, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "vH5fwBT6J4T9243EDf8L1", "textEditorState": "<p>What if children made all the rules...?</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "EqfXC0lIbPqVQ4lFGXWGi", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">What if you had a theme song that played every time you walked in a room...?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "ZRB852C-v1YyI_p09_Ckk", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">What if there was a zombie apocalypse and you were the only person left on the planet...?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "8QvIu_Of75Qbi5EQrNMHO", "textEditorState": "<p>What if dinosaurs came back to life...?</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "s1YybeAML-OVp0vRc5Yu5", "textEditorState": "<p><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\">What if you were allowed to create one new law everyone had to follow...?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "ASc6p1VPjUQOkGUvBR5vT", "textEditorState": "<p>What if you won a million pounds...?</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "Vkl5U0eykmE9Qyqt0kafO", "textEditorState": "<p>What if there were only three books left in the world...?</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "sWULYHIyR-V6eJjJtsyxE", "textEditorState": "<p>What if children were allowed to drive cars...?</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "Jx_1k3EM5MOvFuxBdHrbR", "textEditorState": "<p>What if you went back five hundred years in time...?</p>\n", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "scxRU4G9NPECsEr2YmDnJ", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 487112893, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TIMER", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": "{\"timerDuration\":\"120\",\"timerEndString\":\"Time's up!\",\"showTimerInSeconds\":false}", "activityId": 487111836, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "9sFYFHldi-YjQXO7pqjGN", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]