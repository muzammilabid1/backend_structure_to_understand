ableAlphabetData": null}, {"id": 226086239, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 1818, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Shuffle the cards and place them face down on the table.</li>\n<li>Turn one card face up and place it next to the pack.</li>\n<li>Player 1 predicts whether the next card will be <strong>higher</strong>, <strong>lower </strong>or <strong>the same.</strong></li>\n<li>Player 1 turns over the top card on the pack and checks their prediction.</li>\n<li>If they are correct, they keep the original card.</li>\n<li>If they are wrong the original card goes to the bottom of the pack.</li>\n<li>Player 2 then looks at the second card and makes a prediction.</li>\n<li>The winner has the most cards when the pack is finished.</li>\n</ol>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 51185600, "text": "A grid showing different fractions.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "higher_or_lower_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "higher_or_lower_image-01FSY5KBFDX873ESV1PC17H1JJ.png", "linkName": null, "stepType": "IMAGE", "tabsData":