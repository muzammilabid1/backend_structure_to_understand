[{"id": 35571534, "text": "<h2>Adverbs:</h2>\nperhaps, surely, maybe, obviously, clearly, possibly, undoubtedly, definitely, probably, not, certainly, impossibly\n<br></br>\n<h2>Modal Verbs:</h2>\nwould, should, could, may, can, shall, ought to, must, might\n<br></br>\n<br></br>\n<h2>What should I write about?</h2>\n<ul>\n<li>What the weather will be like this morning, this afternoon, tomorrow and the rest of the week.</li>\n<li>Any changes that could happen in the weather.</li>\n<li>If the weather might be different in different parts of the country.</li>\n<li>You can make the forecast up completely – it doesn’t have to be what will actually happen!</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35571485, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35571487, "text": "<h2>The Activity:</h2>\nChoose three adverbs and three modal verbs and use them to write a weather forecast.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633523621358_1image1-01FHASCHKW19VZPTDGSBKRNKEV.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35571485, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedByI