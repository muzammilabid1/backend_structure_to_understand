[{"id": 4223, "text": "<h2>Practise:</h2>\n<ol>\n<b><li>Practise saying the words. </b><dd>It will be better if you know the words off by heart because then you can concentrate on the performance.</dd></li>\n<b><li>Think about how to turn it into a performance. </b>\n            <ul>\n            <li>Speak (or sing) loudly and clearly (but without shouting);</li>\n            <li>Stand up tall to show you are ready to perform;</li>\n            <li>Think about any actions you could include.</li>\n            </ul>\n            </li>\n<b><li>Practise your performace. </b><dd>Go through it five or six times so that you are really confident with what you are doing.</dd></li>\n</ol>\n<br></br>\n<h2>Perform:</h2>\n<ol>\n<b><li>Find an audience. </b><dd>It could be one person, it could be your whole family, or you could even record your performance.</dd></li>\n<b><li>Perform your nursery rhyme.</b><dd>You could even take a bow when the audience is clapping!</dd></li>\n</ol>\n\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2885, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43138016, "text": "View nursery rhymes online", "modal": {"steps": [{"id": 43137647, "text": "Twinkle twinkle little star,\n<br>How I wonder what you are,\n<br>Up above the world so high,\n<br>Like a diamond in the sky,\n<br>Twinkle twinkle little star,\n<br>How I wonder what you are.\n", "order": 3