[{"id": 44558984, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44430818, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": "1638437055455_1download1-01FNX7A83P9GZAM89BJS24NTQJ.pdf", "editorState": null, "carouselData": null, "downloadName": "Apostrophe Cards Download", "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44559708, "text": "<h2>The Activity:</h2>\nPile up the cards face down. Turn over the top card and read the phrase on it aloud.\n<br></br>\n<ol>\n<li>Who does the thing belong to?</li>\n<li>Does it belong to <span style=\"color:#F28D00\">one</span> person/animal/object or <span style=\"color:#F28D00\">more than one</span>? </li>\n<li>How do you know?</li>\n</ol>\n<br>\nSort the cards into two piles – things that belong to <span style=\"color:#F28D00\">one</span> person/animal/object and things that belong to <span style=\"color:#F28D00\">more than one</span> person/animal/object.\n", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44430818, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44564970, "text": "Kittens and their mum with the text 'The kittens' and 'The kittens' mum'.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1638442650896_1image1-01FNXCM5FGEKAGQQBC24V6BB27.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44430818, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44566093, "text": "One or More - Solution", "modal": {"steps": [{"id": 44565240, "text": "<h2>One:</h2>\n<br>\nThere is one name before the apostrophe so it belongs to one person:\n<ul>\n<li><span style=\"color:#F28D00\">Jim’s bag</span> belongs to Jim;</li>\n<li><span style=\"color:#F28D00\">Tina’s tiger</span> belongs to Tina;</li>\n<li><span style=\"color:#F28D00\">Lady Carnarvon’s horse</span> belongs to Lady Carnarvon.</li>\n</ul>\n<br>\nThe word before the apostrophe is singular (there is one of it):\n<ul>\n<li><span style=\"color:#F28D00\">The boy’s shoes </span> belong to the boy;</li>\n<li><span style=\"color:#F28D00\">The bus’s wheels</span> belong to the bus;</li>\n<li><span style=\"color:#F28D00\">The baker’s cakes</span> belong to the baker;</li>\n<li><span style=\"color:#F28D00\">The man’s bicycle</span> belongs to the man;</li>\n<li><span style=\"color:#F28D00\">The planet’s atmosphere</span> belongs to the planet.</li>\n</ul>\n<br>\nThere is no apostrophe because ‘her’ is a possessive pronoun, which shows the socks belong to her:\n<ul>\n<li><span style=\"color:#F28D00\">Her socks</span> belong to her.</li>\n</ul>\n<br>", "order": 1, "btnType": null, "linkUrl": null, "modalId": 120, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44565420, "text": "<h2>More Than One:</h2>\n<br>\nThe word before the apostrophe is plural (there is more than one of it):\n<ul>\n<li><span style=\"color:#F28D00\">The cats’ basket</span> belongs to the cats;</li>\n<li><span style=\"color:#F28D00\">The girls’ pet</span> belongs to the girls;</li>\n<li><span style=\"color:#F28D00\">The donkeys’ carrots</span> belong to the donkeys;</li>\n<li><span style=\"color:#F28D00\">The brothers’ room</span> belongs to the brothers;</li>\n<li><span style=\"color:#F28D00\">The dinosaurs’ habitat</span> belongs to the dinosaurs;</li>\n<li><span style=\"color:#F28D00\">The babies’ toys</span> belong to the babies;</li>\n<li><span style=\"color:#F28D00\">The horses’ stables</span> belong to the horses.</li>\n</ul>\n<br>\nThe word before the apostrophe doesn’t end in ‘s’ but it is a plural noun so there is still more than one of it:\n<ul>\n<li><span style=\"color:#F28D00\">The mice’s hole</span> belongs to the mice;</li>\n<li><span style=\"color:#F28D00\">The cacti’s pot</span> belongs to the cacti;</li>\n<li><span style=\"color:#F28D00\">The women’s party</span> belongs to the women.</li>\n</ul>\n<br>\nThe Joneses are the people in a family whose surname is Jones, so there is more than one of them:\n<ul>\n<li><span style=\"color:#F28D00\">The Joneses’ house</span> belongs to the Joneses.</li>\n</ul>\n<br>\nIt belongs to us - us means me, you and maybe some other people too, so there is more than one of us:\n<ul>\n<li><span style=\"color:#F28D00\">Our picnic</span> belongs to us.</li>\n</ul>\n", "order": 2, "btnType": null, "linkUrl": null, "modalId": 120, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 120, "name": "One or More - Solution", "logCreatedAt": "2021-12-02T10:58:41.826288", "logUpdatedAt": "2021-12-02T10:58:41.826288", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44430818, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 120, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44559536, "text": "Apostrophes Reminder", "modal": {"steps": [{"id": 44559310, "text": "Sometimes a thing can belong to more than one person/animal:", "order": 3, "btnType": null, "linkUrl": null, "modalId": 119, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44559447, "text": "Kittens and their mum with the text 'The kittens' and 'The kittens' mum'.", "order": 4, "btnType": null, "linkUrl": null, "modalId": 119, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1638437437175_1image1-01FNX7MYFC61PD3CMEZDNJ913N.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44559279, "text": "A dog and a ball with the text 'The dog' and 'The dog's ball'.", "order": 2, "btnType": null, "linkUrl": null, "modalId": 119, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1638437323550_1image1-01FNX7J4G925ET8M2904B26JH9.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44559108, "text": "This activity is about using apostrophes when an object belongs to more than one person/animal. For example:", "order": 1, "btnType": null, "linkUrl": null, "modalId": 119, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44559486, "text": "Here, the apostrophe comes after the “s” because the “s” is an important part of “kittens”. If the apostrophe was before the “s”, the mum would belong to only one kitten.   ", "order": 5, "btnType": null, "linkUrl": null, "modalId": 119, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 119, "name": "Apostrophes Reminder", "logCreatedAt": "2021-12-02T09:24:54.27126", "logUpdatedAt": "2021-12-02T09:24:54.27126", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44430818, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 119, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44558916, "text": "<h2>You will Need:</h2>\nApostrophe cards (download below if you need to). You might also like to click the button for a reminder about apostrophes!\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44430818, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": nul