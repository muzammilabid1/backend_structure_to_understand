[{"id": 35485508, "text": "<h2>Tell your Story:</h2>\nWork together to tell the story, thinking about how to be imaginative and descriptive. \n<br></br>\nHere are some ideas to help you:\n<ul>\n<li>You could use bits from stories you already know, or even tell one you've heard before but add some things to it.</li> \n<li>You could use one of the story starter suggestion prompts below.</li> \n<li>It's a good idea to have some kind of structure in mind so you know how to move towards the ending. Make sure you include a problem in the middle that has to be solved! </li> \n<li>You could tell your story in another language that you speak together at home.</li> \n</ul>\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35485297, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 465755731, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35485297, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "Sd9HVB9h5-REBTTDS5_rn", "textEditorState": "<p><span style=\"font-size: 18px;font-family: SassoonInfantRg-Regular;\">Once upon a time, there was an enormous ogre who lived in a cavern deep in the darkest forest in the kingdom.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "fmtPumpfrSmmC1Xx6wgDh", "textEditorState": "<p><span style=\"font-size: 18px;font-family: SassoonInfantRg-Regular;\">Grelda had been walking in the woods for three days before she found the little cottage with the green door.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "_c-BAMr8oIC3xBJ6FrBBz", "textEditorState": "<p><span style=\"font-size: 18px;font-family: SassoonInfantRg-Regular;\">Busby leapt nimbly out of the window, climbed down the wall, and scampered across the yard to freedom.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "OQvrX1aR7UYXXX3IaT8I0", "textEditorState": "<p><span style=\"font-size: 18px;font-family: SassoonInfantRg-Regular;\">What an amazing day it had been! Well, amazing until grandma had set the boat on fire.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "e-PNS-7Gh2Y28uthk7EpT", "textEditorState": "<p><span style=\"font-size: 18px;font-family: SassoonInfantRg-Regular;\">If you’ve ever been given three wishes, you’ll know exactly what Micky asked for when the genie appeared from the lamp. </span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "8nA0Zm1J0PEfx9FKXeUYa", "textEditorState": "<p><span style=\"font-size: 18px;font-family: SassoonInfantRg-Regular;\">There was a strange silence in the city, only an old tin can rattling across the pavement, and Lenny wondered whether the hot summer sun had made everyone sleepy.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "dAtMoNK4aYTL7bcP7vkfu", "textEditorState": "<p><span style=\"font-size: 18px;font-family: SassoonInfantRg-Regular;\">Ruby drew her sword and stepped out though the castle gates.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "8P0pxpQNBvaDvaVLxI7TX", "textEditorState": "<p><span style=\"font-size: 18px;font-family: SassoonInfantRg-Regular;\">The landing pod lowered its wheels and the thrusters slowly pushed it towards the dusty surface of the planet below.</span></p>\n", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "UptG5WXV-xhUg8dYOhaU0", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 465755653, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35485297, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Here are some ways you could start your story:</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "PtdRark0sxB-0jkduaUPO", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35485366, "text": "<h2>Getting ready:</h2>\nBuild yourself a campfire (you could go all-out and have a real one, make something from objects in your house, or collect sticks to make a pretend one inside or outside). To really set the scene, you could have a hot chocolate. \n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633446316990_1image1-01FH8FRW1S9Q7NJ6STSYDE9DQ0.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35485297, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]