[{"id": 43142135, "text": "<h2>What to do:</h2>\nChoose a story or poem to perform. It can be one from a book or one you know in your head. Here are some suggestions of stories in books:\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 3116, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4224, "text": "Practising and performing a story can be really fun - when you're still working on phonics, reading a story can be hard work, but if you look at it lots of times together and you start to learn the words, suddenly you can 'read' a story by yourself!", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 3116, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43142239, "text": "If the story is new to your child:\n<ol>\n<li>Read the story aloud to your child.</li>\n<li>Re-read the story several times - can they start to finish the sentence, e.g. if you leave the rhyming word off the end?</li>\n<li>Re-read the story again - can they do some more of the words?</li>\n</ol>\n<br></br>\nIf the story is already familiar to your child:\n<ol>\n<li>Read the story aloud to your child - can they finish any of the sentences, e.g. if you leave the rhyming word off the end?</li>\n<li>Read the story again - see how many of the words they already know and practise saying them together.</li>\n<li>See how much of the story your child can tell by themself - they can use the pictures in the book to help, and you can read any of the words they're not sure about!</li>\n</ol>\n<br></br>\n<h2>Some more things to think about:</h2>\n<ul>\n<li>Speak loudly and clearly (but without shouting);</li>\n<li>Think about how you could use your body in the performance - you could do actions, or even act out what is happening;</li>\n<li>Think about how to use the volume of your voice - some parts could be louder or softer;</li>\n <li>Think about how to use the tone of your voice - you could change how you talk to show how it is exciting, scary or funny.</li>\n<li>You can do the performance together - it doesn't just need to be your child performing on their own!</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 3116, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43142283, "text": "Stories We Enjoy Performing", "modal": {"steps": [{"id": 43143812, "text": "Front covers of books listed", "order": 2, "btnType": null, "linkUrl": null, "modalId": 85, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1637667922116_1image1-01FN69T5BG7E81RE1AGRRKMWRR.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43143855, "text": "We like these books for performing because they are stories that are written like poems. Other books by the same authors are also worth looking at!\n<br></br>\nYou can also find videos online of these stories being performed, which can be fun to watch!", "order": 3, "btnType": null, "linkUrl": null, "modalId": 85, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43141082, "text": "You might have one of these books at home, but they should also be easy to find in your local library:\n<ul>\n<li>'Hairy Maclary from Donaldson's Dairy' by Lynley Dodd</li>\n<li>'We're Going on a Bear Hunt' by Michael Rosen</li>\n<li>'The Gruffalo' by Julia Donaldson</li>\n<li>'Each Peach Pear Plum' by Janet and Allan Ahlberg</li>\n</ul>\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 85, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 85, "name": "Stories We Enjoy Performing", "logCreatedAt": "2021-11-23T11:01:38.0164", "logUpdatedAt": "2021-11-23T11:31:03.267054", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 4, "btnType": "PRIMARY", "li