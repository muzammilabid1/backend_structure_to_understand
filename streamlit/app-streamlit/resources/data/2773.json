[{"id": 3871, "text": "Pick a recipe in a book (or use the example one here). <br> </br>Can you scale it up so it feeds more people? Can you scale it down so it feed half the number of people? <br> </br>Make sure you keep all the ingredients in the same ratio! <br> </br>\n\nWhy not make some pancakes using the recipe? Scale it for the number of people in your family.\n\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "img_step_picture_03871.jpg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2773, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 117144509, "text": "Kitchen Safety", "modal": {"steps": [{"id": 117140949, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 219, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Cooking is great fun for children, but remember to talk to them about how to stay safe in the kitchen.   Adults should always supervise children when cooking.</p>\n<p>Safety rules might include:</p>\n<ul>\n<li>Always ask an adult before you cook.</li>\n<li>Ask an adult if you need boiling water or a hot oven.</li>\n<li>Ask an adult to supervise when you use a knife.</li>\n<li>Move carefully in the kitchen - don't run around.</li>\n<li>Wipe up any spills straight away so noone slips.</li>\n</ul>\n<p></p>\n<p>Hygiene rules might include:</p>\n<ul>\n<li>Wash your hands with soap and water.</li>\n<li>Wipe down work surfaces before you start.</li>\n<li>Tie back long hair and wear and apron if you have one.</li>\n<li>If you lick your fingers, wash your hands again.</li>\n<li>Keep cooked and uncooked food separate. Be especially careful with raw meat and fish.</li>\n<li>Ask an adult to check everything is properly cooked before you eat it.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 219, "name": "Kitchen Safety", "logCreatedAt": "2023-06-20T14:10:02.751387", "logUpdatedAt": "2023-06-20T14:10:02.751387", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": null}}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2773, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 219, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCa