[{"id": 120906605, "text": "761794934", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2961, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43151527, "text": "<h2>Discuss:</h2>\nAsk your child what exclamation marks are for. They should think about exclamation marks in any writing, not just this book. Here are some things exclamation marks are for:\n<ul>\n<li>When something is surprising;</li>\n<li>When something is angry;</li>\n<li>When something is loud;</li>\n<li>When something is forceful;</li>\n<li>When something is amazing;</li>\n<li>Most importantly, they are used in writing to help make the meaning really clear.</li>\n</ul>\n<br></br>\n<h2>Activity:</h2>\nChoose one sentence which ends with an exclamation mark. \n<ul>\n<li>How should you read the sentences with an exclamation mark at the end? </li>\n<li>Read the sentence aloud. Can we hear the exclamation mark in your voice?</li>\n<li>Practise reading the sentence several times, so it sounds really smooth and fluent, and we can hear what the exclamation mark is doing.</li>\n<li>If you need to, the adult could read the sentence with the exclamation mark for the child to copy.</li>\n<li>Try reading some more sentences with exclamation marks, thinking about what the exclamation mark is telling you to do.</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2961, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4012, "text": "<h2>Warmup:</h2>\nLook through a book you are reading and see if you can find any exclamation marks. How many can you find?", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2961, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]