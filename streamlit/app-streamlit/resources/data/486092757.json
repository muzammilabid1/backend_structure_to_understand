[{"id": 527920722, "text": "A photograph of the front cover of 'The Boy with the Bronze Axe' by Kathleen Fidler. The background is a dark colour, with a crack running across that suggests it could be stone. There are prehistoric-looking orange stick figures drawn on the background. There is a wooden-handled bronze age, with a carved, curved head in a prominent position in the bottom half of the cover. The title is written in large pale letters, and the author name is written in smaller orange letters.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Book cover The Boy with the Bronze Axe blob", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Book cover The Boy with the Bronze Axe blob-K4z5Jp-mF9cKGzMVkl63y.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 486092757, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "ZXLVJ6Nro2W9jafQ3fWL_", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 487111315, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':