[{"id": 478532371, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 478530793, "dimensions": null, "editAsHtml": true, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<ol>\n<li>Follow your recipe. Before you put it in the oven, describe what your cake/bread looks like.</li>\n<li>When you get your cake/bread out of the oven, describe how it has changed.</li>\n<li>Talk about these questions together:</li>\n<ul>\n<li>What would it have been like to eat it before it was cooked?</li>\n<li>How did putting the mixture in the hot oven change it?</li>\n<li>What was it like to eat?</li>\n<li>Could you do anything to turn your cooked cake/bread back into the separate ingredients you started with?</li>\n</ul>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "mEkJXOW4-1Hd7bE9Z6Tvt", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 478530952, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 478530793, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You will need:</h2>\n<ul>\n<li>A recipe for baking some kind of cake or bread (you could use the soda bread recipe below or choose your own)</li>\n<li>Ingredients and equipment for following your recipe</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "B2Pyg9aVKRKLFtdlc6JJd", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 478531915, "text": "Soda bread recipe", "modal": {"steps": [{"id": 478532229, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 420, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2 style=\"text-align:center;\">by Jack Monroe</h2>\n<p>Makes 1 small loaf that will serve 6</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "4Ozhw5revvZgQ0DexHPCf", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 478532268, "text": null, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "modalId": 420, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Equipment:</h2>\n<ul>\n<li>Two bowls</li>\n<li>Measuring spoons</li>\n<li>Wooden spoon</li>\n<li>1lb loaf tin <span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">(approximately 17 x 7 x 6cm)</span>&nbsp;</li>\n<li>Sharp knife (for adult use)</li>\n<li>Cooling rack</li>\n</ul>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "jLaIjFNTzuiw7mFBWiJi3", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 478532252, "text": null, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 420, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Ingredients:</h2>\n<ul>\n<li>Juice of ½ a lemon or 2 teaspoons bottled lemon juice</li>\n<li>300ml milk</li>\n<li>400g self-raising flour plus extra to shape the dough and dust the loaf</li>\n<li>1½ level teaspoons bicarbonate of soda</li>\n</ul>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "5a0nitNBT-k3qB1NVuUHu", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 478532287, "text": null, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "modalId": 420, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Method:</h2>\n<ol>\n<li>Preheat the oven to 180°C/350°F/gas 4.&nbsp;</li>\n<li>Squeeze the lemon juice into the milk. Stand to one side for about 5 minutes to allow the liquid to curdle and separate.&nbsp;</li>\n<li>Meanwhile, weigh the flour into a bowl, add the bicarbonate of soda and mix through.&nbsp;</li>\n<li>Make a well in the centre of the flour and pour in most of the milk-and-lemon mixture. Mix well with a wooden spoon to form a sticky dough. Use your judgement – if it looks too dry, add the remaining liquid.&nbsp;</li>\n<li>Tip the dough on to a floured work surface and pat into a round shape, kneading ever so lightly. The trick to amazingly light soda bread is not to fiddle with it too much.&nbsp;</li>\n<li>Pop the shaped dough into the loaf tin, score a line on top of the dough down the middle about 1cm deep with a sharp knife and dust with a little extra flour.&nbsp;</li>\n<li>Place in the preheated oven for 40 minutes.&nbsp;</li>\n<li>Once baked through, the loaf should sound hollow on the bottom when tapped and feel ridiculously light.&nbsp;</li>\n<li>Remove the tin from the oven, tip out the soda bread whilst hot and leave to cool on a wire rack.&nbsp;</li>\n<li>Break into chunks and serve warm with butter, or allow to cool completely then wrap in cling film to keep fresh.</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "GVoLAkvm5O8HE9FPsZklg", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 420, "name": "Soda bread recipe", "logCreatedAt": "2024-11-04T12:06:28.667859", "logUpdatedAt": "2024-11-04T12:06:28.667859", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": "Soda bread recipe for describing topic"}}, "order": 3, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 478530793, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 420, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "Foh7vLp