, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "SF2VIzKVuQeUbWHcHNO1u", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 350913710, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 350913139, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<p>Interview a parent or another adult about how money has changed in their lifetime.</p>\n<p>Questions you could ask:</p>\n<ul>\n<li>When you were a child, did you use any coins or notes that we don't have any more?</li>\n<li>Were there ways to pay that we don't use any more?</li>\n<li>Did money look or feel different?</li>\n<li>How did you pay in shops?</li>\n<li>Did you get pocket money? How much?</li>\n<li>What did you spend it on?</li>\n<li>How much did a chocolate bar cost when you were a child?</li>\n<li>How did you get paid for your first job?</li>\n</ul>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "np0jMTw-jdBOlOMaw3Ove", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]