[{"id": 37826697, "text": "In this game, players win points by listing things in different categories. ", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1634637265138_1image1-01FJBZJ1S4SVF4KBVGG8T1AYTS.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 37826584, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 37826987, "text": "<h2>How to Play:</h2>\n<ol>\n<li>Decide how many rounds you want to play.\n <br>Five can be a good number.</li>\n<li>Choose a category (specific or general but not too broad).\n <br>E.g. car brands, Harry Potter novels, cow breeds, English counties…</li>\n<li>Take it in turns to bid how many you think you can name. \n <br>If you are not sure how to bid, see the example below!</li>\n<li>The person who makes the highest bid gets two minutes to name as many as they can. </li>\n<li>If they say the same number or more than they bid, they get, 3 points. If they don't, the other player gets 1 point. </li>\n<li>Choose a new category for each new round.</li>\n<li>The person with most points at the end of all the rounds wins!</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 37826584, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43445065, "text": "Example List It Game!", "modal": {"steps": [{"id": 43443223, "text": "Let’s play five rounds. \n<br></br>\n<h2>Round 1:</h2>\nOur category is <b>Disney films</b>.\n<br></br>\n<b>Bidding:</b>\n<ul>\n<li>Player 1: I can name four films.</li>\n<li>Player 2: Raise – I can do five films.</li>\n<li>Player 1: Raise – I can do six.</li>\n<li>Player 2: Raise – eight!</li>\n<li>Player 1: I can’t do more than eight! I pull out. You can try eight!</li>\n</ul>\nPlayer 2 won the bidding!\n<br></br>\n<b>Listing:</b>\n<br>Because Player 2 won the bidding with eight, they have two minutes to name eight Disney films.\n<ol>\n<li>Mulan</li>\n<li>Brave</li>\n<li>Frozen</li>\n<li>Tangled</li>\n<li>Lion King</li>\n<li>Tarzan</li>\n<li>Cinderella</li>\n<li>…</li>\n</ol>\nUnfortunately, Player 2 only managed to name seven Disney films, so Player 1 gets one point! (Player 2 would have got three points if they had thought of eight).\n<br></br>\n<h2>Round 2:</h2>\nChoose a new category, make your bids, and do your list! \n<br></br>\nKeep playing until you have done all five rounds, then see who has the most points!", "order": 1, "btnType": null, "linkUrl": null, "modalId": 99, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 99, "name": "Example List It Game!", "logCreatedAt": "2021-11-25T10:39:31.378734", "logUpdatedAt": "2021-11-25T10:39:31.378734", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 37826584, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 99, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]