[{"id": 58429075, "text": "Written neatly on lines Aa Bb Cc... to Zz and 0-9.", "modal": {"steps": [null], "details": null}, "order": 7, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "sampler_letters_and_digits_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "sampler_letters_and_digits_image-01FXMFE1636JK4FPK01VDFNR2T.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 58425390, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 58426314, "text": null, "modal": {"steps": [null], "details": null}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 58425390, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size: 24px;font-family: Chaloops-Medium;\">What to Do:</span></p>\n<ol>\n<li>Start by checking you know which space you are leaving empty for the border. Don’t write anything in this space until the end!</li>\n<li>At the left end of the top line, write an upper-case <span style=\"font-family: SassoonInfantRg-Regular;\">A</span>.</li>\n<li>Next to A, without a space, write a lower-case <span style=\"font-family: SassoonInfantRg-Regular;\">a</span>.</li>\n<li>Leave a space (about the same size you would write a letter <span style=\"font-family: SassoonInfantRg-Regular;\">m</span>).</li>\n<li>Write <span style=\"font-family: SassoonInfantRg-Regular;\">Bb</span>.</li>\n<li>Keep going through the alphabet (going onto a new line whenever you need to) until you have written <span style=\"font-family: SassoonInfantRg-Regular;\">Zz</span>.</li>\n<li>Write the digits <span style=\"font-family: SassoonInfantRg-Regular;\">0-9</span>.</li>\n<li>If you have any space left, you could fill the space by repeating the alphabet or carefully drawing a picture. Victorian children also used to put their name and the date in their sampler. Sometimes they even included a short poem or verse from a longer poem (you could copy some lines from your favourite poem).</li>\n<li>Decorate your border. There are some ideas below.</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 58426167, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "letter_formation_pdf", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 58425390, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": "letter_formation_pdf-01FXMCT18DF0JX9CMEGT55Y3G4.pdf", "editorState": null, "carouselData": null, "downloadName": "Letter Formation pdf", "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 58426043, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": "sampler_template_pdf", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 58425390, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": "sampler_template_pdf-01FXMCMQGWR77F6PTH0H0YFGA3.pdf", "editorState": null, "carouselData": null, "downloadName": "Sampler Template pdf", "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 58425848, "text": "<h2>You Will Need:</h2>\n<ul>\n<li>Sampler template (or use the template to draw your own on a plain piece of paper);</li>\n<li>A sharp pencil (or a pen you can write really neatly with);</li>\n<li>You might also want to remind yourself of the letter formation instructions by clicking the button below.</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 58425390, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 58425764, "text": "Two examples of sew Victorian samplers. The letters are stitched in neat lines. One is decorated with colourful patterns, the other is black and white.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "sampler_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "sampler_image-01FXMCDEZGT2TXSVRY51G8NWY8.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 58425390, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 58425444, "text": "In this activity, you will be making a Victorian-style letter and number sampler. Children used to sew samplers to show off their needlework skills. Don’t worry though, this activity doesn’t involve sewing (unless you’re really keen) – it’s a chance to show off your beautiful handwriting instead!", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 58425390, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 58429119, "text": "Border Pattern Ideas", "modal": {"steps": [{"id": 58428942, "text": "Three lines of patterns - alternating capital and lower-case 'c' joined together, W joined with alternating high and low peaks, and li alternating joined and without the i dot.", "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 159, "audioUrl": null, "fileName": "border_patterns_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "border_patterns_image-01FXMF53NSNYEM4P9GTVQ4N251.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": 