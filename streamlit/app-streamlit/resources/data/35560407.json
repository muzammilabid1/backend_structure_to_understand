[{"id": 36457712, "text": "<h2>Extra rules:</h2>\n<ul>\n<li>You can't do a word ending x as the first word.</li>\n<li>You can't repeat any words.</li>\n<li>They must be real words.</li>\n</ul>\n<br><br>\n<h2>Example game:</h2>\nCategory: countries\n<br>\nPlayer 1: Mexico\n<br>\nPlayer 2: Oman\n<br>\nPlayer 1: Nigeria\n<br>\nPlayer 2: Andorra\n<br>\nPlayer 1: Argentina\n<br>\nPlayer 2: Afghanistan\n<br> \nPlayer 1: Norway\n<br>\nPlayer 2: Y… Y… I’m stuck!\n<br>\nPlayer 1: I win!\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35560407, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35560424, "text": "<h2>How to play:</h2>\n<ol>\n<li>Pick a category (countries, cities, boys' names, animals, birds, 3 letter words,  etc).</li>\n<li>Player 1 says a word in that category.</li>\n<li>Player 2 says a word (in the category) that begins with the last letter of the previous word.</li>\n<li>Keep going until someone can't think of a word.</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633944275510_1image1-01FHQANN98NYQ57NH425WME2ST.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35560407, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]