ow2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2318, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "Y573XsvzC5fwb_tN5J46y", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 120805273, "text": null, "modal": {"steps": [null], "details": null}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2318, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Challenge:</h2>\n<p>Use your ten bottles to play a game of skittles.</p>\n<ol>\n<li>Set the skittles up together.&nbsp;</li>\n<li>Then, ask your child to roll or throw the ball at the skittles.&nbsp;</li>\n<li>Ask them to count how many they have knocked over. Then, ask them to count how many are still standing. Finally, ask them to count how many bottles there are overall.&nbsp;&nbsp;</li>\n<li>Pick the bottles back up and repeat the activity, taking it in turns with your child to throw the ball.&nbsp;</li>\n<li>Play as many times as you like to practise counting numbers within ten!&nbsp;</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 120804910, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2318, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<ol>\n<li>Line up the bottles.</li>\n<li>Help your child to sing the song.&nbsp;</li>\n<li>At the end of each verse, ask your child to knock a bottle over.&nbsp;</li>\n<li>By the end of the song, there should be no bottles left.&nbsp;</li>\n<li>Repeat the activity to help your child learn the song!</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]