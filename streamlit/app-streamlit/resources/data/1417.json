[{"id": 226097030, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": "Nrich Totality for Two", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 1417, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": "Nrich Totality for Two-T2mFvyeRKF9RFZUWn_PJO.pdf", "editorState": null, "carouselData": null, "downloadName": "Printable game board", "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 199606134, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 1417, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>There are video instructions and tips on the nrich website.</p>\n<p>If you need them, the rules are also written below.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 1727, "text": "To develop your problem-solving skills further try this task on the NRICH website:", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "Y2 number bonds to 20 totality image-oz4KtgrsCQkpgazyfJBN_.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 1417, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 1728, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": "https://nrich.maths.org/11114", "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": "Totality for Two game on nrich", "stepType": "LINK", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 1417, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 226097022, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 1417, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You'll need:</h2>\n<ul>\n<li>A small item to use as a counter.</li>\n<li>A copy of the game board.</li>\n</ul>\n<p>If you haven't been given one, you can print or copy on below.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 199603367, "text": "Rules ", "modal": {"steps": [{"id": 199603294, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 277, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p style=\"text-align:start;\"><span style=\"font-family: Chaloops-Medium;\"><strong>The aim of the game:</strong></span><br><br>To make a chosen total by sliding the counter around the board, adding on numbers as you go.</p>\n<p>The winner is the one who makes the move that reaches the total.</p>\n<p><br><span style=\"font-family: Chaloops-Medium;\"><strong>How to play:</strong></span><br><br><span style=\"color: rgb(64,64,64);background-color: rgb(252,252,252);font-size: medium;font-family: Verdana;\">1. Choose a target to reach. This is the total both of you are trying to make.</span></p>\n<p><span style=\"color: rgb(64,64,64);background-color: rgb(252,252,252);font-size: medium;font-family: Verdana;\">2. Player 1 places their counter on the game board over one of the numbers and says that number.</span></p>\n<p style=\"text-align:start;\"><span style=\"color: rgb(64,64,64);background-color: rgb(252,252,252);font-size: medium;font-family: Verdana;\">3. Player 2 moves the same counter in any direction along a line  to a number and says the total of the two numbers.</span></p>\n<p style=\"text-align:start;\"><span style=\"color: rgb(64,64,64);background-color: rgb(252,252,252);font-size: medium;font-family: Verdana;\">4. Player 1 moves the same counter to cover another neighbouring number, adds on that number, and says the 'running' total of the three numbers.</span></p>\n<p style=\"text-align:start;\"><span style=\"color: rgb(64,64,64);background-color: rgb(252,252,252);font-size: medium;font-family: Verdana;\">5. Keep sliding and adding until the total is reached.</span><span style=\"font-family: Verdana;\"><br><br></span><span style=\"color: rgb(64,64,64);background-color: rgb(252,252,252);font-size: medium;font-family: Verdana;\">6. Players must move when it is their turn.</span><span style=\"font-family: Verdana;\"><br><br></span><span style=\"color: rgb(64,64,64);background-color: rgb(252,252,252);font-size: medium;font-family: Verdana;\">7. No 'jumping' is allowed.</span></p>\n<p><span style=\"color: rgb(64,64,64);background-color: rgb(252,252,252);font-size: medium;font-family: Verdana;\">8. If you go over the target number, you've lost!</span></p>\n<p style=\"text-align:start;\"><span style=\"font-family: Verdana;\"> </span></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 277, "name": "Totality for Two", "logCreatedAt": "2023-11-14T15:10:39.921993", "logUpdatedAt": "2023-11-14T15:10:39.921993", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": null}}, "order": 6, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 1417, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 277, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]