[{"id": 371043929, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 581, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Nice or nasty?</h2>\n<ul>\n<li>In the friendly version you can only write numbers on your board.</li>\n<li>In the nasty version you can also write numbers on the other player's board.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "DFGDdv9R5sQdWkB9bN9yU", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 371048452, "text": "How do maths games help with learning?", "modal": {"steps": [{"id": 324071304, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 316, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Fun</h2>\n<p>Games can be an enjoyable, motivating way to practice a skill many times.</p>\n<p></p>\n<h2>Positive feelings</h2>\n<p>Having fun together encourages positive feelings towards maths and can reduce worry about making mistakes.</p>\n<p></p>\n<h2>Memory</h2>\n<p>Skills that are practiced when a child is fully engaged and relaxed are more likely to be remembered.</p>\n<p></p>\n<h2>Number sense</h2>\n<p>In trying to win, children really think about the numbers they choose. This builds number sense - a deeper, more flexible understanding of numbers.</p>\n<p></p>\n<h2>Problem solving</h2>\n<p>Finding strategies to win develops problem solving skills.</p>\n<p></p>\n<h2>Mathematical Vocabulary</h2>\n<p>Talking about a game or explaining it to someone else encourages children to use mathematical vocabulary.</p>\n<p></p>\n<h2>Deeper thinking</h2>\n<p>Changing a rule and talking about how that impacts a game encourages an even deeper level of thinking.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "lSemXJT2fEci8gnLBBGXj", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 316, "name": "How do maths games help with learning?", "logCreatedAt": "2024-05-15T09:35:21.09224", "logUpdatedAt": "2024-05-15T09:45:50.488775", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": "Rationale for maths games"}}, "order": 7, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 581, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 316, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "klzNMT7PGTSBuAlngYJ3N", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 371043717, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 581, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<ul>\n<li>Each player draws their board - a set of 3 squares like the one above.</li>\n<li>Players take it in turns to roll the dice and write the number.</li>\n<li>You can choose to write it as a hundred, ten or one.&nbsp;</li>\n<li>The aim of the game is to make the biggest number.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "SMSjs4HJ1LsGPAae2fEra", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 371043699, "text": "2 rectangle divided into 3 parts with H, T and O written at the top.", "modal": {"steps": [null], "details": null}, 