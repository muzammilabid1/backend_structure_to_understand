[{"id": 4077, "text": "<h2>Aim of the game:</h2>\nListen carefully to the end of a word to work out if it is <span style=\"color:#F28D00\">singular</span> or <span style=\"color:#F28D00\">plural</span>.\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2943, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 91195958, "text": "762291036", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2943, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40605515, "text": "Example Game", "modal": {"steps": [{"id": 40603430, "text": "Player 1: \"Shoes.\"\n<br><i>Player 2 points to two shoes.</i>\n<br>Player 2: \"I knew it was <span style=\"color:#F28D00\">plural</span> because you said 'shoes' not 'shoe'.\"\n<br></br>", "order": 1, "btnType": null, "linkUrl": null, "modalId": 21, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1636367489620_1image1-01FKZHMJZWG7KDRHV0DKD8SJR4.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 21, "name": "Example Game", "logCreatedAt": "2021-11-08T10:29:34.781814", "logUpdatedAt": "2021-11-08T10:29:34.781814", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 2943, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 21, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40602998, "text": "You can play this game anywhere! If you use a whole room, house, or even outside, you can use the objects you see around you (instead of setting it up at a table in advance).\n<br></br>\n<h2>How to play:</h2>\n<ol>\n<li>Player 1 names an object(s) they can see, e.g. 'spades'.</li>\n<li>Player 2 listens carefully to the ending of the word:\n<ul>\n<li>If the word has <b>s</b> or <b>es</b> at the end, that means 'more than one'.</li>\n<li>If the word has no extra ending, that means 'one'.</li>\n</ul>\n<li>Player 2 points at the object(s). </li>\n<li>Player 2 then says whether the word was <span style=\"color:#F28D00\">singular</span> or <span style=\"color:#F28D00\">plural</span> and how they knew.</li>\n<li>Take turns so you both get several goes at saying and hearing different endings.</li>\n</ol>\n<br></br>\n<h2>Important:</h2>\nYou must only say a one-word clue. Say 'shoe' not 'a shoe' because the 'a' gives away that it is <span style=\"color:#F28D00\">singular</span> without having to listen to the end of the word.", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 2943, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40606594, "text": "What do 'singular' and 'plural' mean?", "modal": {"steps": [{"id": 40606509, "text": "<span style=\"color:#F28D00\">Singular </span> when the word is one of something, e.g. 'cat'.\n<br></br>\n<span style=\"color:#F28D00\">Plural </span> when the word is more than one of something, e.g. 'cats'.", "order": 1, "btnType": null, "linkUrl": null, "modalId": 22, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 22, "name": "What do 'singular' and 'plural' mean?", "logCreatedAt": "2021-11-08T10:56:29.143637", "logUpdatedAt": "2021-11-08T10:56:29.143637", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 2943, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 22, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 42151213, "text": "My word changed in a different way...", "modal": {"steps": [{"id": 40602235, "text": "Well done for spotting this! \n<br></br>\nSometimes the ending might change in a different way, but we are mainly working on 's' and 'es'. \n<br></br>\nSometimes the whole word can change (e.g. a 'tooth' and some 'teeth'), and sometimes it doesn't change at all (e.g. a 'sheep' and some 'sheep'). It is good to notice and talk about these too, but they are not the focus of this game.", "order": 1, "btnType": null, "linkUrl": null, "modalId": 20, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 20, "name": "My word changed in a different way...", "logCreatedAt": "2021-11-08T10:10:49.238708", "logUpdatedAt": "2021-11-08T10:10:49.238708", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2943, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 20, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]