[{"id": 45262468, "text": "<h2>The Game:</h2>\n<ol>\n<li>Spread the cards face down on the table.</li>\n<li>Player 1 turns over two cards. </li>\n<li>If the two cards can be put together to make a compound word, Player 1 can keep them and have another go. </li>\n<li>If the two cards don’t go together, turn them back over and Player 2 has a go.</li>\n<li>Keep turning over cards and matching pairs until all the cards have been collected.</li>\n<li>The person with the most cards at the end wins!</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45262098, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45262220, "text": "<h2>You will Need:</h2>\nCompound word cards (click the button to download if you have not been sent home any from school). Cut out along the dotted lines.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45