[{"id": 35615600, "text": "<h2>How to Play:</h2>\n<ol>\n<li>Cut out your word cards.</li>\n<li>Can you spot what is missing from the words? Hyphens!</li>\n<li>Think about where the missing hyphens should go.</li>\n<li>Using your scissors, cut each word in two between the letters where the hyphen should go!</li>\n<li>Draw hyphens on your scraps of paper and put them in the spaces in your words!</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35615524, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40835528, "text": "Remind me what hyphens are for...", "modal": {"steps": [{"id": 40835476, "text": "Hyphens can be used to join a prefix to a root word. \n<br></br>\nThis is especially important if the prefix ends in a vowel letter and the root word also begins with one. \n<br></br>\nFor instance, ‘re-enter’ means ‘enter again’ and the hyphen stops it looking like it contains an ‘ee’ sound (‘reenter’ looks really odd).", "order": 1, "btnType": null, "linkUrl": null, "modalId": 41, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "