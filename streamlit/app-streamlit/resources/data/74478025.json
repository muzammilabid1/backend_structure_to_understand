[{"id": 74481728, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74478025, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<p>Go for a walk in your local area and look at how different things are moving around. Look at your I-spy sheet and tick off anything you see!</p>\n<p>Here are some types of things you might see:</p>\n<ul>\n<li>People</li>\n<li>Animals</li>\n<li>Vehicles</li>\n<li>Plants</li>\n<li>Water</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74478575, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74478025, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2><span style=\"font-family: Chaloops-Medium;\">You will need:</span></h2>\n<ul>\n<li><span style=\"font-family: Verdana;\">An I-spy sheet (download below)</span></li>\n<li><span style=\"font-family: Verdana;\">Something to write with</span></li>\n</ul>\n<p><span style=\"font-family: Verdana;\">You will also need to go for a short walk around your local area. If you don't want to go out, you could try the activity at home and act out any adverbs you can't find!</span></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 81337797, "text": "Outdoor safety", "modal": {"steps": [{"id": 78250991, "text": "Remember to talk to your child about how to keep themselves safe in public places. Be extra careful on roads and always stay in sight of your grown up.\n\n", "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 182, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 182, "name": "Outdoor Safety", "logCreatedAt": "2022-08-11T15:05:20.226248", "logUpdatedAt": "2024-04-24T09:52:02.439406", "logCreatedById": 77349474, "logUpdatedById": 77349474, "nameForContentDev": "Outdoor safety (minus Clever Never Goes