[{"id": 388080005, "text": "A football in long grass", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Football in long grass", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Football in long grass-vVSDNlQk4Qudo3bYPdAzi.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 359572854, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "MYLPNpTLpXvwRNDS5Xhnk", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 388075095, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 359572854, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p style=\"text-align:center;\"><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\"><strong><ins>Ball in the long grass</ins></strong></span></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">All our legs are swishing through the grasses in the park</span></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">Where did the ball go?</span></p>\n<p style=\"text-align:start;\"></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">Ted, the dog, crashes through the undergrowth</span></p>\n<p style=\"text-align:start;\"><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">But he's found a squirrel not the ball</span></p>\n<p style=\"text-align:start;\"><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">And as he barks his way into the bushes</span></p>\n<p style=\"text-align:start;\"><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">The squirrel rushes upwards and bounds away through the branches</span></p>\n<p style=\"text-align:start;\"><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">Which sway and rustle as it passes.</span></p>\n<p style=\"text-align:start;\"></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">Little sister Mina is toddling round in circles</span></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">The grass almost up to her chin</span></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">Chuckling as the tops tickle</span></p>\n<p style=\"text-align:start;\"><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">Giggling as she bustles on</span></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">Ball completely forgotten.</span></p>\n<p></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">But I haven't forgotten</span></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">And I saw how we kicked the ball</span></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">And it soared high in the clear blue sky</span></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">And fell with a thud in the grass just over there</span></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">So I push my way on through the swishing grass.</span></p>\n<p></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">And when I see it lying there, I grab it,</span></p>\n<p><span style=\"color: rgb(71,85,119);background-color: rgb(255,255,255);font-size: 18px;font-family: SassoonInfantRg-Regular;\">And hoof it back into the game.</span></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "Kaqlz_1wShp9BBJySGymD", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 388074597, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 359572854, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<p>Read the poem below (or another poem that includes onomatopoeia, e.g. Spike Milligan's 'On the Ning Nang Nong').</p>\n<ul>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Which onomatopoeia words can you spot?</span></li>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Why did the poet choose these words? You might think of more than one possible reason!</span>&nbsp;</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "WBF1E_0fWrSCj9B08lhki", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]