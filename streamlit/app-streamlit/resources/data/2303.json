[{"id": 120811738, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2303, "dimensions": null, "editAsHtml": true, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Show your child some bunny ears (like in the picture above) - hold up two fingers on each hand.</li>\n<li>Ask these questions:&nbsp;</li>\n<ul>\n<li>How many fingers am I holding up on this hand?&nbsp;</li>\n<li>How many fingers am I holding up on the other hand?</li>\n<li>How many fingers am I holding up altogether?</li>\n</ul>\n<li>Give your child a number between 0 and 4.</li>\n<li>Ask them to make bunny ears using that number of fingers on one hand and whatever adds to it to make 4 on the other hand.</li>\n<li>Repeat with other numbers 0-4 (always with a total of 4). Your child could challenge you to make ears too!\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 330363713, "text": "875920423", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "tim