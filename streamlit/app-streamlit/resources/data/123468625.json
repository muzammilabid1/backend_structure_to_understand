[{"id": 123479295, "text": "Other ways to practice writing numbers", "modal": {"steps": [{"id": 123478866, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 231, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2 style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-family: Chaloops-Medium;\">Other ideas to practice number writing:</span></h2>\n<ul>\n<li style=\"margin-left:1.5em;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Rainbow writing - write a number in one colour.  Keep going over it in different colours until you have a rainbow number.</span></li>\n<li style=\"margin-left:1.5em;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Draw a row of houses and give them numbers.</span></li>\n<li style=\"margin-left:1.5em;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Make a board game.  Draw a number track and fill in numbers on each square.  Roll a dice and move your counter.</span></li>\n<li style=\"margin-left:1.5em;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Event countdown -  before a fun event, make a countdown chart showing how many days to go.  Each day cross off one number.</span></li>\n</ul>\n<p style=\"text-align:start;\"><br>&nbsp;</p>\n", "carouselData": null, "downloadName