[{"id": 40997403, "text": "<h2>How to play:</h2>\n<ol>\n<b><li>Choose who is starting first.</b><dd>If you have never played before, the adult should go first.</dd></li>\n<b><li>The first person chooses something they can see. </b><dd>Don't tell the other person what it is!<dd></li>\n<b><li>The first person says<span class=\"mwp-orange\"> I spy with my little eye something beginning with </span>\"ch\".</b><dd>Remember to say the phoneme (sound) at the beginning of the word you have chosen.</dd></li>\n<b><li>The other person guesses what it could be.</b><dd>Guess things they can see which begins with that sound, e.g. chair, chips or chocolate.</dd></li>\n<b><li>When they have guessed what it is, swap over!</b><dd>Take it in turns to pick different things.</dd></li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 2957, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 118892357, "text": "761778402", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt":