[{"id": 4186, "text": "<h2>How to play:</h2>\n<ol>\n<li>Choose a character from the outside layer.</li>\n<li>Begin telling your story. </li>\n<li>When you get to the point that you need a problem, spell out the name of your character as you open and close the fortune teller to choose which inner section you will be looking at.</li>\n<li>When you are looking at the inner section, choose your problem.</li>\n<li>Keep telling the story.</li>\n<li>When you get to the point that you need a solution to the problem, choose a flap to open and find out your solution.</li>\n<li>Finish telling your story!</li>\n</ol>\n<br></br>\nHave a few goes - your storytelling skills will improve as you tell more stories!\n", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2894, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4185, "text": "For this activity, you will need a folded fortune teller. You can either make your own using our instructions or print one which is already decorated.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2894, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "dow