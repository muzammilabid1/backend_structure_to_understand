: 378927145, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You'll need:</h2>\n<ul>\n<li>Paper and pencils</li>\n<li>A grid of 4 squares each</li>\n<li>A dice (or use the one below)</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "zX1freQL9p7yabk88jZBR", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 378927311, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play - friendly game</h2>\n<ol>\n<li>Player 1 rolls the dice.</li>\n<li>They write the number in any square on their grid.</li>\n<li>Then Player 2 rolls the dice.</li>\n<li>Players keep taking turns until the grids are full.</li>\n<li>Players read the numbers aloud.</li>\n<li>The winner has the biggest number.</li>\n</ol>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "i63JaVJvNNNgLC76XnGsV", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 378927159, "text": "Two grids of four squares each labelled Player 1 and Player 2", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Year 4 place value battle grid", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Year 4 place value battle grid-6YGzsSxETAdvwjlXRxTCv.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "d4pXzLoib1Jt9K-m1XAk_", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 379688840, "text": "How do maths games help with learning?", "modal": {"steps": [{"id": 324071304, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 316, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Fun</h2>\n<p>Games can be an enjoyable, motivating way to practice a skill many times.</p>\n<p></p>\n<h2>Positive feelings</h2>\n<p>Having fun together encourages positive feelings towards maths and can reduce worry about making mistakes.</p>\n<p></p>\n<h2>Memory</h2>\n<p>Skills that are practiced when a child is fully engaged and relaxed are more likely to be remembered.</p>\n<p></p>\n<h2>Number sense</h2>\n<p>In trying to win, children really think about the numbers they choose. This builds number sense - a deeper, more flexible understanding of numbers.</p>\n<p></p>\n<h2>Problem solving</h2>\n<p>Finding strategies to win develops problem solving skills.</p>\n<p></p>\n<h2>Mathematical Vocabulary</h2>\n<p>Talking about a game or explaining it to someone else encourages children to use mathematical vocabulary.</p>\n<p></p>\n<h2>Deeper thinking</h2>\n<p>Changing a rule and talking about how that impacts a game encourages an even deeper level of thinking.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "lSemXJT2fEci8gnLBBGXj", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 316, "name": "How do maths games help with learning?", "logCreatedAt": "2024-05-15T09:35:21.09224", "logUpdatedAt": "2024-05-15T09:45:50.488775", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": "Ra