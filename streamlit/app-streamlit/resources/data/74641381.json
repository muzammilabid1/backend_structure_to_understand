[{"id": 74650037, "text": "Verb suggestions", "modal": {"steps": [{"id": 74649963, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 167, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Here are some verbs (actions) you could use in your poem:</p>\n<ul>\n<li>jump</li>\n<li>run</li>\n<li>wash</li>\n<li>brush</li>\n<li>watch</li>\n<li>fix</li>\n<li>hurry</li>\n<li>try</li>\n<li>carry</li>\n</ul>\n<p></p>\n<p>Here are some longer actions you could use:</p>\n<ul>\n<li>I wash the dishes</li>\n<li>I empty the washing machine</li>\n<li>I cook the dinner</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 167, "name": "Verb suggestions", "logCreatedAt": "2022-07-05T13:22:02.225171", "logUpdatedAt": "2022-07-05T13:22:02.225171", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": null}}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74641381, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 167, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 81344248, "text": "Adult and child Mathscots holding hands and laughing together.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "parent and chiild high five LWP (WO shadow)", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "parent and chiild high five LWP (WO shadow)-UjfpWdOyHZOeTmzqdyjBE.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74641381, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74641939, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74641381, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<p>Planning</p>\n<ul>\n<li>Write both people's names on a piece of paper.</li>\n<li>Around each name, write six things they like to do. You can write single words (e.g. 'run') or longer phrases ('paint my nails').</li>\n<li>For an extra challenge, try writing your things with a theme, e.g. what you do when you're getting ready to go out.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74641456, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74641381, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>The aim:</h2>\n<p>For both players to write a poem about themself and the other person. You can work together on one poem if you prefer!</p>\n<p>You also need to think about the {{definition \"verbs\" \"Verbs are doing words, e.g. 'run' or 'clap'.\"}} you use. You will be using present tense verbs like 'run', 'teach' and 'try'. How do the endings change when you start writing about the other person?</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74642476, "text": "Example poems", "modal": {"steps": [{"id": 74642253, "text": null, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "modalId": 166, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2 style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-family: Chaloops-Medium;\">Example 2</span></h2>\n<p style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">A longer poem with more words on each line.</span>&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74642031, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 166, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2><span style=\"font-family: Chaloops-Medium;\">Example 1</span></h2>\n<p><span style=\"font-family: Verdana;\">A shorter poem with two words on each line.</span></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74642395, "text": "I run along the path\n<br>I climb all the trees\n<br>I jump in the deepest puddles\n<br>I skip through the grass\n<br>I laugh at the funny things I see\n<br>I play football\n<br></br>\nShe stands at the side of the playground\n<br>She watches me playing\n<br>She waits for me so patiently\n<br>She helps me when I fall\n<br>She claps when I do well\n<br>She smiles at everything I do", "order": 4, "btnType": "PRIMARY", "linkUrl": null, "modalId": 166, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size:16px;font-family:SassoonInfantRg-Regular;\">I run along the path\n<br>I climb all the trees\n<br>I jump in the deepest puddles\n<br>I skip through the grass\n<br>I laugh at the funny things I see\n<br>I play football\n<br></br>\nShe stands at the side of the playground\n<br>She watches me playing\n<br>She waits for me so patiently\n<br>She helps me when I fall\n<br>She claps when I do well\n<br>She smiles at everything I do</span></p>", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74642163, "text": "I run\n<br>I climb\n<br>I jump\n<br>I skip\n<br>I laugh\n<br>I play\n<br></br>\nShe stands\n<br>She watches\n<br>She waits\n<br>She helps\n<br>She claps\n<br>She smiles", "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 166, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size:16px;font-family:SassoonInfantRg-Regular;\">I run\n<br>I climb\n<br>I jump\n<br>I skip\n<br>I laugh\n<br>I play\n<br></br>\nShe stands\n<br>She watches\n<br>She waits\n<br>She helps\n<br>She claps\n<br>She smiles</span></p>", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 166, "name": "Example poems", "logCreatedAt": "2022-07-05T11:30:49.297317", "logUpdatedAt": "2022-07-05T11:30:49.297317", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": null}}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74641381, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 166, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74642823, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74641381, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Writing</span></p>\n<ul>\n<li style=\"margin-left:1.5em;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Use your plan to write a poem with two verses. </span></li>\n<li style=\"margin-left:1.5em;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">The first verse is about you and the second verse is about the other person.</span></li>\n<li style=\"margin-left:1.5em;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Write each line using this structure: 'I ____' or 'She ____'. Click the button to see two example poems!</span>&nbsp;</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]