[{"id": 44298390, "text": "<h2>The Aim of the Game:</h2>\nTo think of words that rhyme, being as creative as possible!\n<br></br>\nFor example: cat/bat, smile/while or cheetah/fajita!", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44298166, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44299221, "text": "<h2>How to Play:</h2>\n<ol>\n<li>Roll the die to see a word.</li>\n<li>Both players write another word that rhymes with the one on the die.</li>\n<li>Look at each other’s words to find your score: \n<ul>\n<li>1 point if you wrote a word that rhymes.</li>\n<li>1 extra point if it is spelled correctly.</li>\n<li>1 extra point if the other person did not write the same word as you.</li>\n</ul></li>\n<li>Make a note of your score.</li>\n<li>Roll the die again to get another word. </li>\n<li>The first player to get ten points wins!</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1'