[{"id": 46247810, "text": "<h2>How to Play:</h2>\n<ol>\n<li>Ask your child to stand at the top of the stairs. </li>\n<li>Say \"two\", \"one\" or \"zero\".\n<ul>\n<li>If you say \"two\", they step down two stairs.</li>\n<li>If you say \"one\", they step down one stair.</li>\n<li>If you say \"zero\", they must not move.</li>\n</ul></li>\n<li>Repeat until they are at the bottom of the stairs.</li>\n<li>Swap over so they can give you the instructions - will they spot if you make a mistake?</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 46156752, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 46247818, "text": "<h2>You will Need:</h2>\nA set of stairs. No stairs? You can play this game moving along a corridor or across a room instead! ", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 46156752, "dimensions": null, "editAsH