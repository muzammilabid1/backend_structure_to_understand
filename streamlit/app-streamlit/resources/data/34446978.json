[{"id": 34447411, "text": "<h2>What to Do:</h2>\n<ol>\n<li>Choose one of the writing prompts below.</li>\n<li>Think about what you are going to write (we are expecting between five and ten sentences, maybe more if you want).</li>\n<li>Say your first sentence out loud.</li>\n<li>Choose a colour and write your first sentence. Remember to start with a capital letter and end with a full stop, question mark or exclamation mark.</li>\n<li>Say your second sentence out loud.</li>\n<li>Choose a different colour and write the second sentence down. Make sure you do it straight after the first sentence, not on a new line (unless you need to).</li>\n<li>Keep going, saying the sentences aloud and writing them down in different colours, until you get to the end.</li>\n<li>When you have finished, read your writing aloud!</li>\n</ol>\n<br></br>\n<h2>Writing Prompts: </h2>\nClick this link to look at three pictures and sentences. You can choose one to get you started!", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 34446978, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 34446986, "text": "For this activity, you will need at least two different coloured pens/pencils. ", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1632998432316_1image1-01F