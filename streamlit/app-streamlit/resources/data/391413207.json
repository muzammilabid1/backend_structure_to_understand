]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><strong>What if there is no library near me?</strong></p>\n<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Some areas also have a mobile library, which provides all the same services as an ordinary library branch but can move around to different places that don't have a physical library.</span> You can find their routes and timetables online.</p>\n<p>Alternatively, Children's Centres and Family Hubs often have books that can be borrowed - or you could ask at your child's nursery!</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "l4QhqFHeTyyABRFgKvCAb", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 382, "name": "Finding a library", "logCreatedAt": "2024-09-11T09:38:07.412042", "logUpdatedAt": "2024-09-11T09:38:07.412042", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": "How to find a library"}}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 391413207, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 382, "textCarouselD