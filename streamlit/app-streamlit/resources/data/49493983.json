[{"id": 50347629, "text": "Which words should I use?", "modal": {"steps": [{"id": 50346950, "text": "Here are some suggestions:\n<br>\n<ul>\n<li>big</li>\n<li>cat</li>\n<li>leg</li>\n<li>fan</li>\n<li>him</li>\n<li>jog</li>\n<li>kit</li>\n<li>pot</li>\n<li>rug</li>\n<li>sun</li>\n<li>van</li>\n<li>wig</li>\n<li>box</li>\n<li>yum</li>\n<li>zip</li>\n</ul>", "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 146, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 50346543, "text": "You can use any 3-letter words you like, as long as each letter is making its own sound. Try to make sure the vowel (aeiou) is in the middle of the word.", "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 146, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouse