[{"id": 36857174, "text": "<h2>You Will Need:</h2>\n<ul >\n<li>A bowl (or other container, e.g. a hat or bag)</li>\n<li>Ten scraps of paper each</li>\n<li>Something to write with</li>\n<ul>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1634115697242_1image1-01FHWDWVD038MBR0Z7HJA3A4BJ.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36857168, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36857689, "text": "<h2>Setting Up:</h2>\nOn each of your ten pieces of paper, write down a character or famous person you both know about. Fold each piece of paper in half and put it in the bowl.\n<br><br>\n<h2>How to Play:</h2>\nTake it in turns to pick out one pieces of paper and pretend to be that person for the other player to guess. \n<br><br>\n<h2>Challenge:</h2>\nGive yourself a time limit and see how many the other person can guess in the time.\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36857168, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]