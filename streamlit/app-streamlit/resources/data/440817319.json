[{"id": 442658903, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 440817319, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": "Making a bus from a cardboard box", "type": "IMAGE", "fileName": "Making a bus blob", "imageUrl": "Making a bus blob-yT66p4ZSSlzn1z-D4kn3m.png", "fileIdentifier": "yT66p4ZSSlzn1z-D4kn3m", "textEditorState": null, "labelEditorState": "<p>Don't worry if it doesn't look much like a bus!</p>\n"}, {"alt": "A cardboard sign with \"bus stop\" written on it, taped to a chair leg.", "type": "IMAGE", "fileName": "Bus stop blob", "imageUrl": "1728478426995_Bus stop blob-ZLqyqD8AWms-UOJeYAqnP.png", "fileIdentifier": "ZLqyqD8AWms-UOJeYAqnP", "textEditorState": null, "labelEditorState": "<p>You could put bus stops on the floor or tape them to things around the room.</p>\n"}, {"alt": "Toys getting onto the cardboard bus at a bus stop.", "type": "IMAGE", "fileName": "Toys on the bus", "imageUrl": "1728478532106_Toys on the bus-htqEbjSRVJLqvur7EvYWH.png", "fileIdentifier": "htqEbjSRVJLqvur7EvYWH", "textEditorState": null, "labelEditorState": "<p>You can use any toys - cuddly toys, Lego figures, or anything that will fit on your bus!</p>\n"}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "6VhbMpNH4s0GMsxQ1ltk5", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 442653163, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 440817319, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><strong>What can we talk about?</strong></p>\n<p>This activity is all about playing. You don't need to ask lots of questions, but some Maths talk would be a good way of helping your child's learning.</p>\n<p>Here are some things you could say - describe what you see or ask questions:</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "SfOqiZNT703gDMptr34hP", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 442659183, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 440817319, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "sZ72D4ZgptpPtHIU6fV3v", "textEditorState": "<span style=\"font-size: 18px;\"><strong>Addition</strong></span><br><span style=\"font-size: 18px;\">Look - I can see three toys waiting at the bus stop.</span><br><span style=\"font-size: 18px;\">How many toys are getting on the bus?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "R6-G1NiR4rkQ50HSY2keg", "textEditorState": "<span style=\"font-size: 18px;\"><strong>Subtraction</strong></span><br><span style=\"font-size: 18px;\">These two toys want to get off the bus!</span><br> <span style=\"font-size: 18px;\">How many toys are getting off the bus?</span>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "9Srj_q19jwyWaI4DPD_AP", "textEditorState": "<span style=\"font-size: 18px;\"><strong>How many now?</strong></span><br><span style=\"font-size: 18px;\">Those six toys are having lots of fun on the bus now!</span><br><span style=\"font-size: 18px;\">How many toys are on the bus now?</span>\n", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "zdlWIrduK5XTdzb_g_j6D", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 442652897, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 440817319, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You will need:</h2>\n<ul>\n<li>Something to be your bus - a box would work well. You could decorate it if you wanted!</li>\n<li>Some toys to get on the bus</li>\n<li>Some bus stops</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "EYurZlGlKWNQTgx-1NIoD", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 442652984, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 440817319, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Put some of the toys on the bus.</li>\n<li>Put some of the toys waiting at the bus stops.&nbsp;</li>\n<li>Drive your bus around the room, and stop at the bus stops. The toys can get on or off the bus at each stop.</li>\n<li>Talk about what is happening while you are playing!</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "fMjguKrzV4Vj-MsokMug5", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]