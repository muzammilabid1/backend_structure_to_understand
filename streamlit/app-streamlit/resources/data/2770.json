[{"id": 3869, "text": "Pick a container of which you don't know the capacity, for example a cup or a bowl, and both estimate its capacity. <br> </br>\nRemember 1cm by 1cm by 1cm is one cubic centimetre and liquid that fills the same space is 1 millilitre. <br> </br>\nCheck by filling the container with liquid and then pouring it into a measuring jug. Whoever is closest wins!", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "estimate, estimating volume and capacity-ik2HGTZV3DlL_81DWE_nP.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2770, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]