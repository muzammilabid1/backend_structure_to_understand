[{"id": 36882911, "text": "<h2>Getting Ready:</h2>\nYou will need to make a sculpture (a 3D artwork). It can be made of anything you like. See some ideas below.\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1634137901246_1image1-01FHX2MHTC4HBYBBF0KCYZ4FC1.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36882894, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 39776074, "text": "Sculpture Ideas", "modal": {"steps": [{"id": 39775974, "text": "<h2>What could I use to make my sculpture?</h2>\n<br>\n<ul style=\"list-style-position: inside\">\n<li>Junk, e.g. boxes, yoghurt pots, newspaper etc.</li>\n<li>Clay or plasticine or playdough</li>\n<li>Lego or another construction toy</li>\n<li>Things found in the garden or park</li>\n</ul>\n<br>\nYou can make anything look like a sculpture if you present it like art – make sure there is a clear space around it and maybe stand it on something, like a box or a stool, so that it looks more like something in a museum. You could even write a label to stand next to it so that people know what your sculpture is called.", "order": 1, "btnType": null, "linkUrl": null, "modalId": 5, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"