[{"id": 440834508, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 243263311, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Challenge:</h2>\n<p>Think about the other days of the week:</p>\n<ul>\n<li>Can you spot any other days which are named after things in space?</li>\n<li>Do you know words for the days in other languages which sound like they have similar etymologies?</li>\n<li>Why do you think some languages have similar words for the days and others have totally different words?</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "y9ANZ0RFOtrNm_WVV44q5", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 440833922, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 243263311, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "X31GIhzTWdFUC0EnQDC1W", "textEditorState": "<p><span style=\"font-size: 24px;\">Where does the word “Monday” come from?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "eTRs-qnOVI09zYbB2GLaB", "textEditorState": "<p><span style=\"font-size: 24px;\">It is from the Old English “Monandæg,” meaning “Moon’s day.”</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "kfcgW69Lue_ezYLo9atZd", "textEditorState": "<p><span style=\"font-size: 18px;\">The Anglo-Saxons based their word on the Latin “Dies Lunae”, which translates to “day of the Moon,” where “Luna” means “Moon.”</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "AY7M9omCBjT-j3QJeL_95", "textEditorState": "<p><span style=\"font-size: 18px;\">The Romans (who spoke Latin) didn’t invent the names of the days. Their calendar is actually influenced by even older cultures, including the Ancient Babylonians.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "CqbbjvXBC8e2WgTSHv1pS", "textEditorState": "<p><span style=\"font-size: 18px;\">The Babylonians also had a seven day week, and they named Monday “The Day of the Moon” (𒌓𒌓𒌅).</span></p>\n", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "QJT9Zpmfvoxy4ZDTfIY4j", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 440833892, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 243263311, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<p>Let's start by thinking about Monday. Can you guess where the word 'Monday' comes from?</p>\n<p><em>Scroll across to find out more!</em></p>\n<p></p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "wIZjt2NDnQQAYC71FpWZn", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 452482960, "text": "A calendar with the start letters of the days along the top: M T W T F S S.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Calendar", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Calendar-Zx41DmEFLLilwxfiMPNuC.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 243263311, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "427KtTl6EVQH8IkovWwuv", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 440834450, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 243263311, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Here are some more questions to think about:</p>\n<ul>\n<li>Can you think of any other languages where the word for “Monday” has the same etymology as English? Why do you think they might be similar?</li>\n<li>What about any languages <span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">where the word for “Monday” has a totally different etymology? Why might they be different?</span></li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "_qIhlSHKYfWILy_XsxLhZ", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]