[{"id": 142485058, "text": "A list of the prime numbers up to 100", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Year 6 Prime number list", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Year 6 Prime number list-oudflZkUZ37pp4Ot5e6Vb.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 142484257, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 142487281, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 142484257, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Another Puzzle - Goldbach's Conjecture</h2>\n<p>If you enjoyed the last puzzle, here's another.</p>\n<p></p>\n<p>Mathematicians love primes.  In 1742 a mathematician called Christian Goldbach claimed that:</p>\n<p><strong>Every even number over 3 can be written as the sum of  two </strong><strong><ins>prime </ins></strong><strong>numbers.  </strong></p>\n<p></p>\n<p>This works, but for nearly 300 years noone has been able to prove why it works.</p>\n<p>How many even numbers can you work out?</p>\n<p>For example:</p>\n<p><strong>4</strong> = 2+2</p>\n<p><strong>6</strong>=3+3</p>\n<p><strong>8</strong>=5+3</p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 142485064, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 142484257, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Prime Sums Puzzle</h2>\n<p>Every number greater than 5 can be written as the sum of 3 <strong>prime</strong> numbers.&nbsp;</p>\n<p>Can you work the sums out?</p>\n<p>How far can you go?</p>\n<p></p>\n<p>For example:</p>\n<p><strong>6</strong> = 2+2+2</p>\n<p><strong>7</strong>= 2+2+3</p>\n<p><strong>8</strong>= 3+3+2</p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]