[{"id": 521791836, "text": "Things to think about", "modal": {"steps": [{"id": 521792064, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 441, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Here are some things you could include in your performance:</p>\n<ul>\n<li>Using different voices for different characters.</li>\n<li>Changing your voice to fit the mood of the writing, e.g. slowing down to build suspense.&nbsp;</li>\n<li>Adding in actions.</li>\n<li>Memorising the words so you don't need to read from the book.</li>\n<li>Using your face to make it more engaging, e.g. look worried when the characters are worried.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "M1XtgvLC6fUkXm3QNNNF-", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 441, "name": "Things to think about", "logCreatedAt": "2024-12-02T12:37:33.681225", "logUpdatedAt": "2024-12-02T12:37:33.681225", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": "Things to think about when performing a story"}}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsD