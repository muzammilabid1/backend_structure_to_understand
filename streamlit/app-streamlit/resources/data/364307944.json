[{"id": 364308138, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 364307944, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<p>Help your child to make a choice in a shop.</p>\n<p></p>\n<ol>\n<li>Give them a small amount of money to spend.</li>\n<li>Talk to them about the choices they can make.</li>\n<li>Together look at the prices on different items.</li>\n<li>Help them to check if they have enough money.</li>\n<li>Ask your child to take the money and the item to the till.</li>\n<li>Let them do the buying, take any change and the receipt.</li>\n</ol>\n<p></p>\n<p></p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "xHYuN9jceNcuqjmAARfqB", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 369118853, "text": "A child paying in a supermarket", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "2324-81124856b", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "2324-81124856b-0OXj_HCYW5QmYG-i7-MY1.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 364307944, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "Krpuvs_WROrELGzqZsz8t", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 364308397, "text": "Where's the learning?", "modal": {"steps": [{"id": 364308664, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 334, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>There is lot of learning here, including:</p>\n<ul>\n<li>To experience spending money in the real world.</li>\n<li>To experience making a choice themselves.</li>\n<li>To understand that different items have different prices.</li>\n<li>To understand the idea of having enough money.</li>\n<li>To build confidence speaking to other adults.</li>\n</ul>\n<p></p>\n<p>Don't worry if your child needs lots of help the first time they do this.</p>\n<p>The focus is on the experience rather than the maths.</p>\n<p>There is no need for your child to add up several items or calculate change themselves.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": fa