[{"id": 3947, "text": "<br> </br>Deal the cards equally. Take it in turns to put down one card, face up, on a pile in the middle. <br> </br>\n\nIf the card you put down has a fact that is double the fact below (for example 6 x 4 and 6 x 8), you shout 'double'. <br> </br>\n\nIf the card you put down has a fact that is half the fact below (for example 4 x 10 and 2 x 10), you shout 'half'. <br> </br>\n\nIf you are right, you get to keep the pair. Play until there are no more pairs. The winner is the person with the most cards at the end.\n\n", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "Double or halve, exploring the 2, 4 and 8 times table-InIAJ_41ZO0cp4vXYxxBt.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2824, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 225781464, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2824, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You'll need:</h2>\n<p>A copy