[{"id": 4177, "text": "<h2>How to play:</h2>\nGive both players a piece of paper. You are going to be drawing a monster each!\n<br></br>\n<ol>\n<li>Fold the paper into three to make one section for the head, one for the body and one for the legs.</li>\n<li>Draw a monster's head in the top section of your paper. Make it as crazy or as fierce as you like! Don't show the other person what you have drawn!</li>\n<li>Fold over the paper so that the monster's head is hidden. Make sure the neck lines are still poking out!</li>\n<li>Swap paper with the other person and draw a body onto their head (you can't look what their head is like).</li>\n<li>Fold over the paper so that the monster's body is hidden. Make sure the waist lines are still poking out!</li>\n<li>Swap paper again and draw legs onto the monster.</li>\n<li>Fold over the paper so the whole monster is hidden.</li>\n<li>Swap paper again and open up the paper to see what your monster is like!</li>\n<li>Describe your monster to the other person - what is it like?</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2906, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43145538, "text": "<h2>You will need:</h2>\n<ul>\n<li>Paper;</li>\n<li>Colouring pencils or pens;</li>\n<li>A writing pen or pencil.</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2906, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43145604, "text": "Overhead view of two children drawing monsters onto folded paper", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1637669493023_1image1-01FN6B9PN5M7M98B0W0KPTWEWQ.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2906, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4671, "text": "<br></br>\n<h2>Challenge:</h2>\nChoose a name for your monster and write it at the top of the paper. Then write descriptive phrases around your monster to show what it is like!"