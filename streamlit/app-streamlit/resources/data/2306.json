[{"id": 305346884, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2306, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You will need:</h2>\n<ul>\n<li>Coloured paints or sauces such as ketchup, BBQ sauce or mustard.&nbsp;</li>\n<li>Some sheets of paper or kitchen towel.&nbsp;</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "ZOqgqxQB3ViWnBrCNTZVN", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 3161, "text": "Get your child to dip their fingertips into the paint. Dip two fingers into one colour, and the other three into a different colour. <br> </br>\n\nOnce their fingers are covered in paint or sauce, ask them to press their fingers onto the paper. Ask them to count how many dots there are of each colour. Then, ask them to count how many dots there are altogether. <br> </br>\n\nRepeat the activity, but this time dip four fingers into one colour, and then one finger into the other. Again, ask your child to count how many dots there are of each colour, then how may dots there are overall. \nRepeat the activity with different colours to practice learning numbers within five. \n\n", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "aud