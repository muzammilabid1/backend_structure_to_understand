[{"id": 222365987, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35481527, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>The Aim of the Game:</h2>\n<p>To start with a topic on which you do not agree, then to share your side of the argument, listen to the other person’s ideas, and then come to a {{definition \"compromise\" \"This is when you meet somewhere in the middle. It might not be the perfect answer for either person, but it should be an ok resolution for both of you.\"}}.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 39912416, "text": "<h2>What to Do:</h2>\n<ol>\n<li>Choose a topic you do not agree on (or you can pretend you don’t agree). See below for some ideas.</li>\n<li>Stand opposite each other at different sides of the room (you should be fairly far apart).</li>\n<li>Player 1 says her side of the argument.</li>\n<li>Player 2 says his side of the argument.</li>\n<li>Player 1 thinks of something she could do to help settle the differences between them.</li>\n<li>Player 2 thinks about this offer and says why (or why not) he is prepared to accept this proposal.</li>\n<li>If Player 2 accepts the proposal, Player 1 takes a step forward. If Player 2 does not accept the proposal, Player 1 stays still.</li>\n<li>Now Player 2 thinks of something she could do to help settle the differences between them and Player 1 says why (or why not) she is prepared to accept it. If Player 1 accepts the offer, Player 2 takes a step forward.</li>\n<li>Keep repeating this, taking turns to suggest something, until you are close enough to shake hands. When this happens, you have found a workable compromise and can shake hands on your settlement.</li>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 35481527, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35481548, "text": "\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633444101979_1image1-01FH8DNHKZFMW95Z6CCWYYZCDE.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35481527, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 458367555, "text": "Debate topics", "modal": {"steps": [{"id": 39917573, "text": null, "order": 1, "btnType": null, "linkUrl": null, "modalId": 14, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": "{}", "editAsHtml": false, "properties": {}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "bC9gNXzawY-t_Kz81k2tL", "textEditorState": "<p><span style=\"font-size: 18px;\">Cars are highly polluting and should be banned. </span></p>\n<p><span style=\"font-size: 18px;\">VS</span></p>\n<p><span style=\"font-size: 18px;\">Having a car is important to me and I need it to be able to get around.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "7NV46NLxbtyyZfZ5btRp1", "textEditorState": "<p><span style=\"font-size: 18px;\">All plastic should be banned. </span></p>\n<p><span style=\"font-size: 18px;\">VS</span></p>\n<p><span style=\"font-size: 18px;\">Having plastic is convenient, and I like doing things like drinking bottled water.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "36Mj8yuQUrZ3ujvzVx938", "textEditorState": "<p><span style=\"font-size: 18px;\">Books are better than television, so we shouldn't have any TVs in the house. </span></p>\n<p><span style=\"font-size: 18px;\">VS</span></p>\n<p><span style=\"font-size: 18px;\">Television is better than books, so we should get rid of all our books.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "34Rqp5e7Ds4WZa3aZSdLS", "textEditorState": "<p><span style=\"font-size: 18px;\">All children should have to join a sports club or team.</span></p>\n<p><span style=\"font-size: 18px;\">VS</span></p>\n<p><span style=\"font-size: 18px;\">Children should relax when they are not at school.</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "lkNLOar9OKxjSnaupYq8c", "textEditorState": "<p><span style=\"font-size: 18px;\">Murderers should never be released from prison.</span></p>\n<p><span style=\"font-size: 18px;\">VS</span></p>\n<p><span style=\"font-size: 18px;\">We shouldn't have prisons at all.</span></p>\n", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [\"Cars are highly polluting and should be banned. VS Having a car is important to me and I need it to be able to get around.\"] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 14, "name": "Debate Topics", "logCreatedAt": "2021-11-04T11:51:18.378659", "logUpdatedAt": "2024-10-17T10:26:24.638125", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": "Debate topics Y5/6"}}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 35481527, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName