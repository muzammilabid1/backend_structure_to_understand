[{"id": 36563375, "text": "<h2>Activity Set-Up:</h2>\n<ul>\n<li>Use a ruler and pencil to draw lines on a piece of paper.</li>\n<li>Put another piece of paper on top.</li>\n<li>Use a biro (or press down extra hard with a pencil) to write rows of letters l i t u and y on the lines.</li>\n<li>Press down hard so you dent the paper below.</li>\n<li>Make sure you write the letters the same sort of size your child usually writes!</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1634036037432_1image1-01FHT22TR9JMHZ02Q55PKFGMWT.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36563134, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36563595, "text": "<h2>The Activity:</h2>\n<ul>\n<li>Ask your child if they can shut their eyes and find the ghost letters on the page – they should be able to feel the dents!</li>\n<li>Get them to use a coloured (or grey) pencil to trace over the ghost letters. Remind them to think about always starting with an l shape and the left-hand side of the letter.</li>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36563134, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "dele