[{"id": 81331796, "text": "A monkey soft toy is lying tucked up in bed. A dog soft toy is looking at the monkey and there is a speech bubble coming from its mouth which says, \"Oh Grandma, what a long tail you have!\"", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Oh grandma! blob", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Oh grandma! blob-iTz7raz_O0Xad_3KLscPc.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54208882, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 75490366, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54208882, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<ol>\n<li>Decide whether you are going to draw or build your scene.</li>\n<li>Choose a baddy (instead of the wolf).</li>\n<li>Choose a goody (instead of Little Red Riding Hood).</li>\n<li>Put your baddy in bed (or draw them in bed).</li>\n<li>Write in three speech bubbles the things your goody might say to your baddy instead of \"Oh Grandma, what <span style=\"color: rgb(147,101,184);\"><strong>big</strong></span> <span style=\"color: rgb(251,160,38);\"><strong>eyes </strong></span>you have!\" You <strong>must</strong> change the orange word (<span style=\"color: rgb(251,160,38);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">eyes</span>) and you can change the purple word (<span style=\"color: rgb(147,101,184);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\"><strong>big</strong></span>) if you like.</li>\n<li>Well done! You have written three exclamation sentences!</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 75489938, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54208882, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You will need:</h2>\n<ul>\n<li>Something to write with</li>\n<li>Plain paper or a speech bubbles sheet (download below)</li>\n<li>Something to make your scene with (you can draw it or make it with toys)</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false