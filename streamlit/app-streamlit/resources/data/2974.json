[{"id": 41009569, "text": "<h2>How to play:</h2>\n <ol>\n<b><li>Choose who is going to be Simon.</b><dd> Simon is in charge of giving the instructions.</dd></li>\n<b><li>Simon gives the instruction, e.g. <span class=\"mwp-orange\">Simon says</span> j-u-m-p. </b><dd>Don't forget to break one of the words down into phonemes (sounds).</dd></li>\n<b><li>The other person follows the instruction.</b><dd> Keep going until Simon tells you to stop!</dd></li>\n<b><li>Simon can try to trick the other person .</b><dd>If Simon gives the instruction without saying \"Simon says\", then the other person should <b>not</b> follow the instruction.</dd></li>\n<b><li>Keep going until Simon manages to trick the other person.</b><dd>Keep swapping so both people get a chance to give and follow the instructions.</dd></li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2974, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 41128525, "text": "<h2>Tip:</h2>\nChoose words without too many sounds - start with three. Words with more sounds are harder to blend together!", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "