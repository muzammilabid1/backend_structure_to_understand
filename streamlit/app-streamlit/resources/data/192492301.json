, "clickableAlphabetData": null}, {"id": 222342406, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 192492301, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<ol>\n<li>Player 1 makes a group of counters.</li>\n<li>Player 1 says how many counters there are, e.g. \"There are five counters.\"</li>\n<li>Player 2 makes another group of the same number of counters.</li>\n<li>Player 2 says a sentence for the double, e.g. \"Now we have double five.\"</li>\n<li>Talk together about how many counters there are in total. Can you say a sentence about the total? e.g. \"Double five is ten.\"</li>\n<li>Repeat the activity, taking it in turns to make the first group of counters.</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 224430289, "text": "What could we use for counters?", "modal": {"steps": [{"id": 222674963, "text": "Different small items laid out including pasta, raisins, lego bricks, pen lids, pennies, shells and circles cut from cardboard.", "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 280, "audioUrl": null, "fileName": "Counters Modal image", "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Counters Modal image-x5GSTxl6goE8XWofwGME7.png", "linkName": null, "stepType": "IMAGE", "tabsData"