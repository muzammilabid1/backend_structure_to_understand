Url": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">verb</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'swim' or 'flying'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">conjunction</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'although' or 'and'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">determiner</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'the' or 'some'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">question sentence</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: Why are you running?</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">plural</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'donkeys' (instead of 'donkey') or 'puppies' (instead of 'puppy')</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">compound word</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: sun + flower = sunflower </p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">pronoun</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'they' or 'he'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">past tense</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: I crossed the road. </p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">fronted adverbial</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'At first' in the sentence 'At first, I was surprised.'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">preposition</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'after' in the sentence 'I went shopping after lunch.'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">adjective</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'purple' or 'enormous'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">prefix</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'un' in 'unlikely' or 'auto' in 'autograph'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">suffix</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'ous' in 'dangerous' or 'ly' in 'gently'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">possessive pronoun</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'their' or 'her'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">direct speech</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: “I am happy,” she said.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">adverb</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'slowly' in 'he ran slowly' or 'strangely' in 'it was strangely quiet'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">noun phrase</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'a blue moon' or 'the enormously wide lorry'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">statement sentence</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: It was a lovely day.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">adverbial</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'in the classroom' in 'It was quiet in the classroom.'</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">command sentence</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: Carefully, cut the cloth.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">present tense</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: I ran towards the shops.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">singular</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: 'mouse' (instead of 'mice') or 'table' (instead of 'tables')</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">consonant</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: b c d f g h j k l m n p q r s t v w x y or z</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">exclamation sentence</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example: What big ears you have!</p>", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{\"text\":[{\"text\":\"Ready?\",\"fontSize\":\"32\"},{\"text\":\"Steady?\",\"fontSize\":\"32\"},{\"text\":\"Go!\",\"fontSize\":\"32\"},{\"text\":\"noun\",\"fontSize\":\"32\"},{\"text\":\"Example: 'cat' or 'castle'\",\"fontSize\":\"32\"},{\"text\":\"vowel\",\"fontSize\":\"32\"},{\"text\":\"Example: a e i o or u\",\"fontSize\":\"32\"},{\"text\":\"verb\",\"fontSize\":\"32\"},{\"text\":\"Example: 'swim' or 'flying'\",\"fontSize\":\"32\"},{\"text\":\"conjunction\",\"fontSize\":\"32\"},{\"text\":\"Example: 'although' or 'and'\",\"fontSize\":\"32\"},{\"text\":\"determiner\",\"fontSize\":\"32\"},{\"text\":\"Example: 'the' or 'some'\",\"fontSize\":\"32\"},{\"text\":\"question sentence\",\"fontSize\":\"32\"},{\"text\":\"Example: Why are you running?\",\"fontSize\":\"32\"},{\"text\":\"plural\",\"fontSize\":\"32\"},{\"text\":\"Example: 'donkeys' (instead of 'donkey') or 'puppies' (instead of 'puppy')\",\"fontSize\":\"32\"},{\"text\":\"compound word\",\"fontSize\":\"32\"},{\"text\":\"Example: sun + flower = sunflower \",\"fontSize\":\"32\"},{\"text\":\"pronoun\",\"fontSize\":\"32\"},{\"text\":\"Example: 'they' or 'he'\",\"fontSize\":\"32\"},{\"text\":\"past tense\",\"fontSize\":\"32\"},{\"text\":\"Example: I crossed the road. \",\"fontSize\":\"32\"},{\"text\":\"fronted adverbial\",\"fontSize\":\"32\"},{\"text\":\"Example: 'At first' in the sentence 'At first, I was surprised.'\",\"fontSize\":\"32\"},{\"text\":\"preposition\",\"fontSize\":\"32\"},{\"text\":\"Example: 'after' in the sentence 'I went shopping after lunch.'\",\"fontSize\":\"32\"},{\"text\":\"adjective\",\"fontSize\":\"32\"},{\"text\":\"Example: 'purple' or 'enormous'\",\"fontSize\":\"32\"},{\"text\":\"prefix\",\"fontSize\":\"32\"},{\"text\":\"Example: 'un' in 'unlikely' or 'auto' in 'autograph'\",\"fontSize\":\"32\"},{\"text\":\"suffix\",\"fontSize\":\"32\"},{\"text\":\"Example: 'ous' in 'dangerous' or 'ly' in 'gently'\",\"fontSize\":\"32\"},{\"text\":\"possessive pronoun\",\"fontSize\":\"32\"},{\"text\":\"Example: 'their' or 'her'\",\"fontSize\":\"32\"},{\"text\":\"direct speech\",\"fontSize\":\"32\"},{\"text\":\"Example: “I am happy,” she said.\",\"fontSize\":\"32\"},{\"text\":\"adverb\",\"fontSize\":\"32\"},{\"text\":\"Example: 'slowly' in 'he ran slowly' or 'strangely' in 'it was strangely quiet'\",\"fontSize\":\"32\"},{\"text\":\"noun phrase\",\"fontSize\":\"32\"},{\"text\":\"Example: 'a blue moon' or 'the enormously wide lorry'\",\"fontSize\":\"32\"},{\"text\":\"statement sentence\",\"fontSize\":\"32\"},{\"text\":\"Example: It was a lovely day.\",\"fontSize\":\"32\"},{\"text\":\"adverbial\",\"fontSize\":\"32\"},{\"text\":\"Example: 'in the classroom' in 'It was quiet in the classroom.'\",\"fontSize\":\"32\"},{\"text\":\"command sentence\",\"fontSize\":\"32\"},{\"text\":\"Example: Carefully, cut the cloth.\",\"fontSize\":\"32\"},{\"text\":\"present tense\",\"fontSize\":\"32\"},{\"text\":\"Example: I ran towards the shops.\",\"fontSize\":\"32\"},{\"text\":\"singular\",\"fontSize\":\"32\"},{\"text\":\"Example: 'mouse' (instead of 'mice') or 'table' (instead of 'tables')\",\"fontSize\":\"32\"},{\"text\":\"consonant\",\"fontSize\":\"32\"},{\"text\":\"Example: b c d f g h j k l m n p q r s t v w x y or z\",\"fontSize\":\"32\"},{\"text\":\"exclamation sentence\",\"fontSize\":\"32\"},{\"text\":\"Example: What big ears you have!\",\"fontSize\":\"32\"}]}", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44310652, "text": "<h2>How to play:</h2>\nBefore you start, choose a buzzer noise each, e.g “Buzz!” or “Bing!” - you will need to use your buzzer when you know the answer!\n<br></br>\n<ol>\n<li>Scroll across the orange box to see a grammar term.</li>\n<li>If you know what it means and can give an example, make your buzzer noise!</li>\n<li>If you were first to buzz, give an example:\n<ul>\n<li>If the other player agrees you were correct, you get a point. </li>\n<li>If they disagree, they can try to give an example and get a point. </li>\n<li>If nobody thinks of a correct example, scroll across the orange box to read an example.</li>\n</ul></li>\n<li>Scroll across again to see the next grammar term.</li>\n<li>The first player with ten points wins!</li>\n</ol>\n\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUr