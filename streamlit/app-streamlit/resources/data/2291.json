[{"id": 305346564, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2291, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<p>The aim of the activity is to make a starfish with five legs.&nbsp;</p>\n<ol>\n<li>With your child, role out five legs and a body using the dough.</li>\n<li>Challenge your child to attach the legs to the body one at a time, counting as they do so.&nbsp;</li>\n<li>After they have made the starfish, ask them to count how many legs it has.&nbsp;</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "sfunDMfMTRZuK3WOhXLME", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 305346564, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2291, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<p>The aim of the activity is to make a starfish with five legs.&nbsp;</p>\n<ol>\n<li>With your child, role out five legs and a body using the dough.</li>\n<li>Challenge your child to attach the legs to the body one at a time, counting as they do so.&nbsp;</li>\n<li>After they have made the starfish, ask them to count how many legs it has.&nbsp;</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "sfunDMfMTRZuK3WOhXLME", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 46250100, "text": "Playdough Recipe", "modal": {"steps": [{"id": 81123111, "text": null, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 12, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2><span style=\"font-family: Chaloops-Medium;\"><strong>Ingredients:</strong></span></h2>\n<ul>\n<li>1 cup plain flour&nbsp;</li>\n<li>1 tablespoon vegetable oil (baby oil and coconut oil work too)&nbsp;</li>\n<li>1/4 cup salt&nbsp;</li>\n<li>1 tablespoon cream of tartar&nbsp;</li>\n<li>0.5-0.75 cups boiling water (adding in increments until it feels just right)&nbsp;</li>\n<li>food colouring (optional)&nbsp;</li>\n<li>few drops glycerine (the secret ingredient for extra stretch and shine) (optional)&nbsp;</li>\n<li>a sealable bag or box to keep the play dough in when you have finished playing</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 305526833, "text": "Boiling water safety", "order": 4, "btnType": "PRIMARY", "linkUrl": null, "modalId": 12, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 206, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "sj3a9qK9iiK0CRZ3UnxZz", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 81123186, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 12, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">This no-cook recipe should take you about four minutes to make and keep for around six months! Of course, you could use another recipe or play dough you have bought from a shop instead. </span>&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 81123009, "text": null, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "modalId": 12, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2><span style=\"font-family: Chaloops-Medium;\">Method: </span></h2>\n<ol>\n<li>Mix the flour, salt, cream of tartar and oil in a mixing bowl.&nbsp;</li>\n<li>Add the foodcolouring (if you are using it) to the hot water and then tip some of the water into the dry ingredients.&nbsp;</li>\n<li>Stir continuously until it becomes a sticky, combined dough, adding more water if it is too dry.&nbsp;</li>\n<li>Add the glycerine, if you are using it.&nbsp;</li>\n<li>Allow it to cool down then take it out of the bowl and knead it vigorously for a couple of minutes until all of the stickiness has gone. The kneading is really important because it's what makes the dough lovely and stretchy.&nbsp;</li>\n<li>If it is still a little sticky then add a bit more flour until it is just right!&nbsp;</li>\n<li>Your playdough is ready to use!&nbsp;</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 12, "name": "Playdough Recipe", "logCreatedAt": "2021-11-04T10:01:56.332971", "logUpdatedAt": "2024-04-24T09:56:44.478126", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": "Playdough recipe (minus nidirect link)"}}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2291, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 12, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 46250100, "text": "Playdough Recipe", "modal": {"steps": [{"id": 81123111, "text": null, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 12, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[