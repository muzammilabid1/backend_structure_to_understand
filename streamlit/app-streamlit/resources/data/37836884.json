[{"id": 37837371, "text": "<h2>Warmup:</h2>\nTry out these different ways of balancing:\n<ul>\n<li><b>Plank</b> - lie on your front and keeping your body straight, push up with your arms.</li>\n<li><b>Back support</b> - sit up, put your hands next to your bottom and push up with your arms until your body is straight.</li>\n<li><b>Straddle press</b> - sit with your legs straight in front of you and feet apart, put your hands between your legs, and push up with your arms so your bottom lifts off the floor.</li>\n</ul>\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1634648716433_1image1-01FJCAFBY7QGPNNPZ9V07WXMY8.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 37836884, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 37839596, "text": "<h2>The Activity:</h2>\nTry these challenges:", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 37836884, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextDa