[{"id": 81126814, "text": "What if we say words that aren't real?", "modal": {"steps": [{"id": 81126756, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 187, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>You decide - you can either only count real words, or you might like to allow any word.&nbsp;</p>\n<p>For example, 'eye' rhymes with 'kligh' and 'gly'.&nbsp;</p>\n<p>The most important thing is that children understand that for something to rhyme, the sound at the end has to be the same.&nbsp;</p>\n<p>Only including real words is more of a challenge!</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 187, "name": "What if we say words that aren't real?", "logCreatedAt": "2022-09-12T13:14:35.559564", "logUpdatedAt": "2022-09-12T13:14:35.559564", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": null}}, "order": 10, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45450799, "dimensions": null, "editAsHtml": false, "