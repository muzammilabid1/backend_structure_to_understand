Data": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 39924224, "text": "\nSilver moonlight shines.\n<br>Only a dormouse rustles\n<br>In the silent night.", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": 32, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 35484645, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size:32px;font-family:SassoonInfantRg-Regular;\">\nSilver moonlight shines.\n<br>Only a dormouse rustles\n<br>In the silent night.</span></p>", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 39924224, "text": "\nSilver moonlight shines.\n<br>Only a dormouse rustles\n<br>In the silent night.", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": 32, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 35484645, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"font-size:32px;font-family:SassoonInfantRg-Regular;\">\nSilver moonlight shines.\n<br>Only a dormouse rustles\n<br>In the silent night.</span></p>", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35485574, "text": "<h2>The Activity:</h2>\nWrite your own Haiku story. Both of you should write one, and then guess which story the other person’s Haiku is about!\n<ol>\n<li>Choose a story. It’s easier if it’s a story that lots of people know. Fairy tales work well!</li>\n<li>Think about the important parts of the story – what must you include to help them guess? Try not to include the story title though – that would be too easy!</li>\n<li>Try saying your ideas and count the syllables on your fingers as you say them. When you have something that works, write it down. It might not end up in your final poem, but you don’t want to forget it.</li>\n<li>Try out lots of ideas until you are happy with your poem as a whole. Then write down the finished haiku.</li>\n<li>When you have both finished, read your haikus aloud and try to guess which stories they come from!</li>\n</ol>\n<br><br>\n<h2>Example:</h2>\nCan you guess which story this haiku is telling?\n", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35484645, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35485574, "text": "<h2>The Activity:</h2>\nWrite your own Haiku story. Both of you should write one, and then guess which story the other person’s Haiku is about!\n<ol>\n<li>Choose a story. It’s easier if it’s a story that lots of people know. Fairy tales work well!</li>\n<li>Think about the important parts of the story – what must you include to help them guess? Try not to include the story title though – that would be too easy!</li>\n<li>Try saying your ideas and count the syllables on your fingers as you say them. When you have something that works, write it down. It might not end up in your final poem, but you don’t want to forget it.</li>\n<li>Try out lots of ideas until you are happy with your poem as a whole. Then write down the finished haiku.</li>\n<li>When you have both finished, read your haikus aloud and try to guess which stories they come from!</li>\n</ol>\n<br><br>\n<h2>Example:</h2>\nCan you guess which story this haiku is telling?\n", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35484645, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 39924182, "text": "Here is an example:", "modal": {"steps": [null