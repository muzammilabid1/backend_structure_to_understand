dthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Challenge:</h2>\n<p>Try the same activity, but using a border that has 24 spaces.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 120791951, "text": null, "modal": {"steps": [null], "details": null}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 120298641, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><strong>But I can't make a longer unit of repeat - I only have three different types of item!</strong>&nbsp;</p>\n<p><span style=\"color: rgb(50,51,56);background-color: rgb(255,255,255);font-size: 16px;\">Remember, even though you only have three different types of item, you can still make longer units of repeat, e.g. </span><span style=\"color: rgb(243,121,52);background-color: rgb(255,255,255);font-size: 16px;\">a</span><span style=\"color: rgb(0,168,133);background-color: rgb(255,255,255);font-size: 16px;\">bb</span><span style=\"color: rgb(243,121,52);background-color: rgb(255,255,255);font-size: 16px;\">a</span><span style=\"color: rgb(50,51,56);background-color: rgb(255,255,255);font-size: 16px;\"> is four long but only uses two different items.</span>&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 120791931, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 120298641, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li><span style=\"color: rgb(50,51,56);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">Make a pattern using a unit of repeat two items long. Put one item in each square. Does it fit round the border?</span></li>\n<li><span style=\"color: rgb(50,51,56);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">What other units of repeat will work with this border?</span></li>\n<li><span style=\"color: rgb(50,51,56);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">What units of repeat will not work with this border?</span>&nbsp;</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 120302816, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Border patterns 12 squares", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "DOWNLO