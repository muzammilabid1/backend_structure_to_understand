[{"id": 45172086, "text": "<h2>What to Do:</h2>\n<ol>\n<li>Choose ten things in a category (e.g. fruits).</li>\n<li>Write the things on your ten bits of paper. Both people should write the same ten things.</li>\n<li>Make a diamond with your ten things to show which are the best and which are the worst.</li>\n<li>Compare diamonds and explain to the other person why you ranked them in this way.</li>\n</ol>\n<br>\n<h2>Example:</h2>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45171886, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45172583, "text": "Why did I put the fruit in that order?", "modal": {"steps": [{"id": 45172561, "text": "I put apples at the top because I like eating them. You can have them cold or turn them into a pudding, like apple crumble. They are grown in this country so they don’t have to be transported very far. I also like how they keep really well, so if you pick an apple in the autumn, it will still be nice to eat next spring. \n<br></br>\nI put bananas in the middle because although I like them, I prefer mango and raspberries. Bananas are good because they are filling, and they come in their own wrapper. Bananas can also be turned into a pudding or a milkshake. I don’t like banana when it goes squashy though!\n<br></br>\nI put pineapple second from the bottom because I do like it but it is really hard to get into a fresh pineapple. I think pineapple can sometimes be disappointing to eat, and it can taste a bit fizzy when it’s over-ripe. A good pineapple is tasty though, so I didn’t put it at the bottom.\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 134, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 134, "name": "Why did I put the fruit in that order?", "logCreatedAt": "2021-12-06T15:04:38.302856", "logUpdatedAt": "2021-12-06T15:04:38.302856", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45171886, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 134, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45172477, "text": "A diamond of Postit notes with fruit written on. One at the top (apple) labelled 'The best', two below (mango and raspberries) labelled 'Next best', three in the middle (banana, grapes and strawberries) labelled 'In the middle', two below (orange and pineapple) labelled 'Not very good' and one at the bottom (melon) labelled 'The worst'.", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1638803039839_1image1-01FP848FWSRH0TECPQT4P0B99T.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 45171886, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 45172257, "text": "The word 'apple' written on a Postit note.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1638802835284_1image1-01FP841A4Y0SR1V14KEW2RCTH0.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{