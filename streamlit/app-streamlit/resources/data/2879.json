[{"id": 4620, "text": "<b>Top tip:</b>\n<br>When you choose your objects, pick things with interesting weights, that make a sound inside the box, or that move in interesting ways when you tip the box.\n<br></br>", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2879, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 120884071, "text": "761908852", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2879, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 3989, "text": "<h2>Setting up:</h2>\nDo this <b>without</b> your child.\n<br></br>\nYou will need:\n<ul>\n<li>3 boxes (different sizes)</li>\n<li>3 objects to put in the boxes</li>\n<li>Tape (optional)\n</ul>\n<br></br>\nWhat to do:\n<ol>\n<li>Find three boxes.</l>\n<li>Put an object inside each box.</li>\n<li>Close the boxes so you can't see what is inside!</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1636474938183_1image1-01FM2R3HD4TF7AENZHBYA4TZSF.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2879, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 3990, "text": "<h2>The activity:</h2>\nNow show your child the boxes!\n<br></br>\n<ol>\n<b><li>What could be in the first box?</b><dd>Don't touch it yet! </dd></li>\n<b><li>Does the size of the box give you any clues? </b><dd>Think of several ideas. Think of some things it definitely couldn't be!</dd></li>\n<b><li>Pick up the box. Hold it still and feel the weight. </b><dd>Does this change what you think it could be? Is there anything else you now know it can't be?</dd></li>\n<b><li>Give the box a little shake.</b><dd>Can you hear anything that gives you a clue?</dd></li>\n<b><li>Use all your senses to guess what could be in the box.</b><dd>Choose three things it could be, and then choose one to be your final guess.</dd></li>\n<b><li>Open the box to see if you were right!</b><dd>Did you guess anything that was nearly right? Is there anything you felt or heard that gave you a really good clue?</dd></li>\n<b><li>Repeat the activity with the other boxes.</b><dd>Use what you learned from the first box to help you work out the others!</dd></li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2879, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]