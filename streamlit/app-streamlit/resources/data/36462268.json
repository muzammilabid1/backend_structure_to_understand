[{"id": 36462577, "text": "<h2>Play with your ribbon stick:</h2>\nThis is probably best done outdoors!\n<ul style=\"list-style-position: inside\">\n<li>Swirl the stick around and see if you can make the ribbons form shapes in the air.</li>\n<li>See how the ribbons stream out behind you when you run.</li>\n<li>Try drawing shapes in the air to make the ribbons fly round.</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633948212454_1image1-01FHQEBFD783X46M3CN1YAA2KS.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36462268, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36462278, "text": "<h2>For this activity, you will need:</h2>\n<ul>\n<li>A stick. Something about 40cm long would work well, but you could also use a chopstick if you can’t find anything suitable in the garden or park.</li>\n<li>Ribbons. These can be actual ribbons, bits of string, or strips of fabric from a piece of worn-out clothing.</li>\n</ul>\n<br><br>\n<h2>Make your ribbon stick:</h2>\nTie ribbons around the top of your stick, leaving long tails so they can swirl about. ", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633948059800_1image1-01FHQE3VWKF75Z7Q4SPH1RNHBN.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": n