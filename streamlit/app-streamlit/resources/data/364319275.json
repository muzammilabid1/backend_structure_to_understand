[{"id": 364321086, "text": "A cartoon koala in a learning with parents t-shirt.", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Asset 339", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Asset 339-IOqExNeLzOgtH7lamR9sT.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 364319275, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "Mk4DyqW5CeNoxbV-ozVpD", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 489300598, "text": "Why we have activities with real money.", "modal": {"steps": [{"id": 489300122, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 436, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Sometimes activities suggest a child spends real money.</p>\n<p>We understand that for some families this may be difficult.</p>\n<p>There are always other activities in the topic that do not require any money.</p>\n<p></p>\n<h2>Why include these activities?</h2>\n<ul>\n<li>Real experiences have been found to be most effective for learning financial skills. *</li>\n<li>Having real money to spend is meaningful and motivating for children **</li>\n<li>Conversations about money in families often happen around pocket money.</li>\n</ul>\n<p></p>\n<h2>Does the amount of money matter?</h2>\n<ul>\n<li>The amount of money a child has to spend is not important for learning.</li>\n<li>It can be a very small amount.</li>\n<li>The learning comes from the experience of making their own spending decisions.&nbsp;&nbsp;</li>\n</ul>\n<p></p>\n<p>*<span style=\"font-size: 12px;\">Money and Pensions Service (2023) Developing children and young people's financial capability: Evidence Review.</span></p>\n<p><span style=\"font-size: 12px;\">** Whitebread and Bingham (2013) Habit formation and learning in young children. </span></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "jw2GOOuu_Og6CCo4vZhWz", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 436, "name": "Why do we include activities with real money?", "logCreatedAt": "2024-11-14T11:19:48.197134", "logUpdatedAt": "2024-11-14T11:19:48.197134", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": "Financial Literacy - real money rationale"}}, "order": 2, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 364319275, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 436, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "SUG33cNQMr_FEcLyExt7y", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 364320303, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 364319275, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>This activity gives your child experience of making a choice with real money.</p>\n<p>It can be done any time they have some money to spend.</p>\n<p>This could be pocket money or birthday money.</p>\n<p>Or, if you can, you could give them a small amount.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "ZDgtDotui805s4jm96Nx_", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 364319293, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 364319275, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<p>Help your child decide how to spend or save their money.</p>\n<ul>\n<li>Look together at the money they have.</li>\n<li>Talk about what they could buy.</li>\n<li>Talk about something they could save it for.&nbsp;</li>\n<li>Talk about anything coming up, like a day out or a school fair.</li>\n<li>They could spend some and save some.</li>\n<li>Help them to make a plan for the money and carry it out.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "LzfC8qFCfsbp4M4zXFjni", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]