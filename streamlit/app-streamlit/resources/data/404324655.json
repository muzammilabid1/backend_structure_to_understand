[{"id": 404325200, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 404324655, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<ul>\n<li>Secondary school - about 1000 people.</li>\n<li>Double decker bus - about 200 people.</li>\n<li>Local theatre - about 500 people.</li>\n<li>Ethiad Stadium Manchester - about 50,000 people.</li>\n<li>Small coach - about 50 people.</li>\n<li>Large Cruise ship - about 5,000 people.</li>\n<li>Wembly Stadium - about 90,000 people.</li>\n<li>The city, town or village where you live  . . .</li>\n</ul>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "weqHL5Mc0cmB1ZD8DoE3F", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 404329025, "text": "Tips to get started", "modal": {"steps": [{"id": 404328954, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 400, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>There are different ways to work these out.</p>\n<p>You may find different methods work best for different examples.</p>\n<p></p>\n<h2>Counting up:</h2>\n<p>You can count up in steps until you reach 1 million.</p>\n<p>50,000 . . .100,000 . . .150,000 . . ..&nbsp;</p>\n<p></p>\n<h2>Use a known fact:</h2>\n<p>I know there are 1000 thousands in 1 million.</p>\n<p>So there must be five 200s in a thousand.</p>\n<p>There must be five thousand 200s in a million.&nbsp;&nbsp;</p>\n<p></p>\n<h2>Division:</h2>\n<p>1,000,000 divided by 200 is 5,000</p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "IDwASJVEdtCGlxiqB-Wjk", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 400, "name": "Tips to get started", "logCreatedAt": "2024-09-18T10:05:45.397584", "logUpdatedAt": "2024-09-18T10:05:45.397584", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": "Y6 A million people tips"}}, "order": 5, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 404324655, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "se