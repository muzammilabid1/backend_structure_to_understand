[{"id": 120887707, "text": "763359167", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2935, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4088, "text": "<h2>You will Need:</h2>\nDays of the week cards (use your cards from Activity 2, click to download below, or make your own).", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2935, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4089, "text": "<h2>Tips for Clues:</h2>\nTry to use a mix of clues! Ones about:\n<ul>\n<li>Spelling<dd><i>\"It has an 'ur' sound in it,\" (Th<b>ur</b>sday) or \"It has a silent letter in it,\" (We<b>d</b>nesday).</i></dd></li>\n<li>Activities you usually do on that day<dd><i>\"We go to see Grandma,\" or \"You have an after school club.\"</i></dd></li>\n<li>Its position in the week<dd><i>\"It's a weekday\" or \"It comes after Tuesday.\"</i></dd></li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2935, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4477, "text": "<h2>How to play:</h2>\n<ol>\n<li>Pile up the days of the week cards face down.</li> \n<li>Secretly look at one card (don't show the other person). </li>\n<li>Give the other person three clues to help them work out which day you are looking at. </li>\n<li>When they have guessed, swap over.</li>\n<li>Repeat until you have used up all the cards.</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2935, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4478, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2935, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": "1637055175977_1download1-01FMM1C8ZV2RZGVV9V8AC63ASR.pdf", "editorState": null, "carouselData": null, "downloadName": "Days of the Week Cards", "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]