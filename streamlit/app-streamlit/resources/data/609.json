[{"id": 279072152, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 609, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ul>\n<li>The aim is to be the first player to get to 100.</li>\n<li>Both players start at 0 and take it in turns to add the number that they roll to their total.&nbsp;</li>\n<li>You can draw a numberline to help you with the calculations.</li>\n<li>The first player to get to 100 wins - it doesn't matter if they go over.&nbsp;</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "Z_cQdMul5tfALxPqvFF8o", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 803, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "DICE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 609, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[9, 19, 29]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 452496330, "text": "A note for parents", "modal": {"steps": [{"id": 452496180, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 413, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<ul>\n<li><strong>This aim of this game </strong>is to keep practicing the same strategy in a fun way.</li>\n<li>Adding or subtracting a multiple of ten then adjusting is a useful way to do some calculations in your head.</li>\n<li>Confidence with this will help children with calculations now and in the future.</li>\n<li><strong>To make the most of the game</strong>, encourage children to keep using the 'near multiples' strategy.</li>\n<li>If they need to write calculations, use a number line.</li>\n<li>Counting in ones or column addition gets the answer <strong>but </strong>doesn't show the pattern or give the same practice here.&nbsp;&nbsp;</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "3DgClfhC1up9XXqELvfop", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 413, "name": "A note for parents", "logCreatedAt": "2024-10-14T11:34:26.844204", "logUpdatedAt": "2024-10-14T11:34:26.844