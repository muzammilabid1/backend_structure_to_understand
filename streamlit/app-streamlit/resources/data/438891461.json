[{"id": 438898876, "text": "Types of data explained.", "modal": {"steps": [{"id": 438898791, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 408, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Discrete data&nbsp;</h2>\n<p>This is data that can be counted.</p>\n<p>It is usually whole numbers.&nbsp;&nbsp;</p>\n<p>There isn't meaningful information between the numbers.</p>\n<p><strong>For example</strong>: The number of cats each house in a street has. Any whole number of cats is possible but you can't have half a cat!</p>\n<p>Discrete data can be shown in bar charts, pictograms and pie charts.</p>\n<p></p>\n<h2>Continuous data</h2>\n<p>This is data that is changing continually.</p>\n<p>It is measured at intervals rather than counted.</p>\n<p>There is meaningful information between the points that are measured</p>\n<p><strong>For example</strong> - a child's height can be measured every year.  The child is growing slowly between these measurements.  You can estimate the child's height halfway between measurements.</p>\n<p>Continuous data can be shown in line graphs.</p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "vK6VXNcOXGyAgtUvbivWO", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 408, "name": "Types of data explained", "logCreatedAt": "2024-10-07T14:48:26.161974", "logUpdatedAt": "2024-10-07T15:17:55.138634", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": "Line graphs - help for parents on types of data"}}, "order": 3, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 438891461, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 408, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "MTlt_YlNFamOJu39Aib0J", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 438893262, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 438891461, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Extra Challenge:</h2>\n<ul>\n<li>Choose one example from the carousel.</li>\n<li>Talk about what the axis could be.</li>\n<li>For example: A child's height would have time (in months or years) on the x-axis and height (in cm) on the y-axis.&nbsp;&nbsp;</li>\n<li>Talk about what the graph might look like.</li>\n<li>For example - the graph showing the height of the child would have a line going up slowly. It might go flat if the child stayed the same height for a while. It would never turn down again as the child would never get smaller.&nbsp;&nbsp;</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "5dl5gkRV9GzjFBKJ2dYJ8", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 438893149, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 438891461, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "gKPMhUdxwelhC10mjMuYG", "textEditorState": "<p>The height of a growing seedling&nbsp;</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "3mlxORfs-T0NH2bqN4jLW", "textEditorState": "<p>The temperature of a cup of hot chocolate.</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "LCHs8VWR04TKrCAP7S4aS", "textEditorState": "<p>The number of books a child has read each month.</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "JSBhSHNG4fs46M9G_yBaw", "textEditorState": "<p>The number of siblings each person in a class has.</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "TG-gadCnbmMVS4JiAU_Hi", "textEditorState": "<p>The amount of rain collected in a water butt in the garden.</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "ZCmaBBnIj75EJZ-QSPzT_", "textEditorState": "<p>The height of a child.</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "BtwTEINhh49VfPmfjWy-6", "textEditorState": "<p>The mass of a growing kitten.</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "CAZKt3C7ypCJMjXwcVoQc", "textEditorState": "<p>The favourite sandwich filling of everyone in the class.</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "JtIk6krwtqzpcoIEClG1Z", "textEditorState": "<p>The shoe size of everyone in the class.</p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "bsEHg7gy4lI5iiAqVzU3A", "textEditorState": "<p>The number of boys and girls in each class.</p>\n", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "UNM9VB4e4cLc9nM8FP9Cg", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 438892194, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 438891461, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<ul>\n<li>Look at the different types of data on the carousel.</li>\n<li>Is it <strong>continuous</strong>?  This means the data is changing all the time.</li>\n<li>Is it <strong>discrete</strong>? This means the data is a number that can be counted.&nbsp;</li>\n<li>Line graphs are used for continuous data.</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "jBn4QKzR1Ow9fZ5nnIx0f", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]