[{"id": 3970, "text": "You can do this activity with any book. It can be fun with a book you have never read, but would also work well with a familiar book.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2867, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 118803570, "text": "761878326", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2867, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4573, "text": "<br></br>\n<h2>Part 1. Look at the cover of the book</h2> \n<ol>\n<li>Can you find the title of this book? </li> \n<li>What is the title for? </li>\n<li>What does it tell you about the story in the book? </li>\n</ol> \n<br></br>\n<h2>Part 2. Read the book</h2>\nWhen you have read it, talk about these questions together:\n<ol>\n<li>Do you think it was a good title for the book? Why?</li> \n<li>Was there anything important missing from the title? Was that a good or a bad thing? </li>\n</ol>\n<br></br>\nLook here for more discussion ideas:", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2867, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40917216, "text": "More questions to think about", "modal": {"steps": [{"id": 40917086, "text": null, "order": 1, "btnType": null, "linkUrl": null, "modalId": 61, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Look at the front cover of your book and think about these questions:&nbsp;</p>\n<ul>\n<li>What is the title of the book?</li>\n<li>Where is the title of the book? At the top? In the middle? Why do you think it is in this place?</li>\n<li>Why do you think the book has this title?</li>\n<li>How does the title make you feel?</li>\n<li>Does the title sound interesting to you? Why/why not?</li>\n<li>Does the title tell you what kind of book it is? (fiction/non-fiction/poetry)</li>\n<li>What else can you say about the title? (perhaps it is bigger than other writing? Or written in a bright colour?)</li>\n<li>What other information can you find on the front cover?</li>\n</ul>\n<p></p>\n<p>When you have read your book, have a look at the questions again and see if you have changed your mind about anything you discussed!</p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 61, "name": "More Questions to Think About", "logCreatedAt": "2021-11-09T15:32:43.07714", "logUpdatedAt": "2021-11-09T15:32:43.07714", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 2867, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 61, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]