[{"id": 370080018, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 370079933, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<ul>\n<li>Practice counting forward and backwards to 20.</li>\n<li>Check your child is saying all the numbers.</li>\n<li>Check they say the '<strong>een</strong>' at the end of teen and the '<strong>ty</strong>' at the end of twenty.&nbsp;&nbsp;</li>\n</ul>\n<p></p>\n<h2>Ways to practice:</h2>\n<ul>\n<li>Count actions - jumps, hops, skips.</li>\n<li>Count in silly voices - count like a witch, count like a mouse.</li>\n<li>Walk forward to count forward then backward to count back.</li>\n<li>Count together - take it in turns to say each number.&nbsp;&nbsp;</li>\n<li>Count small objects like lego bricks.&nbsp;&nbsp;</li>\n<li>Count when you are out and about - cars, railings, steps.</li>\n<li>Throw and catch a ball and count.</li>\n</ul>\n<p></p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "_K15GH4oHIn-2eD8SLIA2", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 370937889, "text": "A drawn koala jumping", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Ass