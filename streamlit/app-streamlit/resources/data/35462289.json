[{"id": 35462485, "text": "<h2>Part 2: Write Two Sentences</h2>\nWrite two sentences underneath using inverted commas to show what they are saying, in the form \"___\" said ___. \"___\" said ___. \n<br></br>\n Use these steps to help you:\n<ol>\n<li>Start by writing the words from your speech bubble.</li>\n<li>If you used a full stop at the end of the sentence in your speech bubble, change it to a comma in this sentence. If you used an exclamation or question mark, it can stay the same.</li>\n<li>Then add the inverted commas.</li>\n<li>Then add 'said___.' </li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35462289, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35462359, "text": "<h2>Part 1: Draw Your Picture</h2>\n<ol>\n<li>Draw a picture of two characters from a story.</li>\n<li>Then give each one a speech bubble and write inside what they are saying to each other. </li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35462289, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": nul