[{"id": 120898278, "text": "763813986", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2940, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4079, "text": "<h2>How to play:</h2>\n<ol>\n<li>Player 1 picks an animal. Don't say out loud what you have chosen!</li>\n<li>Player 1 describes the animal by saying what it does, e.g. 'It <span style=\"color:#F28D00\">hops</span>.' Try to give at least three clues.</li>\n<li>Player 2 must guess what it is.</li>\n<li>If Player 2 can't guess, Player 1 might need to give some extra clues.</li> \n<li>When Player 2 has guessed, swap over so they can give some clues. </li>\n<li>Repeat with six or more different animals.</li> \n</ol>\n<br></br>\n<h2>Example:</h2>\nHere are some example clues, with the important verbs (doing words) highlighted:\n<ul>\n<li>It <span style=\"color:#F28D00\">jumps</span>.</li>\n<li>It <span style=\"color:#F28D00\">sits</span> on a log.</li>\n<li>It <span style=\"color:#F28D00\">catches</span> flies.</li>\n<li>It <span style=\"color:#F28D00\">swims</span> in a pond.</li>\n<li>It <span style=\"color:#F28D00\">croaks</span>.</li>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": nul