l": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to plaY:</h2>\n<p>Before you start, lay the cards out in a line from 0-20. Turn them over so you can't see the numbers.</p>\n<ol>\n<li>Flip one card over and say the number.</li>\n<li>Choose a target card.</li>\n<li>Count up (or down) to the target card. It can help if you put a finger on the next card each time you say a number.</li>\n<li>When you get to the target card, flip it over and see if you were right!</li>\n<li>Repeat with a new start and new target.</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "KQxlHndgGFvNs3s0A4xav", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]