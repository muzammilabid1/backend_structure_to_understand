istImageData": null, "clickableAlphabetData": null}, {"id": 76174504, "text": null, "modal": {"steps": [null], "details": null}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 36908971, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Challenge 3: Get competitive!</h2>\n<ol>\n<li>Choose a category,</li>\n<li>Both players write three things from the category.</li>\n<li>Swap lists and put the other person's list into alphabetical order.&nbsp;</li>\n<li>The winner is the person to finish first.</li>\n</ol>\n<p><strong>Tip: </strong>You can make it harder for the other person by choosing things which have lots of letters in common, like in the example below!</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 76174460, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 36908971, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Challenge 2: The next letters</h2>\n<ol>\n<li>Choose another category (or the same again if you want).</li>\n<li>Write three things which begin with the same letter, e.g.  Baloo, Belle, Beast (Disney characters).</li>\n<li>Put them in alphabetical order. Remember, you can't use the first letter this time, but have a look at the second. If the second letters are the same, look at the third. etc.</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 76175096, "text": null, "modal": {"steps": [null], "details": null}, "order": 7, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 36908971, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Example 3\nCategory: Food</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Three things: \nchicken, chips, chickpeas</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">Alphabetical order:\nchicken, chickpeas, chips</p