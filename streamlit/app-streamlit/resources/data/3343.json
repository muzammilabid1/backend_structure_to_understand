[{"id": 4520, "text": "For this activity you will need a mirror. <br></br>\nAsk you child to hold up a number of fingers and count them together. <br></br>\nThen, ask them to count how many fingers there are in the mirror (you could point to each of their fingers in turn as they count them). <br></br>\nFinally, ask them to count how many fingers there are in total (their 'real' ones plus those in the mirror). <br></br>E.g. If there are 3 on their hand, and 3 in the mirror, then there are 6 overall. That means 6 is double 3. ", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "Mirror magic, double and half-ykS-yHThDu8D_d2Pepi5d.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 3343, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4535, "text": "Repeat the activity with different numbers and practise talking about doubling and halving with your child.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1637138109845_1image1-01FMPGCXENABSDBD1ZHZYKTTGG.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 3343, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSecon