[{"id": 123401474, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 123400610, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>ow to play - version 1</h2>\n<ul>\n<li>Count up in ones in a whisper.</li>\n<li>When you get to a multiple of 5, shout the number.</li>\n<li>1,2,3,4,<span style=\"font-size: 24px;\">5</span>,6,7,8,9,<span style=\"font-size: 24px;\">10</span><span style=\"font-size: 16px;\">,11,12,13,14,</span><span style=\"font-size: 24px;\">15 </span><span style=\"font-size: 16px;\">. . .</span></li>\n<li><span style=\"font-size: 16px;\">If you are feeling confident, count backwards.</span></li>\n</ul>\n<p></p>\n<p></p>\n<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: 24px;font-family: Chaloops-Medium;\">How to play - version 2</span></p>\n<ul>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">Count up in 1s.</span></li>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">Clap on the multiples of 5 instead of saying the number.</span></li>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">1,2,3,4, [clap], 6,7,8,9, [clap] . . .</span></li>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">If you're feeling confident, count backwards.</span></li>\n</ul>\n<p></p>\n<p style=\"text-align:left;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: 24px;font-family: Chaloops-Medium;\">How to play - version 3</span></p>\n<ul>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">Count up in 1s</span></li>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">Clap on the multiples of 5 AND stamp your foot on the multiples of 10!</span></li>\n</ul>\n<p></p>\n<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: 16px;font-family: Verdana;\">What do you notice about the stamps and claps?</span></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 370853572, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "2024-127075292", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "2024-127075292-RZNb1oSWveYZzEZJV6KNm.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 123400610, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "90OOj79aLSycVsmlsoz3v", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklis