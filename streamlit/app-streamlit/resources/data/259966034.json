l1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 259966034, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Warmup:</h2>\n<ol>\n<li>Shine your light at the wall.</li>\n<li>Put your hand between the light and the wall to block the light and make a shadow.</li>\n<li>How far from the wall and the light should you put your hand to make the clearest possible shadow?</li>\n<li>How does the size of the shadow change when you move your hand?</li>\n<li>What different shaped shadows can you make with your hands? Have a look at the pictures below for some ideas.</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "lx_H8BV8PFN_MMEbwj-fr", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]