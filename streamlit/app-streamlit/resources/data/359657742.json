height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Which version of the song did you prefer?</span>&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "ka-Nwk5RKBbs2MEJk0hrE", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 359659325, "text": null, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "modalId": 328, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Children often get muddled in the middle of the alphabet with the letters</span> <span style=\"color: rgb(242,141,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">l m n o p</span><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">. Try to slow down their singing of this part (like in this second video) so they really sound like separate letters and not one \"lemonenopea\"!</span>&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "v_uoXOiPZdHtNZqmNhnqo", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 359659297, "text": "863526790", "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 328, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "C6U8NS5Oa1OTApiluKR5L", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 359659284, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 328, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Here are two videos of the alphabet song.&nbsp;</p>\n<p style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">This first one might be a new tune to you, but it is really helpful because it helps you say all the letters separately. </span></p>\n<p style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Try to encourage the British pronunciation of</span> <span style=\"color: rgb(242,141,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">z 'zed'</span> <span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">rather than the American z 'zee'.</span>&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "qnBuwxJxXytyK0oG39L4J", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 359659331, "text": "762323131", "order": 4, "btnType": "PRIMARY", "linkUrl": null, "modalId": 328, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "nHkmcZ8Nzk1IOI4jtjNqB", "checked": false, "listItem": ""}], "description