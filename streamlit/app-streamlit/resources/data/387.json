[{"id": 440, "text": "If you live in a house with stairs, number them with a small sticker 1,2,3 etc. Each night as your child walks up stairs to bed they have to work out a different calculation by walking along the stairs number line. (e.g. 2x4 means 4 steps of 2 stairs at a time, ending on step 8).<br /><br />If you don't have any stairs, write some numbers on piece of paper and place them in order leading from one room to another. Complete the same activity above by stepping on these numbers.<br /><br /> ", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "Multiplying stairs, multiplication on a number line-wRAIRrM_eOQ4RKiJEWtRm.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 387, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 117137601, "text": "Safety on the Stairs", "modal": {"steps": [{"id": 117137503, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 216, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Remind children to be