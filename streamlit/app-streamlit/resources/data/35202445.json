[{"id": 35202929, "text": "Find a story to read together, either a real book or one of these suggestions:\n<ul>\n<li>A book from home, school or the library;</li>\n<li>A YouTube reading of a story;</li>\n<li>A story on CBeebies Radio;</li>\n<li>One of the CBeebies bedtime stories;</li>\n<li>An audiobook from the library;</li>\n<li>A story you can tell without a book.</li>\n</ul>\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "Asset 285-0ZvQ_VdhfS8zHxYjX4_D_.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35202445, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35203204, "text": "<h2>What to Do:</h2>\nWhile you are reading, stop and ask some of these questions (maybe just choose one at a time, but cover several as you go through the whole story):\n<ul>\n<li>Why did she do that?</li>\n<li>Why is he sad/happy/angry/excited?</li>\n<li>Why do you think they used the word ‘…’ there?</li>\n<li>Why is that happening in the picture?</li>\n<li>Did you like the book? Why did/didn’t you like this book? </li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35202445, "dimensions": null, "editAsHtml": false, "properties": {"inputArray"