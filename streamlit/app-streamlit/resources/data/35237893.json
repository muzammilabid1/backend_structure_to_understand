[{"id": 40848910, "text": "Example Instructions", "modal": {"steps": [{"id": 40848808, "text": "<ol>\n<li>Get a slice of bread. </li>\n<li>Put the bread in the toaster. </li>\n<li>Toast the bread until it is getting a bit brown. </li>\n<li>Put the toast on a plate. </li>\n<li>Use a knife to spread your favourite topping on the toast. Well done, it is ready to eat! </li>\n</ol>", "order": 3, "btnType": null, "linkUrl": null, "modalId": 54, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40848819, "text": null, "order": 2, "btnType": null, "linkUrl": null, "modalId": 54, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p style=\"text-align:center;\"><span style=\"font-size: 30px;font-family: Chaloops-Medium;\">How to Make Toast</span></p>\n"