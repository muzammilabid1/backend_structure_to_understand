[{"id": 454425997, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 452539170, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "LP9tacnA_sGQkviu5d0Kj", "textEditorState": "<p><span style=\"font-size: 18px;\">What did you imagine when you were reading?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "eTxYXwVv_YBnUOTR5e1HH", "textEditorState": "<p><span style=\"font-size: 18px;\">How does Dylan Thomas help you imagine the darkness?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "IEH1vPg_aTGIeTYf5Vzgn", "textEditorState": "<p><span style=\"font-size: 18px;\">How are moles used to help you imagine the scene?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "B66TgyfwLk5j5BLdrgYnQ", "textEditorState": "<p><span style=\"font-size: 18px;\">Why do you think Dylan Thomas joined three words together to make “fishingboatbobbing”?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "C9fAVZUJq2CTpQ7Arvni6", "textEditorState": "<p><span style=\"font-size: 18px;\">Is the town a happy place? What clues are there in the writing?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "GfPj31Obp0l7uISCAcPHO", "textEditorState": "<p><span style=\"font-size: 18px;\">Personification is when you describe objects (or animals) as if they were people, e.g. “The lightning danced across the sky”.</span></p>\n<p><span style=\"font-size: 18px;\">Can you find any examples of personification in the writing? What effect do you think they have?</span></p>\n", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "fileIdentifier": "2s00DlM3tio_aYwFCai4d", "textEditorState": "<p><span style=\"font-size: 18px;\">Why do you think the people come last in the description?</span></p>\n", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "b9zt3pOZa4ybVvnrVgZb-", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 454487775, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 452539170, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p style=\"text-align:center;\"><strong>***</strong></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "TzqDrAS-jlxtzuAiewDld", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 454425330, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 452539170, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p style=\"text-align:center;\"><span style=\"font-size: 24px;font-family: SassoonInfantRg-Regular;\"><em>Extract from </em>Under Milk Wood </span></p>\n<p style=\"text-align:center;\"><span style=\"font-size: 18px;font-family: SassoonInfantRg-Regular;\">by Dylan Thomas</span></p>\n<p><span style=\"font-size: 18px;font-family: SassoonInfantRg-Regular;\">It is spring, moonless night in the small town, starless and bible-black, the cobblestreets silent and the hunched, courters’-and-rabbits’ wood limping invisible down to the sloeblack, slow, black, crowblack, fishingboatbobbing sea. The houses are blind as moles (though moles see fine to-night in the snouting, velvet dingles) or blind as Captain Cat there in the muffled middle by the pump and the town clock, the shops in mourning, the Welfare Hall in widows’ weeds. And all the people of the lulled and dumbfound town are sleeping now.</span></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "YytnGpGNWtP1vTbSdSHjv", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 454425663, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 452539170, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>What to do:</h2>\n<p>Read this extract from 'Under Milk Wood' together.&nbsp;</p>\n<p>Try to imagine the town as you read.</p>\n<p>Then discuss the questions below. <em>There are no correct answers - these questions are just to get you talking and sharing your own thoughts.</em></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "5FXeHmzfe4db8OcHc94cG", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]