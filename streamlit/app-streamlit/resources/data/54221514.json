[{"id": 82679919, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 54221514, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<p>In this activity, you will be sorting words. There is not one correct answer - the thinking and talking is important, not the answer!</p>\n<ol>\n<li>Cut out the word cards and spread them out so you can see them all.</li>\n<li>Work together to sort them into order: <strong>fewest to most</strong> (from ones that suggest the fewest of something to the ones which suggest the most of something).&nbsp;</li>\n</ol>\n<p></p>\n<p>Here are some things to talk about while you are sorting:</p>\n<ul>\n<li>Why are you choosing that order?</li>\n<li>If there are two words which suggest the same amount, put them next to each other and talk about why.</li>\n<li>Are there any words which are hard to place? Why?</li>\n</ul>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 82679949, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'h