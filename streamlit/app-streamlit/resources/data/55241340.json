, "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">stirs</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">dams</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">posies</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">gillyflowers</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">borne</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p style=\"font-size:32px;\">blast</p>", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{\"text\":[{\"text\":\"stirs\",\"fontSize\":\"32\"},{\"text\":\"dams\",\"fontSize\":\"32\"},{\"text\":\"posies\",\"fontSize\":\"32\"},{\"text\":\"gillyflowers\",\"fontSize\":\"32\"},{\"text\":\"borne\",\"fontSize\":\"32\"},{\"text\":\"blast\",\"fontSize\":\"32\"}]}", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 118978907, "text": "Read the poem online", "modal": {"steps": [{"id": 118978662, "text": null, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 223, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p style=\"text-align:center;\">&nbsp;<span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">January brings the snow,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Makes our feet and fingers glow.</span>&nbsp;</p>\n<p style=\"text-align:center;\">&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">February brings the rain,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Thaws the frozen lake again.</span>&nbsp;</p>\n<p style=\"text-align:center;\">&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">March brings breezes loud and shrill,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Stirs the dancing daffodil.</span>&nbsp;</p>\n<p style=\"text-align:center;\">&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">April brings the primrose sweet,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Scatters daisies at our feet.</span>&nbsp;</p>\n<p style=\"text-align:center;\">&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">May brings flocks of pretty lambs,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Skipping by their fleecy damns.</span>&nbsp;</p>\n<p style=\"text-align:center;\">&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">June brings tulips, lilies, roses,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Fills the children's hand with posies.</span>&nbsp;</p>\n<p style=\"text-align:center;\">&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Hot July brings cooling showers,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Apricots and gillyflowers.</span>&nbsp;</p>\n<p style=\"text-align:center;\">&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">August brings the sheaves of corn,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Then the harvest home is borne.</span>&nbsp;</p>\n<p style=\"text-align:center;\">&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Warm September brings the fruit,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Sportsmen then begin to shoot.</span>&nbsp;</p>\n<p style=\"text-align:center;\">&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Fresh October brings the pheasants,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Then to gather nuts is pleasant.</span>&nbsp;</p>\n<p style=\"text-align:center;\">&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Dull November brings the blast,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Then the leaves are whirling fast.</span>&nbsp;</p>\n<p style=\"text-align:center;\">&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Chill December brings the sleet,</span>&nbsp;</p>\n<p style=\"text-align:center;\"><span style=\"font-size: 14pt;font-family: Sassoon Infant Std;\">Blazing fire, and Christmas treat.</span>&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 118978782, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 223, "audioUrl": null, "fileName": "'The Months' by Sara Coleridge Y5orY6", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": "'The Months' by Sara Coleridge-2-uA06_dIM4k7a_cD9gmq.pdf", "editorState": null, "carouselData": null, "downloadName": "Download pdf", "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 223, "name": "'The Months' by Sara Coleridge", "logCreatedAt": "2023-07-05T12:46:24.360011", "logUpdatedAt": "2023-07-05T12:46:24.360011", "logCreatedById": 21670528, "logUpdatedById": 21670528, "nameForContentDev": null}}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType":