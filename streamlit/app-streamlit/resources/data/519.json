""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 222534963, "text": null, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "modalId": 280, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Any small items can be used as counters in games and activities:</p>\n<p></p>\n<ul>\n<li>Pasta pieces</li>\n<li>Lego bricks</li>\n<li>Dried peas or beans</li>\n<li>Plasticine&nbsp;</li>\n<li>Raisins</li>\n<li>Pen lids</li>\n<li>Sweets</li>\n<li>Beads&nbsp;</li>\n<li>Buttons</li>\n<li>Coins</li>\n<li>Small pieces of card</li>\n</ul>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 280, "name": "Counters", "logCreatedAt": "2023-12-05T12:16:38.550808", "logUpdatedAt": "2023-12-05T12:16:38.550808", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": null}}, "order": 2, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData"