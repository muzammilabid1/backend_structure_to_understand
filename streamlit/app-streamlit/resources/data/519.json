O", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 519, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "1AsfK9YOVAcUSVtas5uWt", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 122208745, "text": null, "modal": {"steps": [null], "details": null}, "order": 8, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 519, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2 style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-family: Chaloops-Medium;\">Extra challenge:</span></h2>\n<ul>\n<li style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Play again but add your own rules.</span></li>\n<li style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Maybe you can add more counters.</span></li>\n<li style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Maybe you have a different target.</span></li>\n<li style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Check everyone knows the rules before you start!</span></li>\n</ul>\n<p style=\"text-align:start;\"><br>&nbsp;</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 122208238, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 519, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You will need:</h2>\n<ul>\n<li>20 counters or other small objects such as pasta pieces.</li>\n<li>Two tens-frames drawn on paper or printed out.</li>\n</ul>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]