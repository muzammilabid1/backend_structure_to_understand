[{"id": 370079147, "text": null, "modal": {"steps": [null], "details": null}, "order": 7, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 519, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2 style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-family: Chaloops-Medium;\">Tips for parents:</span></h2>\n<ul>\n<li style=\"text-align:start;\"><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Encourage your child to count aloud.</span></li>\n<li><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">Count on each time rather than starting at one.</span></li>\n</ul>\n<p style=\"text-align:start;\"></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "DaCus-eTxljb--AYxAM2W", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 122297123, "text": "Two tens frames drawn on paper with a pile of pasta next to them.", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Thirteen game", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Thirteen game-x4Ju908J3FGAvkRyW31wL.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 519, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 122208253, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 519, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Choose a target number between 13 and 20.</li>\n<li>Take it in turns to add one or two counters to the tens frame.</li>\n<li>Place the counters in order. Fill up one frame before you go on to the next.</li>\n<li>The winner is the player who places the target number.</li>\n<li>Choose another target number and play again!</li>\n</ol>\n<h2></h2>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 371908107, "text": "How do maths games help with learning?", "modal": {"steps": [{"id": 324071304, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 316, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Fun</h2>\n<p>Games can be an enjoyable, motivating way to practice a skill many times.</p>\n<p></p>\n<h2>Positive feelings</h2>\n<p>Having fun together encourages positive feelings towards maths and can reduce worry about making mistakes.</p>\n<p></p>\n<h2>Memory</h2>\n<p>Skills that are practiced when a child is fully engaged and relaxed are more likely to be remembered.</p>\n<p></p>\n<h2>Number sense</h2>\n<p>In trying to win, children really think about the numbers they choose. This builds number sense - a deeper, more flexible understanding of numbers.</p>\n<p></p>\n<h2>Problem solving</h2>\n<p>Finding strategies to win develops problem solving skills.</p>\n<p></p>\n<h2>Mathematical Vocabulary</h2>\n<p>Talking about a game or explaining it to someone else encourages children to use mathematical vocabulary.</p>\n<p></p>\n<h2>Deeper thinking</h2>\n<p>Changing a rule and talking about how that impacts a game encourages an even deeper level of thinking.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "lSemXJT2fEci8gnLBBGXj", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 316, "nam