labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{\"text\":[{\"text\":\"Multiples of 3 are odd numbers.\",\"fontSize\":\"32\"},{\"text\":\"Multiples of 3 end in 3.\",\"fontSize\":\"32\"},{\"text\":\"Multiples of 3 can be divided into 3 equal groups.\",\"fontSize\":\"32\"},{\"text\":\"Multiples of 3 are also multiples of 10.\",\"fontSize\":\"32\"},{\"text\":\"Doubling a multiple of 3 makes an odd number.\",\"fontSize\":\"32\"},{\"text\":\"If you add the digits of a multiple of 3, you get a multiple of 3. \\n\\n         For example, adding the digits of 12 means 1+2=3\",\"fontSize\":\"32\"}]}", "checkListTextData": {"heading": "", "checkList": [{"key": "Kw6ivk_-1SHV8vuBmaXpf", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 131721073, "text": "Answers", "modal": {"steps": [{"id": 131720932, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 234, "audioUrl": null, "fileName": null, "fontSize": 0, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<ul>\n<li>Multiples of 3 are odd numbers&nbsp;</li>\n</ul>\n<p>This is <strong>sometimes </strong>true. 3 is odd, 6 is even, 9 is odd etc . .</p>\n<p></p>\n<ul>\n<li>Multiples of 3 end in 3</li>\n</ul>\n<p>This is <strong>sometimes </strong>true.  3, 33, 63 are some examples.</p>\n<p></p>\n<ul>\n<li>Multiples of 3 can be divided into equal groups</li>\n</ul>\n<p>This is <strong>always </strong>true.</p>\n<p></p>\n<ul>\n<li>Multiples of 3 are also multiples of 10.</li>\n</ul>\n<p>This is <strong>sometimes </strong>true. 30,60 and 90 are examples.</p>\n<p></p>\n<ul>\n<li>Doubling a multiple of 3 gives an odd number.</li>\n</ul>\n<p>This is <strong>never </strong>true.  Doubling any number gives an even number.</p>\n<p></p>\n<ul>\n<li>When you add the digits of a multiple of 3 together, you get a multiple of 3.</li>\n</ul>\n<p>This is <strong>always </strong>true.&nbsp;&nbsp;</p>\n<p>For example&nbsp;</p>\n<p>12 is 1+2 = 3</p>\n<p>18 is 1 + 8 = 9</p>\n<p>27 is 2+7 = 9</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 234, "name": "Answers", "logCreatedAt": "2023-09-06T10:47:18.264484", "logUpdatedAt": "2023-09-06T10:47:18.264484", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": null}}, "order": 4, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 124128633, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 234, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 371018336, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "bt