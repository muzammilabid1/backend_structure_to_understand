mageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 131718733, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 124128683, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<h2>Version 1</h2>\n<p>In this game, you only say the multiples of 3 out loud.</p>\n<p>For the other numbers you tap on the table or clap.</p>\n<p>It will sound like this:</p>\n<p>tap  tap<span style=\"font-size: 24px;\"><strong> 3</strong></span>  tap  tap  <span style=\"font-size: 24px;\"><strong>6</strong></span>  tap tap <span style=\"font-size: 24px;\"><strong>9</strong></span> . .&nbsp;</p>\n<p></p>\n<h2>Version 2</h2>\n<p>In this game, you play in the same way, but swap players whenever you choose:</p>\n<p>Player 1:  <span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">tap  tap</span><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: 24px;font-family: Verdana;\"><strong> 3</strong></span><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">  tap  tap  </span><span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: 24px;font-family: Verdana;\"><strong>6</strong></span> swap</p>\n<p>Player 2: tap  tap <span style=\"font-size: 24px;\"><strong>9</strong></span><span style=\"font-size: 16px;\"> tap tap </span><span style=\"font-size: 24px;\"><strong>12</strong></span><span style=\"font-size: 16px;\"> tap tap </span><span style=\"font-size: 24px;\"><strong>15 </strong></span><span style=\"font-size: 16px;\">swap</span></p>\n<p></p>\n<h2><span style=\"font-size: 24px;\">Version 3</span></h2>\n<p><span style=\"font-size: 16px;\">In this game you count in 1s, taking it in turns, but this time don't say the mulitiples of 3. Clap instead.</span></p>\n<p><span style=\"font-size: 16px;\">Player 1: </span><span style=\"font-size: 24px;\"><strong>1</strong></span></p>\n<p><span style=\"font-size: 16px;\">Player 2: </span><span style=\"font-size: 24px;\"><strong>2</strong></span></p>\n<p><span style=\"font-size: 16px;\">Player 1: </span><span style=\"font-size: 24px;\"><strong>clap</strong></span></p>\n<p><span style=\"font-size: 16px;\">Player 2: </span><span style=\"font-size: 24px;\"><strong>4</strong></span></p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]