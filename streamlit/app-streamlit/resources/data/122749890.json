[{"id": 122751501, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 122749890, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Extra Challenge:</h2>\n<p>Count to numbers beyond 100</p>\n<p></p>\n<h2>Finding it tricky:</h2>\n<p>Stay with numbers below 50 and count the sounds aloud.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 122749906, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 122749890, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Warm up:</h2>\n<p>Count up to 100 in tens together a couple of times to make sure your child feels confident.</p>\n<p></p>\n<h2>What to do:</h2>\n<p>Choose a simple sound to make -  knocking on the table or tapping a cup with a spoon.</p>\n<p>If you have some 10p coins, you could drop them in a cup.</p>\n<p></p>\n<ul>\n<li>Player 1 closes their eyes.</li>\n<li>Player 2 makes the sound.</li>\n<li>Player 1 counts the sounds in their head in tens then says the total.</li>\n</ul>\n<p></p>\n<h2>For example:</h2>\n<ul>\n<li>Player 2: \"Tap, tap, tap, tap\"</li>\n<li>Player 1: 40.<br></li>\n<li>Player 1: Tap, tap, tap,</li>\n<li>Player 2: 30&nbsp;</li>\n</ul>\n<p></p>\n<h2></h2>\n<p></p>\n<p></p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 130869364, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Year 1 counting in 10s counting sounds", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Year 1 counting in 10s counting sounds-B9sQ1ZKN3gbg0By3LAc7E.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 122749890, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]