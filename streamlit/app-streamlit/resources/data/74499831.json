[{"id": 74501230, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74499831, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to draw the snowman:</h2>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74562875, "text": "1: draw a big circle for the body. 2: draw a smaller circle on top for the head. 3: draw one stick arm. 4: draw the other stick arm. 5: draw a hat on its head. 6: draw a carrot nose. 7: draw one eye. 8: draw the other eye. 9: draw the mouth.", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "snowman instructions", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "snowman instructions-NEMJbPavZTdRMoz9OlQcV.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74499831, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74499920, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74499831, "dimensions": null, "editAsHtml": true, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Player 1 rolls the die below to choose a word (don't show the other person).</li>\n<li>On the paper, Player 1 draws lines to show how many letters are in the word, e.g. 'fish' would be _ _ _ _</li>\n<li>Player 2 guesses a letter that could be in the word.</li>\n<ul>\n<li>If the letter is in the word, Player 1 writes it in the space (or spaces) that go with the letter.</li>\n<li>If the letter is not in the word, Player 1 writes it below the spaces and draws the next part of the snowman.</li>\n</ul>\n<li>Player 2 keeps guessing letters.</li>\n<ul>\n<li>If Player 2 guesses the word before the snowman is finished, they win.</li>\n<li>If the snowman is finished before Player 2 guesses the word, Player 1 wins.</li>\n</ul>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 80510341, "text": "Example game. There is a dashed line along the top of the page with seven spaces for letters: _ a _ e _ _ l. Underneath, three parts of the snowman have been drawn and there are three unused letters: t, s and m.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Snowman activity example blob", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Snowman activity example blob-2VoRokRNYGwaqlIRKu5Ws.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74499831, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 74501035, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXTDICE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 74499831, "dimensions": null, "editAsHtml": false, "properties": {"height": null, "btnText": null, "diceProperties": [{"width": "154px", "images": [], "fileIds": [], "diceType": "TEXT", "isInfant": true, "fileNames": [], "inputArray": "beautiful, plentiful, pitiful, colourful, careful, wonderful, harmful, cheerful, useful, ruthless, meaningless, breathless, windowless, homeless, lidless, penniless, merciless, pitiless"}], "maxDicePerLine": null, "longTextFontSize": null}, "deletedById": null, "downl