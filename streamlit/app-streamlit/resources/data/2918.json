[{"id": 4114, "text": "<h2>Challenge:</h2>\nTurn your story into a book! Fold your book using the instructions below, then write the story onto the pages inside. You could also think of a title to write on the front of your book! Don't forget to add illustrations (pictures).\n", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2918, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 42042923, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2918, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p>1. Opening: This starts the story off and is a good time to introduce the main character.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p>2. Beginning: This is a good time to show the main character doing something.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p>3. Problem: This is something which stops the main character. It is also what makes the story exciting!</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p>4. Resolution: This is how the problem is solved.</p>", "labelEditorState": null}, {"alt": null, "type": "TEXT", "fileName": null, "imageUrl": null, "fileIdentifier": null, "textEditorState": "<p>5. Ending: This brings the story together and finishes it off.</p>", "labelEditorState": null}], "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{\"text\":[\"1. Opening: This starts the story off and is a good time to introduce the main character.\",\"2. Beginning: This is a good time to show the main character doing something.\",\"3. Problem: This is something which stops the main character. It is also what makes the story exciting!\",\"4. Resolution: This is how the problem is solved.\",\"5. Ending: This brings the story together and finishes it off.\"]}", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 42042957, "text": "<h2>The activity:</h2>\nHave a go at telling your own five sentence story. Remember, five sentences don't need to be short and boring - you can add in lots of details to make it interesting to listen to!\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, 