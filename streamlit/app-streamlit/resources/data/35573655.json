[{"id": 40833373, "text": "Why are we doing this?", "modal": {"steps": [{"id": 40833309, "text": "This method of checking spellings is really useful if you don't have a dictionary to hand - writing three different spellings in the margin or on a scrap of paper can help you spot the right one because we are better at remembering what looks right than actually how to spell things. You might see adults doing this without thinking, quickly scribbling down a word to check how it's spelled. \n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 40, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 40, "name": "Why are we doing this?", "logCreatedAt": "2021-11-09T10:02:42.974745", "logUpdatedAt": "2021-11-09T10:02:42.974745", "logCreatedById": null, "logUpdatedById": null, "nameForContentDev": null}}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 35573655, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 40, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35574012, "text": "<h2>Warmup: Find a Word </h2>\n<ol>\n<li>Player 1 chooses a word from the dictionary/index.</li>\n<li>Player 2 must find the word.</li>\n<li>Swap over so Player 2 chooses a new word and Player 1 tries to find it.</li>\n<li>Repeat three or four times each. Which words were hardest to find?</li>\n</ol>\n<br></br>\n<h2>Activity: Spell a Word</h2> \n<ol>\n<li>Player 1 finds a word in the dictionary/index and writes it down without showing the other person.</li>\n<li>Player 1 tells Player 2 the word but not the spelling. </li>\n<li>Player 2 writes down how they think it is spelled. </li>\n<li>Player 2 writes down two other possible alternatives, thinking carefully about which phonemes might have alternative spellings.</li>\n<li>Player 2 looks at their spellings, chooses the most likely, and looks it up in the dictionary/index.</li>\n<li>If it's not there and not easy to spot, can one of the alternative ideas help?</li>\n<li>Swap over a few times so you both get several turns.</li>\n</ol>\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35573655, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35573821, "text": "<h2>You Will Need:</h2>\n<ul>\n<li>A dictionary or a book with an index, e.g. a recipe book.</li>\n<li>A pencil and paper.</li>\n</ul>\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633525152501_1image1-01FHATXFTVBEF3YCZ38VCKK5N0.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35573655, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]