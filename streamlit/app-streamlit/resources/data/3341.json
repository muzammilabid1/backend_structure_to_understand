[{"id": 4517, "text": "<br></br>Place the dominoes face up on the table and ask your child to pick out one with the same number of dots on each side. <br> </br>\n\nAsk your child to count how many dots there are on each side. Then, ask them how many dots there are altogether. <br> </br>\n\nExplain to your child that if there are three dots on each side, and six dots overall, then that means six is double three. <br> </br>\n\nRepeat the activity to practise doubles.", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "Dominoes, double and half-KfZVC15HzUPxWTPO0O65o.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 3341, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4580, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 3341, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": "pdf_step_left_04580.pdf", "editorState": null, "carouselData": null, "downloadName": "Download PDF", "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4516, "