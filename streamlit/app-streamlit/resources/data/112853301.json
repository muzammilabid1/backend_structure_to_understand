[{"id": 112856906, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Counter counting, division by sharing", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "bath-time-capacity-and-volume-NqbgIHRDzx2J17Et32P92.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 112853301, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 112855222, "text": null, "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 112853301, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2><strong>What to do</strong></h2>\n<p>Choose an object and ask your child how they could find half.&nbsp;</p>\n<p>Have a go at splitting it in half together.</p>\n<p></p>\n<h2><strong>Ideas for objects</strong></h2>\n<p>A piece of paper, a leaf, a banana, some wool, a handful of pasta, a ball of playdoh, a slice of bread, a cup of water.&nbsp;</p>\n<p></p>\n<h2><strong>Questions to ask</strong></h2>\n<ul>\n<li>Is this exactly half or roughly half?&nbsp;&nbsp;</li>\n<li>How can we check we have half?</li>\n<li>Which things are easier or harder to find half of?</li>\n</ul>\n<p></p>\n<p></p>\n<h2><strong>Extra Challenge</strong></h2>\n<p>A quarter is half of a half.&nbsp;</p>\n<p>Can you find quarters?</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]