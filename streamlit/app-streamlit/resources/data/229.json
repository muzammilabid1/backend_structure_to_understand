[{"id": 288, "text": "This is a two player game. <br /><br />Person A starts by filling in a number line which has a jump for the hundreds, a jump for the tens and a jump for the ones. (see the picture below for an example)<br /><br />Person B writes down the sum that this number line represents, and then works out what the answer is.<br /><br />If person B becomes more confident, Person A could then try it the other way around! This time, Player B will write down a number sentence. Person A must then create their own number line to solve them.<br />", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 229, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 52259562, "text": "The sum 312 + 245 = 557 broken down into steps of hundreds, tens and ones.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "trimple_jump_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "trimple_jump_image-01FTE80FKH5D74D40YEV0QMMV1.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 229, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "do