[{"id": 120883217, "text": "761893538", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2877, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 3984, "text": "Work together to use mini figures and objects you have found around the house to retell a story. \n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2877, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 40918967, "text": "<h2>What to do:</h2>\n<ol>\n<b><li>Decide what story you want to retell.</b> <dd>Choose one you both know! </dd></li> \n<b><li>Collect mini figures and objects from around the house.</b><dd>These will be your characters and scenery.</dd></li> \n<b><li>Set up the scene together.</b><dd>This is really useful if it is a longer story because it helps you tell the story in order without missing anything out.</dd></li> \n<b><li>Tell the story together.</b><dd>Let your child take the lead. Encourage them to use as many words and phrases from the original story as they can!</dd></li>\n<p></p>\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{\"headers\":[\"Col1\"],\"rows\":[{\"col1\":\"row1\"},{\"col1\":\"row2\"}, {\"col1\":\"row3\"}]}", "timerData": null, "activityId": 2877, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]