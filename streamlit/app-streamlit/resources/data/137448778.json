[{"id": 143384967, "text": "Pieces of paper on a carpet with the a different multiple of 25 written on each.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Counting in 25s cards", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Counting in 25s cards-RgYYoH_Gq9w0zSIyz58A_.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 137448778, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 137449124, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 137448778, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You'll need:</h2>\n<p>Scrap paper and pens.</p>\n<p></p>\n<h2>Getting ready:</h2>\n<p>Together, write the numbers for counting in 25s on pieces of paper.</p>\n<p></p>\n<p style=\"text-align:center;\"><strong>0, 25, 50, 75, 100, 125, 150, 175, 200</strong></p>\n<p></p>\n<p>You could make them small and play on a table.</p>\n<p>You could make them big and play outside.</p>\n<p>Keep going to higher numbers if you'd like the challenge.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 137449137, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 137448778, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<h2>Game 1 - Against the clock</h2>\n<ul>\n<li>Take it in turns to put the numbers in order as quickly as you can.</li>\n</ul>\n<p></p>\n<h2>Game 2 - What's missing</h2>\n<p>Put the numbers in order:</p>\n<ul>\n<li>Player 1 closes their eyes.&nbsp;</li>\n<li>Player 2 removes one or more numbers.&nbsp;</li>\n<li>Player 1 has to work out what's missing.</li>\n</ul>\n<p></p>\n<h2></h2>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]