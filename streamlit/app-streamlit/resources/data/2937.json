[{"id": 4083, "text": "For this activity, you could use some dressing up clothes. You might have a favourite costume, but often the best dressing up can be scarves and old clothes from your wardrobe! Be as creative as you like!\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2937, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 120895711, "text": "762311805", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "VIDEO", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2937, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 4084, "text": "<h2>How to play:</h2>\n<ol>\n<li>Invent your hero and dress up as them.</li>\n<li>Think of words that explain what she/he is like, e.g. kind, helpful, funny, fit. You could use the list of suggestions below to help you.</li>\n<li>Your hero has an evil nemesis who is the total opposite! Change the words to find out what the villain is like. How many of the words can you change just by adding 'un' at the beginning?</li>\n<li>Dress your adult up as the villain!</li>\n</ol>\n\n", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2937, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 41954921, "text": "Hero words", "modal": {"steps": [{"id": 41954802, "text": "Here are some suggestions of words for your hero:\n<ul>\n<li>kind</li>\n<li>lucky</li>\n<li>friendly</li>\n<li>adventurous</li>\n<li>inspiring</li>\n<li>loved</li>\n<li>certain</li>\n<li>fair</li>\n<li>approachable</li>\n<li>cooperative</li>\n<li>exciting</li>\n<li>truthful</li>\n</ul>", "order": 1, "btnType": null, "linkUrl": null, "modalId": 67, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null,