[{"id": 35382429, "text": "<h2>How to Play:</h2>\n<ol>\n<li>Choose an object in your house, e.g. a bowl.</li>\n<li>Take it in turns to say a word that describes the object. These words are adjectives.</li>\n<li>Count how many adjectives you thought of altogether.</li>\n<li>Repeat with another object. Did you think of more or fewer adjectives?</li>\n</ol>\n\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633361315031_1image1-01FH5YQ8VVNBVWRCF911S36PH2.jpeg", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35382180, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35382480, "text": "<h2>Example game:</h2>\nStripy, small, hard, shiny, round, cold, solid, new, fragile, useful, smooth, breakable, clean, curved… ", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35382180, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlp