[{"id": 50612382, "text": "Example Game", "modal": {"steps": [{"id": 43290822, "text": "Three cups containing white beans with three letter beans on the floor in front, spelling 'sum'.", "order": 2, "btnType": null, "linkUrl": null, "modalId": 92, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1637751935780_1image1-01FN8SYBSFREGT512QXKQG0F4E.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 43290785, "text": "Pull a bean from pot 1 – s.\n<br>Say “s”.\n<br></br>\nPull a bean from pot 2 – u.\n<br>Say “s, u”.\n<br>Blend the two sounds “s-u, su”.\n<br></br>\nPull a bean from pot 3 – m.\n<br>Say “su, m”.\n<br>Blend the sounds “su-m, sum”.\n", "order": 1, "btnType": null, "linkUrl": null, "modalId": 92, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "inclu