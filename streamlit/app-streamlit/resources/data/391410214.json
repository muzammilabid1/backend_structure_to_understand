fileName": "Sunset", "imageUrl": "1726478331235_Sunset-7e1qe9M44JryAND9_ae7k.png", "fileIdentifier": "7e1qe9M44JryAND9_ae7k", "textEditorState": null, "labelEditorState": "<p>Sunrise and sunset (make sure you don't look directly at the sun).</p>\n"}, {"alt": "The moon, peeping out from behind some clouds.", "type": "IMAGE", "fileName": "Moon", "imageUrl": "1726478461197_Moon-cHzsaBN3PeRt3l85dkz0Z.png", "fileIdentifier": "cHzsaBN3PeRt3l85dkz0Z", "textEditorState": null, "labelEditorState": "<p>When it’s dark and not too cloudy, the moon or the twinkling of stars.</p>\n"}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "eozsrRIeWAa2aPqMzO73D", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]