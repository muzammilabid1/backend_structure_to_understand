[{"id": 60706491, "text": "<h2>You Will Need:</h2>\n<ul>\n<li>A bowl</li>\n<li>Six grapes (or other small objects) that will fit under the bowl</li>\n</ul>\nRemember to be careful with small objects - never put them in your mouth!", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 52793591, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 52793719, "text": "<ol>\n<li>Put the six grapes on the table and count them together.</li>\n<li>Cover the grapes with the bowl.</li>\n<li>Player 1 shuts their eyes while Player 2 takes some of the grapes from under the bowl and hides them in their hand.</li>\n<li>Player 1 looks under the bowl and says how many grapes are there and how many have gone. </li>\n<li>Player 2 shows their hand for Player 1 to check how many were gone.</li>\n<li>Put the grapes back and swap over to have another turn.</li> \n<li>Repeat until you get really good at spotting how many are gone!</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deleted