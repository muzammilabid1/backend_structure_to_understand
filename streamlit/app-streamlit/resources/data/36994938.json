[{"id": 36995245, "text": "<h2>Here are some ideas:</h2>\n<ul>\n<li>Pretend to be pirates, draw a treasure map, and then go hunting for treasure in your local park.</li>\n<li>Pretend to be detectives, make a poster about a lost unicorn, and then go searching for clues in the streets around where you live.</li>\n<li>Pretend to be explorers, draw a picture of some amazing creatures you have seen on your journey, and make a den under a table in your house.</li>\n<li>Pretend to be two characters from your favourite story or TV series and think of an adventure they might go on!</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36994938, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36994953, "text": "Pretend to be characters from a story and go on an adventure together!", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1634204882895_1image1-01FHZ35351S8P7Z7915ES408FV.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36994938, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null