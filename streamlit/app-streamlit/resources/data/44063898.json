[{"id": 44064069, "text": "A horse pulling a silly face.", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1638197910584_1image1-01FNP3872WYJ577JAK87CJN2VM.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 44063898, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 44215014, "text": "Spotted something strange?", "modal": {"steps": [{"id": 44063169, "text": "Well done! Some words change more of their ending when you add a particular suffix. This happens because different words were introduced into the English language at different times and from different places.\n<br></br>\nHere is an example:\n<br></br>\n<b>Popular: Populate and popularise</b>\n<ul>\n<li>The word 'populate' came to English directly from the Latin word 'populatus', which meant 'fill with people'.</li>\n<li>The word 'popularise' is a newer word in English, so the root word 'popular' was already commonly used before the suffix 'ise' was added.</li>\n</ul>\n<br></br>\nOther examples you might have spotted during this activity:\n<ul>\n<li>equal + ate = equate</li>\n<li>liquid + ify = liquify</li>\n<li>terror + ify = terrify</li>\n<li>horror + ify = horrify</li>\n</ul>", "order": 1, "btnType": null, "linkUrl": null, "modalId": 110, "audioUrl": null, "fileName": null, "fontSize": null, "fon