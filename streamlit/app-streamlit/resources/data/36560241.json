[{"id": 36560357, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36560241, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": "1634552958079_1download1-01FJ9F50G1VMWZBHETGNH1K12M.pdf", "editorState": null, "carouselData": null, "downloadName": "Handwriting sheet", "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36560907, "text": "<h2>Raised lines</h2>\nTrace the line with glue (let it dry before you start writing). \n", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1634033780904_1image1-01FHSZYC44W8ND2TM7GZRBMWQ3.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36560241, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36560763, "text": "<h2>Indented lines</h2>\nMaking a dip along the line can help to feel where it is. You could do this by:\n<ul>\n<li>Putting another piece of paper and drawing over the line, pressing down really hard with a biro. This will leave a dent on the lined paper underneath.</li>\n<li>Making little holes along the line from the back of the paper by poking a pin through (it could be quicker to use a sewing machine with no thread in).</li>\n</ul>", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1634033651249_1image1-01FHSZR9ZWDM4BPT6C2K8TE0ZN.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36560241, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36560560, "text": "<h2>Coloured lines</h2>\nThis is the easiest – trace over the line using a yellow pen or highlighter!", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1634033457124_1image1-01FHSZK7XB7811RZ45XRFQ7ZQJ.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36560241, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36560258, "text": "The letters e f s and j are some of the hardest to place on the line when writing because they all start in slightly funny places. Changing the line in different ways can help with getting the letters in the correct place!\n<br><br>\nHere are three different kinds of lines to try out. With each one, write a pale version of each letter and a dot to show where to start (as in the examples). You could try one, two or all three! If you do more than one, ask your child which they preferred and why!\n<br><br>\nYou can make your own sheet or add to the lines on the printable below.", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 36560241, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]