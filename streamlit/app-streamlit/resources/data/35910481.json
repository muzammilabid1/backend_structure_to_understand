": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 36459062, "text": "<h2>First: Cooking</h2>\nFollow your recipe to cook some food. This can be a fun thing to do together!\n<br><br>\n<h2>Then: Reflection</h2>\nWhen you have finished eating (or while it is cooking), have a look at your recipe and think about how it was organised on the page (on paper or online). Here are some questions to talk about together:\n<ol>\n<li>Was the recipe easy to follow? Why (or why not)?</li>\n<li>How did the organisation help you to cook it?</li> \n<li>How could it have been better organised?</li> \n<li>How did the sentence structure help you follow it?</li>\n<li>Could it have been written more clearly?</li>\n<li>Was your recipe only about the cooking, or was it also written to be interesting to read?</li>\n</ol>", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35910481, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35910767, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35910481, "dimensions": null, "editAsHtml": false, "properties": {"i