[{"id": 486083745, "text": null, "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "CAROUSEL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 486083654, "dimensions": "{\"height\":null,\"width\":null}", "editAsHtml": false, "properties": {"scrollingImage": false}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": [{"alt": "A pencil drawing of a rabbit, with the words \"Mr Bunnikins\" written above.", "type": "IMAGE", "fileName": "1731329971771_Mr Bunnikins", "imageUrl": "1731329971485_Mr Bunnikins-X-JdTlNphxaVm1wvBbABg.png", "fileIdentifier": "X-JdTlNphxaVm1wvBbABg", "textEditorState": null, "labelEditorState": "<p>Player 1 has drawn a picture of a rabbit <span style=\"color: rgb(0,0,0);background-color: rgb(255,255,255);font-size: medium;font-family: Verdana;\">and written his name above: </span>\"Mr Bunnikins\".</p>\n"}, {"alt": "Next to Mr Bunnikins is a pencil drawing of a carrot, with number \"1\" written in a circle above it.", "type": "IMAGE", "fileName": "1731329972207_Mr Bunnikins and the carrot", "imageUrl": "1731329971771_Mr Bunnikins and the carrot-tCZAzeayjll5FYtWEXERA.png", "fileIdentifier": "tCZAzeayjll5FYtWEXERA", "textEditorState": null, "labelEditorState": "<p>Player 2 has drawn a picture of a carrot to distract the rabbit.</p>\n"}, {"alt": "Next to the carrot is a pan of soup, heating up on a gas hob. There is a number \"2\" written in a circle above it.", "type": "IMAGE", "fileName": "1731329972586_Mr Bunnikins, carrot and soup", "imageUrl": "1731329972207_Mr Bunnikins, carrot and soup-aBBbvtvwbg4ItMmpXGWpc.png", "fileIdentifier": "aBBbvtvwbg4ItMmpXGWpc", "textEditorState": null, "labelEditorState": "<p>Player 1 has decided to use the carrot to make soup.</p>\n"}, {"alt": "Next to the pan of soup is a rain cloud with number \"3\" written in a circle next to it.", "type": "IMAGE", "fileName": "1731329972935_Soup in the rain", "imageUrl": "1731329972586_Soup in the rain-U1WFgS_ILpUH9OQiX7NJr.png", "fileIdentifier": "U1WFgS_ILpUH9OQiX7NJr", "textEditorState": null, "labelEditorState": "<p>But the soup is being rained on! Player 2 has put out the fire which was heating the soup and made the soup all watery.</p>\n"}, {"alt": "The whole page is now filled with drawings, all the way up to a lake which is labelled with number \"25\".", "type": "IMAGE", "fileName": "1731329973590_Whole page", "imageUrl": "1731329972935_Whole page-MB1Tv-Rn3ZAjwkBATQuDB.png", "fileIdentifier": "MB1Tv-Rn3ZAjwkBATQuDB", "textEditorState": null, "labelEditorState": "<p>The players kept taking it in turns to add drawings until the whole page was filled. But was Mr Bunnikins saved or destroyed?</p>\n"}], "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "zp-h5uUTP7iv_VwHJT96T", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 486083726, "text": null, "modal": {"steps": [null], "details": null}, "order": 5, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 486083654, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>Example game:</h2>\n<p>Click the arrows to see how the whole game went, and whether Mr Bunnikins was saved or destroyed!</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "SAIP4ogt1xLDz2BY3hC6G", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 486083673, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 486083654, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>You will need:</h2>\n<ul>\n<li>A piece of paper</li>\n<li>A pen or pencil to draw with</li>\n</ul>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "0T3t4BW9embWQQ5Uy5xT8", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 486083701, "text": "A piece of paper with drawings all over - a game of \"Saved or Destroyed\".", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "1731329971474_Whole page", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "1731329970603_Whole page-3ZZYn5BzSDUI4PRCDxYeD.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 486083654, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "ThIT4AlukuGGqq-ve7ACd", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 486083686, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 486083654, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<h2>How to play:</h2>\n<ol>\n<li>Player 1 draws the main character at the start of the page.</li>\n<li>Player 2 thinks of a way to stop the character. It could be anything you like, something small like receiving an invitation to a party, a hole to fall down, or a rocket coming to destroy them. It’s up to you!</li>\n<li>Write \"1\" next to it.</li>\n<li>Player 1 thinks of a way to prevent the destruction from happening. Be as creative as you like! Draw it and write \"2\".</li>\n<li>Player 2 thinks of a way of stopping Player 1’s action and draws it.</li>\n<li>Keep going until you fill up the page. When there is no more space, go through all your pictures to find out if your character was saved or destroyed!</li>\n</ol>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": null, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "SDcVubu-94fkN0Fr1bKb3", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]