[{"id": 35237720, "text": "<h2>How to Play:</h2>\n<ol>\n<li>One person is blindfolded (has their eyes covered).</li>\n<li>The other person gives the blindfolded person instructions to help them move around the room. </li>\n<li>Can you give really clear instructions so that they don’t bump into anything? Be careful and keep them safe!</li>\n<li>After about ten instructions, swap over so the other person can have a go.</li>\n</ol>\n<br></br>\n<h2>Extra Challenge:</h2>\nYou could try setting up an obstacle course and playing the game again!\n", "modal": {"steps": [null], "details": null}, "order": 2, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35237457, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 35237526, "text": "<h2>You Will Need:</h2>\nSomething to cover your eyes, e.g. a sleeping mask or scarf tied around your head. You can just keep your eyes tightly shut if you prefer!", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1633359797713_1image1-01FH5X7YP71SPN0HS14EADCN3K.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 35237457, "dimensions": null, "editAsHtml": false, "properties": {"inputArray": [[]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 117136983, "text": "Play Safely", "modal": {"steps": [{"id": 117136867, "text": null, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "modalId": 215, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "EDITOR", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": null, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": "<p>Always check the space around you before you start playing a game where someone is blindfolded.  Make sure there is nothing on the floor to trip over, no stairs to fall down and nothing sharp, like a table corner, to bump into. Always watch the blindfolded person carefully.</p>\n", "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}], "details": {"id": 215, "name": "Play Safely", "logCreatedAt": "2023-06-20T13:00:11.376256", "logUpdatedAt": "2023-06-20T13:00:11.376256", "logCreatedById": 108180408, "logUpdatedById": 108180408, "nameForContentDev": null}}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "MODAL", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'