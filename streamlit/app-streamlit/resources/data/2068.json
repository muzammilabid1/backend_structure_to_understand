[{"id": 2628, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2068, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": "pdf_step_left_02628.pdf", "editorState": null, "carouselData": null, "downloadName": "Game Board PDF", "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 41756395, "text": "Hint: They will need a 20p coin!\n<br></br>\n<h2>Challenge:</h2>\nTalk about these questions together:\n<ul>\n<li>Do you think it is better to go first or second? </li>\n<li>Can you find some good ways to try to win the game?</li>\n</ul>\n<br ><br />\n<i>This game was adapted from the Nrich website. You can visit the original by clicking the link below:</i>", "modal": {"steps": [null], "details": null}, "order": 5, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2068, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 2633, "text": null, "modal": {"steps": [null], "details": null}, "order": 7, "btnType": "SECONDARY", "linkUrl": "https://nrich.maths.org/10465", "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": "Money Line-up on nrich", "stepType": "LINK", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2068, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 279111690, "text": "Home made game board with coins cut from paper", "modal": {"steps": [null], "details": null}, "order": 6, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "Calculating change Y2", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "Calculating change Y2-jQ3FU-NiXO1HZPT7WLc64.png", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 2068, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": false, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": {"heading": "", "checkList": [{"key": "k4wrxJHAGL6aWaJikXz__", "checked": false, "listItem": ""}], "description": ""}, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 2631, "text": "<h2>How to Play:</h2>\n<ol> \n<li>Decide who will go first.</li>\n<li>Players take turns to put one coin on one of the squares.</li>\n<li>The winner is the first to make a row (horizontally, vertically or diagonally) of four coins which add to one pound.</li>\n</ol>\n<br></br>\n<h2>Example Game:</h2>\nIn the example below, the next player can win the game. Can you see where they should put their coin?", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1636971707683_1image1-01FMHHSN2TDEKEB445ZXQ7YP7W.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2068, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 2630, "text": null, "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2068, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": "1636971390501_1download1-01FMHHCNHBCERKHS7EYK6MPVW0.pdf", "editorState": null, "carouselData": null, "downloadName": "Coins PDF", "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 2627, "text": "<h2>You will Need:</h3>\n<ul>\n<li>A game board - copy out or print the one below.</li>\n<li>A set of coins for each player (if you don't have these coins, you can print some pictures below or make your own on small pieces of paper):\n<ul>\n<li>One 50p coin</li>\n<li>Four 20p coins</li>\n<li>Four 5p coins</li>\n<li>Seven 10p coins </li>\n</ul></ul>\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": null, "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": null, "imageUrl": "1636970934061_1image1-01FMHH463V6WY8XS5VS08NGZX6.png", "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": null, "timerData": null, "activityId": 2068, "dimensions": null, "editAsHtml": false, "properties": null, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": null, "textCarouselData": null, "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]