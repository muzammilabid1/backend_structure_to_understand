[{"id": 56977268, "text": "<h2>You Will Need:</h2>\nA set of <abbr title=\"These are also known as 'little letters', e.g. 'i' or 'b'.\">lower-case letters</abbr> and  <abbr title=\"These are also known as 'capital letters' or 'big letters', e.g. 'I' or 'B'.\">upper-case letters</abbr>. You can use our alphabet cards.\n", "modal": {"steps": [null], "details": null}, "order": 1, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 56977225, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 56977341, "text": null, "modal": {"steps": [null], "details": null}, "order": 2, "btnType": "SECONDARY", "linkUrl": null, "audioUrl": null, "fileName": "lower_and_upper_case_letter_cards", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "DOWNLOAD", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 56977225, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": "lower_and_upper_case_letter_cards-01FX025BTFHADWV8SQF06M3H8C.pdf", "editorState": null, "carouselData": null, "downloadName": "Download Alphabet Cards", "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 56977420, "text": "Magnetic letters, including a capital 'A' and lower-case 'a' next to each other.", "modal": {"steps": [null], "details": null}, "order": 3, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": "alphabet_letters_image", "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": "alphabet_letters_image-01FX027A7M5ZSRKDGSCXQP8TRC.jpeg", "linkName": null, "stepType": "IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 56977225, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}, {"id": 56977445, "text": "<h2>Warmup:</h2>\nMatch up all the capital and lower case letters. \n<br></br>\nTalk about which ones are easier to match up and which are harder to match up, e.g. 'u' and 'U' are easier because they look similar but 'g' and 'G' look really different so they are harder.\n<br></br>\n<h2>Play the Game:</h2>\n<ol>\n<li>Spread out the cards face down. </li>\n<li>Take it in turns to turn over two cards. \n<ul>\n<li>If the letters match, keep the cards and have another go.</li>\n<li>If the letters do not match, turn the cards back over and it's the other player's turn.</li>\n</ul>\n<li>Keep playing until you have collected all the cards. The winner is the player with the most cards!</li>\n</ol>\n<br></br>\n<i>If you are using magnetic letters instead of cards, you can still play. Just put the letters inside a bag and pick out two at a time instead of turning over cards. You might be able to use touch to help you find the two matching ones!</i>", "modal": {"steps": [null], "details": null}, "order": 4, "btnType": "PRIMARY", "linkUrl": null, "audioUrl": null, "fileName": null, "fontSize": null, "fontType": "SassoonInfantRg-Regular", "imageUrl": null, "linkName": null, "stepType": "TEXT_AND_IMAGE", "tabsData": null, "deletedAt": null, "tableData": "{'headers':['Col1'],'rows':[{'col1':'row1'},{'col1':'row2'}, {'col1':'row3'}]}", "timerData": null, "activityId": 56977225, "dimensions": null, "editAsHtml": false, "properties": {"height": "", "fontArray": [[]], "inputArray": [[]], "widthArray": [[""]]}, "deletedById": null, "downloadUrl": null, "editorState": null, "carouselData": null, "downloadName": null, "accordionData": null, "includeSeconds": null, "selectedModalId": 0, "textCarouselData": "{ \"text\": [] }", "checkListTextData": null, "imageCarouselData": null, "checklistImageData": null, "clickableAlphabetData": null}]