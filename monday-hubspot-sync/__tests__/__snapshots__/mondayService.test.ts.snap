exports[`GraphQL Mutation Snapshots should maintain consistent create mutation format 1`] = `
"
    mutation {
      create_item (
        board_id: 123456,
        item_name: "Snapshot Test School",
        column_values: "{\\"col1\\":\\"value1\\",\\"col2\\":\\"value2\\"}"
      ) {
        id
        name
      }
    }
  "
`;

exports[`GraphQL Mutation Snapshots should maintain consistent fetch board query format 1`] = `
"
    query {
      boards (ids: 123456) {
        id
        name
        description
        columns {
          id
          title
          type
        }
        items_page (limit: 500) {
          cursor
          items {
            id
            name
            created_at
            updated_at
            column_values {
              id
              text
              value
              ... on BoardRelationValue {
                linked_items {
                  id
                  name
                  column_values {
                    id
                    text
                    value
                  }
                }
              }
            }
          }
        }
      }
    }
  "
`;

