# ==========================================
# HubSpot Configuration
# ==========================================
# HubSpot Private App Access Token
# Generate at: Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here

# HubSpot Base URL for your account
# Format: https://app.hubspot.com/contacts/{your_account_id}
HUBSPOT_BASE_URL=https://app.hubspot.com/contacts/12345678

# HubSpot Account ID (found in your HubSpot URL)
HUBSPOT_ACCOUNT_ID=12345678

# ==========================================
# Monday.com Configuration
# ==========================================
# Monday.com API Key
# Generate at: Profile > Admin > API
MONDAY_API_KEY=your_monday_api_key_here

# Monday.com API URL (usually this default value)
MONDAY_API_URL=https://api.monday.com/v2

# Your Monday.com workspace URL base
# Format: https://{your_domain}.monday.com
MONDAY_BOARD_BASE_URL=https://yourdomain.monday.com

# ==========================================
# Monday.com Board IDs
# ==========================================
# Schools Board ID
# Find by opening the board and checking the URL: /boards/{board_id}
MONDAY_SCHOOLS_BOARD_ID=1234567890

# Contacts Board ID
# Separate board for storing contact information
MONDAY_SCHOOLS_CONTACT_BOARD_ID=9876543210

# ==========================================
# Monday.com Schools Board Column IDs
# ==========================================
# To find column IDs:
# 1. Open Monday.com board
# 2. Click on a column header > "Column Settings"
# 3. The column ID is shown at the bottom

# Owner column (Person type) - Who manages this school
MONDAY_SCHOOLS_BOARD_COLUMN_ID_OWNER=person

# Main Contact column (Board Relation type) - Links to Contacts board
# This should be a board relation column linking to the Contacts board
MONDAY_SCHOOLS_BOARD_COLUMN_ID_MAIN_CONTACT=board_relation

# Email column (Email type) - Main contact email (legacy/optional)
MONDAY_SCHOOLS_BOARD_COLUMN_ID_EMAIL_ADDRESS=email

# HubSpot Record ID column (Text type) - Stores HubSpot company ID for sync tracking
MONDAY_SCHOOLS_BOARD_COLUMN_ID_HUBSPOT_RECORD_ID=text

# ==========================================
# Monday.com Contacts Board Column IDs
# ==========================================
# Name column (Name type) - Contact's full name
MONDAY_SCHOOLS_CONTACT_BOARD_COLUMN_ID_NAME=name

# Email column (Email type) - Contact's email address
MONDAY_SCHOOLS_CONTACT_BOARD_COLUMN_ID_EMAIL=email

# Contact School column (Board Relation type) - Links back to Schools board
# This creates a bidirectional relationship between contacts and schools
MONDAY_SCHOOLS_CONTACT_BOARD_COLUMN_ID_CONTACT_SCHOOL=board_relation

# ==========================================
# Application Settings
# ==========================================
# Read-Only Mode (true/false)
# When true, the sync will not make any changes to Monday.com or HubSpot
# Defaults to true for safety - set to false to enable write operations
READ_ONLY_MODE=true

# ==========================================
# Optional: Cloudflare Workers (if deploying as worker)
# ==========================================
# Webhook secret for authenticating incoming sync requests
# WEBHOOK_SECRET=your_webhook_secret_here
